<div class="essence roll-card">
  <h3>{{label}}</h3>
  <div class="dice-faces">
    {{#each faces as |face i|}}
      {{!-- Surges are counted AFTER the Defense check: the Success Die never gets the surge-die
           class even at 6+, since it was already spent meeting Defense (see essence-roll.mjs's
           resolveCombatRoll, 2026-09-09 rule clarification). --}}
      <span class="die {{#if (eq i ../successDieIndex)}}success-die{{/if}} {{#if (and (gte face 6) (ne i ../successDieIndex))}}surge-die{{/if}}">{{face}}</span>
    {{/each}}
  </div>
  <div class="roll-summary">
    <p><strong>{{localize "ESSENCE.Chat.Pool"}}:</strong> {{pool}}d10{{#if defense}} {{localize "ESSENCE.Chat.VsDefense" defense=defense}}{{/if}}{{#if difficulty}} {{localize "ESSENCE.Chat.VsDifficulty" difficulty=difficulty}}{{/if}}</p>
    {{#if nonCombat}}
      {{!-- Non-Combat task (Doc L1238): read the highest die; it meets or beats the Difficulty or
           it doesn't. No Surges, no Success Die reservation, no per-target table. --}}
      <p><strong>{{localize "ESSENCE.Chat.HighestDie"}}:</strong> {{successDie}} —
        {{#if difficulty}}
          {{#if taskSucceeded}}<span class="pass">{{localize "ESSENCE.Chat.Success"}}</span>{{else}}<span class="fail">{{localize "ESSENCE.Chat.Failure"}}</span>{{/if}}
        {{else}}
          <span class="muted">{{localize "ESSENCE.Chat.GmSetsDifficulty"}}</span>
        {{/if}}
      </p>
      <p class="muted non-combat-note">{{localize "ESSENCE.Chat.NoSurgesNonCombat"}}</p>
    {{else}}
    {{#if targets.length}}
      <table class="target-results">
        <thead><tr><th>{{localize "ESSENCE.Chat.Target"}}</th><th>{{localize "ESSENCE.Chat.Defense"}}</th><th>{{localize "ESSENCE.Chat.Result"}}</th></tr></thead>
        <tbody>
          {{#each targets as |t|}}
            <tr>
              <td>{{t.name}}</td>
              <td>{{#if t.defense}}{{t.defense}}{{else}}—{{/if}}</td>
              <td>{{#if t.succeeded}}<span class="pass">{{localize "ESSENCE.Chat.Success"}}</span>{{else}}<span class="fail">{{localize "ESSENCE.Chat.Failure"}}</span>{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#unless unopposed}}<p class="muted">{{localize "ESSENCE.Chat.SuccessDie"}}: {{successDie}}</p>{{/unless}}
    {{else if unopposed}}
      {{!-- V6 §5.2.3: an Unopposed card auto-succeeds; no die is reserved as the Success Die and every 6+ is a Surge. --}}
      <p><strong>{{localize "ESSENCE.Chat.Unopposed"}}</strong> — <span class="pass">{{localize "ESSENCE.Chat.UnopposedNote"}}</span></p>
    {{else}}
      <p><strong>{{localize "ESSENCE.Chat.SuccessDie"}}:</strong> {{successDie}} —
        {{#if succeeded}}<span class="pass">{{localize "ESSENCE.Chat.Success"}}</span>{{else}}<span class="fail">{{localize "ESSENCE.Chat.Failure"}}</span>{{/if}}
      </p>
    {{/if}}
    {{#if bonusSurges}}
      <p class="muted mastery-note"><strong>{{localize "ESSENCE.Chat.Mastery"}}:</strong> {{localize "ESSENCE.Chat.FreeSurge" n=bonusSurges}}</p>
    {{/if}}
    {{#if noSurges}}
      <p class="muted no-surges-note"><strong>{{localize "ESSENCE.Chat.Surges"}}:</strong> {{localize "ESSENCE.Chat.NoSurgesMook"}}</p>
    {{else if openRoll}}
      <p class="muted open-roll-note">
        <strong>{{localize "ESSENCE.Chat.Surges"}}:</strong>
        {{#if (eq surges 1)}}{{localize "ESSENCE.Chat.OpenRollNoteSingular" surges=surges}}{{else}}{{localize "ESSENCE.Chat.OpenRollNotePlural" surges=surges}}{{/if}}
      </p>
    {{else if surgeOptions.length}}
      <div class="surge-options">
        <p class="surges-remaining"><strong>{{localize "ESSENCE.Chat.Surges"}}:</strong> <span class="remaining">{{surges}}</span> / {{surges}} {{localize "ESSENCE.Chat.Available"}}</p>
        {{#each surgeOptions as |opt|}}
          <button type="button" class="surge-option" data-index="{{opt.i}}" data-cost="{{opt.n}}">
            <span class="cost">{{opt.n}}</span> <span class="surge-text">{{{opt.html}}}</span>
          </button>
        {{/each}}
      </div>
    {{else}}
      <p><strong>{{localize "ESSENCE.Chat.Surges"}}:</strong> {{surges}}</p>
    {{/if}}
    {{/if}}
  </div>
</div>
