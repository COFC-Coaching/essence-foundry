{{!-- Chat card for every Essence roll (plan step 6, concept "Chat cards after a play"). The dice sit
     inside Foundry's own .dice-roll / .dice-result markup so the chat log styles them and Dice So
     Nice keeps its hook; the Essence parts (Success Die, Surges, Effect and Rider) layer on top.
     `card` and `play` are set only when a Combat or Equipment Card was played; a plain Attribute,
     Initiative or Task roll has neither and falls back to the label alone. --}}
<div class="essence roll-card{{#if card}} kind-{{card.kind}}{{else}} kind-roll{{/if}}">
  {{#if card}}
    <div class="rc-band">
      <span>{{card.kindLabel}}{{#if card.subtype}} · {{card.subtype}}{{/if}}</span>
      <span>{{#if card.style}}{{card.style}} R{{card.rank}}{{else if card.domainLabel}}{{card.domainLabel}}{{/if}}</span>
    </div>
    <h2 class="rc-title">{{label}}</h2>
    {{#each card.lead as |line|}}
      <div class="rc-sec rc-lead"><b>{{line.label}}</b><span>{{{line.html}}}</span></div>
    {{/each}}
    {{#if play}}
      <p class="rc-meta">
        {{#if play.burnOnly}}{{localize "ESSENCE.Chat.Burned" n=play.committed pool=play.poolLabel}}{{else}}{{localize "ESSENCE.Chat.Committed" n=play.committed max=play.available pool=play.poolLabel}}{{/if}}{{#if play.burned}} · {{localize "ESSENCE.Chat.RolledBurned" rolled=play.rolled burned=play.burned}}{{/if}}{{#if play.cost}} · {{localize "ESSENCE.Chat.Paid" cost=play.cost resource=play.resource}}{{/if}}{{#if play.hasAfter}} · {{localize "ESSENCE.Chat.PoolAfter" pool=play.poolLabel before=play.available after=play.after}}{{/if}}
      </p>
    {{/if}}
  {{else}}
    <h3 class="rc-title">{{label}}</h3>
  {{/if}}

  {{!-- Each die is drawn as a d10: a kite-shaped top face inside the ten-sided silhouette, the
        number on the face. Gold is the Success Die, green made a Surge, dashed was burned. --}}
  <div class="dice-roll">
    <div class="dice-result">
      {{#unless card}}<div class="dice-formula">{{pool}}d10{{#if defense}} {{localize "ESSENCE.Chat.VsDefense" defense=defense}}{{/if}}{{#if difficulty}} {{localize "ESSENCE.Chat.VsDifficulty" difficulty=difficulty}}{{/if}}</div>{{/unless}}
      <div class="dice-faces">
        {{#each faces as |face i|}}
          {{!-- The Success Die never carries surge-die: Surges are counted after the Defense check
               and the Success Die is excluded from that count (resolveCombatRoll). --}}
          <span class="die {{#if (eq i ../successDieIndex)}}success-die{{/if}} {{#if (and (gte face 6) (ne i ../successDieIndex))}}surge-die{{/if}}" role="img" aria-label="{{#if (eq i ../successDieIndex)}}{{localize 'ESSENCE.Chat.SuccessDieAria' n=face}}{{else if (gte face 6)}}{{localize 'ESSENCE.Chat.SurgeDieAria' n=face}}{{else}}{{localize 'ESSENCE.Chat.RolledDieAria' n=face}}{{/if}}">{{> "systems/essence-system/templates/chat/d10-shape.hbs"}}<span class="die-num">{{face}}</span></span>
        {{/each}}
        {{#if play.burned}}{{#each play.burnedList}}<span class="die burned-die" role="img" aria-label="{{localize 'ESSENCE.Chat.BurnedDie'}}">{{> "systems/essence-system/templates/chat/d10-shape.hbs"}}<span class="die-num">·</span></span>{{/each}}{{/if}}
        {{#if card.attr}}<span class="rc-dice-note">{{card.attr}}{{#if play.maxRolled}}, {{localize "ESSENCE.Chat.Max" n=play.maxRolled}}{{/if}}</span>{{/if}}
      </div>
    </div>
  </div>

  <div class="roll-summary">
    {{#if nonCombat}}
      <p><strong>{{localize "ESSENCE.Chat.HighestDie"}}:</strong> {{successDie}} —
        {{#if difficulty}}
          {{#if taskSucceeded}}<span class="pass">{{localize "ESSENCE.Chat.Success"}}</span>{{else}}<span class="fail">{{localize "ESSENCE.Chat.Failure"}}</span>{{/if}}
        {{else}}
          <span class="muted">{{localize "ESSENCE.Chat.GmSetsDifficulty"}}</span>
        {{/if}}
      </p>
      <p class="muted non-combat-note">{{localize "ESSENCE.Chat.NoSurgesNonCombat"}}</p>
    {{else}}
    {{#if targets.length}}
      <div class="rc-results">
        <span class="rc-lbl">{{localize "ESSENCE.Chat.Target"}}</span><span class="rc-lbl">{{localize "ESSENCE.Chat.Defense"}}</span><span class="rc-lbl">{{localize "ESSENCE.Chat.Result"}}</span>
        {{#each targets as |t|}}
          <span class="rc-target">{{t.name}}</span>
          <span class="num">{{#if t.defense}}{{t.defense}}{{else}}—{{/if}}</span>
          <span>{{#if t.succeeded}}<span class="pass">{{localize "ESSENCE.Chat.Success"}}</span>{{else}}<span class="fail">{{localize "ESSENCE.Chat.Failure"}}</span>{{/if}}</span>
        {{/each}}
      </div>
      {{#unless unopposed}}<p class="muted">{{localize "ESSENCE.Chat.SuccessDie"}}: {{successDie}}</p>{{/unless}}
    {{else if unopposed}}
      <p><strong>{{localize "ESSENCE.Chat.Unopposed"}}</strong> — <span class="pass">{{localize "ESSENCE.Chat.UnopposedNote"}}</span></p>
    {{else}}
      <p><strong>{{localize "ESSENCE.Chat.SuccessDie"}}:</strong> {{successDie}} —
        {{#if succeeded}}<span class="pass">{{localize "ESSENCE.Chat.Success"}}</span>{{else}}<span class="fail">{{localize "ESSENCE.Chat.Failure"}}</span>{{/if}}
      </p>
    {{/if}}
    {{#if bonusSurges}}
      <p class="muted mastery-note"><strong>{{localize "ESSENCE.Chat.Mastery"}}:</strong> {{localize "ESSENCE.Chat.FreeSurge" n=bonusSurges}}</p>
    {{/if}}
    {{#if noSurges}}
      <p class="muted no-surges-note"><strong>{{localize "ESSENCE.Chat.Surges"}}:</strong> {{localize "ESSENCE.Chat.NoSurgesMook"}}</p>
    {{else if openRoll}}
      <p class="rc-lbl-row"><span class="rc-lbl">{{localize "ESSENCE.Chat.Surges"}}</span></p>
      <p class="muted open-roll-note">
        {{#if (eq surges 1)}}{{localize "ESSENCE.Chat.OpenRollNoteSingular" surges=surges}}{{else}}{{localize "ESSENCE.Chat.OpenRollNotePlural" surges=surges}}{{/if}}
      </p>
    {{else if surgeOptions.length}}
      <div class="surge-options">
        <p class="surges-remaining"><span class="rc-lbl">{{localize "ESSENCE.Chat.Surges"}}</span> <span class="muted"><span class="remaining">{{surges}}</span> / {{surges}} {{localize "ESSENCE.Chat.Available"}}</span></p>
        {{#each surgeOptions as |opt|}}
          <button type="button" class="surge-option" data-index="{{opt.i}}" data-cost="{{opt.n}}">
            <span class="cost">{{opt.n}}</span> <span class="surge-text">{{{opt.html}}}</span>
          </button>
        {{/each}}
      </div>
    {{else}}
      <p><strong>{{localize "ESSENCE.Chat.Surges"}}:</strong> {{surges}}</p>
    {{/if}}
    {{/if}}
  </div>

  {{#if (or card.body.length card.rider)}}
    <div class="rc-text">
      {{#each card.body as |line|}}
        <div class="rc-sec{{#unless line.label}} rc-cont{{/unless}}"><b>{{line.label}}</b><span>{{{line.html}}}</span></div>
      {{/each}}
      {{#if card.rider}}
        <div class="rc-sec rc-rider"><b>{{localize "ESSENCE.Item.Card.Rider"}}</b><span>{{#if card.rider.title}}<strong class="rc-accent">{{card.rider.title}}</strong> {{/if}}{{{card.rider.html}}}{{#if card.rider.meta}} <span class="muted">{{card.rider.meta}}</span>{{/if}}</span></div>
      {{/if}}
    </div>
  {{/if}}
  {{#if card}}
    <div class="rc-actions">
      {{#each applyTargets as |t|}}<button type="button" class="rc-apply" data-action="applyDamage" data-uuid="{{t.uuid}}">{{localize "ESSENCE.Chat.ApplyDamageTo" name=t.name}}</button>{{/each}}
      {{#if cardUuid}}<button type="button" class="rc-card" data-action="openCard" data-uuid="{{cardUuid}}">{{localize "ESSENCE.Chat.OpenCard"}}</button>{{/if}}
    </div>
  {{/if}}
</div>
