<div class="essence roll-card">
  <h3>{{label}}</h3>
  <div class="dice-faces">
    {{#each faces as |face i|}}
      {{!-- Surges are counted AFTER the Defense check: the Success Die never gets the surge-die
           class even at 6+, since it was already spent meeting Defense (see essence-roll.mjs's
           resolveCombatRoll, 2026-09-09 rule clarification). --}}
      <span class="die {{#if (eq i ../successDieIndex)}}success-die{{/if}} {{#if (and (gte face 6) (ne i ../successDieIndex))}}surge-die{{/if}}">{{face}}</span>
    {{/each}}
  </div>
  <div class="roll-summary">
    <p><strong>Pool:</strong> {{pool}}d10{{#if defense}} vs Defense {{defense}}{{/if}}</p>
    {{#if targets.length}}
      <table class="target-results">
        <thead><tr><th>Target</th><th>Defense</th><th>Result</th></tr></thead>
        <tbody>
          {{#each targets as |t|}}
            <tr>
              <td>{{t.name}}</td>
              <td>{{#if t.defense}}{{t.defense}}{{else}}—{{/if}}</td>
              <td>{{#if t.succeeded}}<span class="pass">Success</span>{{else}}<span class="fail">Failure</span>{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <p class="muted">Success Die: {{successDie}}</p>
    {{else}}
      <p><strong>Success Die:</strong> {{successDie}} —
        {{#if succeeded}}<span class="pass">Success</span>{{else}}<span class="fail">Failure</span>{{/if}}
      </p>
    {{/if}}
    {{#if bonusSurges}}
      <p class="muted mastery-note"><strong>Mastery:</strong> +{{bonusSurges}} free Surge</p>
    {{/if}}
    {{#if openRoll}}
      <p class="muted open-roll-note">
        <strong>Surges:</strong> {{surges}} candidate die{{#unless (eq surges 1)}}ce{{/unless}} at 6+
        (excluding the Success Die) — Defense wasn't declared, so the GM decides how many actually
        count.
      </p>
    {{else if surgeOptions.length}}
      <div class="surge-options">
        <p class="surges-remaining"><strong>Surges:</strong> <span class="remaining">{{surges}}</span> / {{surges}} available</p>
        {{#each surgeOptions as |opt|}}
          <button type="button" class="surge-option" data-index="{{opt.i}}" data-cost="{{opt.n}}">
            <span class="cost">{{opt.n}}</span> <span class="surge-text">{{{opt.html}}}</span>
          </button>
        {{/each}}
      </div>
    {{else}}
      <p><strong>Surges:</strong> {{surges}}</p>
    {{/if}}
    <p class="muted"><strong>Open-difficulty successes (6+):</strong> {{poolSuccesses}}</p>
  </div>
</div>
