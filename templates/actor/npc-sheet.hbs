<div class="essence-sheet-root">
<header class="sheet-header">
  <div class="portrait-wrap">
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" title="Sheet Portrait — click to change">
    <button type="button" class="token-image-btn" data-action="editTokenImage" title="Token Image — the art shown on the canvas. Separate from the Portrait above; see the Game Master's Guide for how the two relate."><i class="fa-solid fa-chess-pawn"></i></button>
  </div>
  <div class="header-main">
    <div class="header-actions">
      <button type="button" class="wizard-launch" data-action="openWizard" title="Auto-generate or hand-build a stat block"><i class="fa-solid fa-dragon"></i> Monster Creator</button>
      {{#if isEditable}}
        <button type="button" class="edit-lock-btn" data-action="toggleEditLock" aria-pressed="{{editUnlocked}}" title="{{#if editUnlocked}}Sheet unlocked — click to lock Attributes/Skills/build fields again{{else}}Sheet locked — click to edit Attributes/Skills/build fields{{/if}}">
          <i class="fa-solid {{#if editUnlocked}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{#if editUnlocked}}Unlocked{{else}}Locked{{/if}}
        </button>
      {{/if}}
    </div>
    <h1><input name="name" type="text" value="{{actor.name}}"></h1>
    <div class="header-fields">
      <label>Role
        <select name="system.role">
          <option value="" {{#if (eq system.role "")}}selected{{/if}}></option>
          <option value="Minion" {{#if (eq system.role "Minion")}}selected{{/if}}>Minion</option>
          <option value="Standard" {{#if (eq system.role "Standard")}}selected{{/if}}>Standard</option>
          <option value="Elite" {{#if (eq system.role "Elite")}}selected{{/if}}>Elite</option>
          <option value="Nemesis" {{#if (eq system.role "Nemesis")}}selected{{/if}}>Nemesis</option>
        </select>
      </label>
      <label>Tier <input name="system.tier" type="number" value="{{system.tier}}" style="width:3em"></label>
      <label>Level <input name="system.level" type="number" value="{{system.level}}" style="width:3em"></label>
    </div>
  </div>
</header>

<h3 class="section-head">Origin</h3>
<div class="wizard-pick-list">
  {{#each speciesOptions as |opt|}}
    <button type="button" class="{{#if (eq opt.name ../speciesItem.name)}}chosen{{/if}}" data-action="selectOrigin" data-pack="essence-system.species" data-id="{{opt.id}}">{{opt.name}}</button>
  {{/each}}
  {{#if speciesItem}}<button type="button" class="link-button" data-action="itemEdit" data-item-id="{{speciesItem.id}}">(open Species — e.g. to choose Adaptations)</button> <button type="button" class="link-button" data-action="clearOrigin" data-type="species">(clear Species)</button>{{/if}}
</div>
<div class="wizard-pick-list">
  {{#each distinctionOptions as |opt|}}
    <button type="button" class="{{#if (eq opt.name ../distinctionItem.name)}}chosen{{/if}}" data-action="selectOrigin" data-pack="essence-system.distinctions" data-id="{{opt.id}}">{{opt.name}}</button>
  {{/each}}
  {{#if distinctionItem}}<button type="button" class="link-button" data-action="clearOrigin" data-type="distinction">(clear Distinction)</button>{{/if}}
</div>

<h3 class="section-head">Attributes, Resources &amp; Defenses</h3>
<div class="domains grid-3">
  {{#each domains as |d|}}
    <div class="domain domain-{{d.key}}">
      <h4>{{d.label}}</h4>
      {{#each d.attrs as |a|}}
        <div class="attr-row"><span class="attr-label">{{a.label}}</span><input class="attr-input" type="number" name="system.{{a.key}}" value="{{a.value}}"></div>
      {{/each}}
      <div class="resource-row">
        <span class="attr-label">{{d.resourceLabel}}</span>
        <button type="button" class="resource-step" data-action="adjustResource" data-field="{{d.resourceField}}" data-delta="-1" aria-label="Decrease {{d.resourceLabel}}">−</button>
        <input class="current-input" type="number" name="system.playState.{{d.resourceField}}" value="{{d.resourceCurrent}}">
        <button type="button" class="resource-step" data-action="adjustResource" data-field="{{d.resourceField}}" data-delta="1" aria-label="Increase {{d.resourceLabel}}">+</button>
        / <span class="max-value">{{d.resourceMax}}</span>
      </div>
      <div class="defense-row"><span class="attr-label">{{d.defenseLabel}}</span><span class="max-value">{{d.defenseValue}}</span></div>
    </div>
  {{/each}}
</div>

<h3 class="section-head">Combat Skills</h3>
<div class="domains grid-3">
  {{#each domains as |d|}}
    <div class="domain">
      {{#each d.skills as |s|}}
        <div class="skill-box {{#unless s.gateOpen}}gated{{/unless}}">
          <div class="skill-head">
            <button type="button" class="skill-roll" data-action="rollSkill" data-skill="{{s.key}}">{{s.label}}</button>
            <span class="pip-track">{{#each s.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}</span>
          </div>
          {{#unless s.gateOpen}}<div class="gate-note"><i class="fa-solid fa-lock"></i> Requires {{s.gateDistinction}} Distinction</div>{{/unless}}
        </div>
      {{/each}}
    </div>
  {{/each}}
</div>

<h3 class="section-head">Wounds <span class="muted">— {{system.woundState}}</span></h3>
<div class="wounds-row">
  <div class="wound-block">
    <span class="attr-label">Resilience</span>
    <input class="current-input" type="number" name="system.resilience" value="{{system.resilience}}">
  </div>
  <div class="wound-block">
    <span class="attr-label">Temporary Wounds</span>
    <span class="pip-track">
      {{#each temporaryWoundPips as |filled i|}}<button type="button" class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempWound" data-index="{{i}}" aria-pressed="{{filled}}" aria-label="Temporary Wound {{addOne i}}"></button>{{/each}}
    </span>
  </div>
  <div class="wound-block">
    <span class="attr-label">Core Wounds</span>
    <span class="pip-track">
      {{#each system.coreWounds as |w i|}}<button type="button" class="pip toggle {{#if w.filled}}filled{{/if}}" data-action="toggleCoreWound" data-index="{{i}}" title="{{w.condition}}" aria-pressed="{{w.filled}}" aria-label="Core Wound {{addOne i}}{{#if w.condition}}: {{w.condition}}{{/if}}"></button>{{/each}}
    </span>
  </div>
  <div class="wound-block">
    <button type="button" data-action="applyDamage">Apply Damage</button>
    <button type="button" data-action="recoverWound">Recover Wound</button>
  </div>
</div>
{{#if (eq system.woundState "Critically Wounded")}}
  <div class="wounds-row">
    <div class="wound-block">
      <span class="attr-label">Death Track</span>
      <span class="pip-track">
        {{#each deathTrackPips as |filled i|}}<button type="button" class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleDeathTrack" data-index="{{i}}" aria-pressed="{{filled}}" aria-label="Death Track Step {{addOne i}}"></button>{{/each}}
      </span>
    </div>
    <div class="wound-block">
      <label style="display:flex;align-items:center;gap:4px;">
        <input type="checkbox" data-action="toggleDeathTrackFrozen" {{#if system.playState.deathTrackFrozen}}checked{{/if}}> Frozen
      </label>
    </div>
  </div>
{{/if}}

<h3 class="section-head">Influence <span class="muted">— {{system.standing}}</span></h3>
<div class="influence-row">
  <div class="wound-block">
    <span class="attr-label">Temporary Influence</span>
    <span class="pip-track">
      {{#each temporaryInfluencePips as |filled i|}}<button type="button" class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempInfluence" data-index="{{i}}" aria-pressed="{{filled}}" aria-label="Temporary Influence {{addOne i}}"></button>{{/each}}
    </span>
  </div>
  <div class="wound-block">
    <span class="attr-label">Core Influence</span>
    <span class="pip-track">
      {{#each system.coreInfluence as |c i|}}<button type="button" class="pip toggle labeled {{#if c.filled}}filled{{/if}}" data-action="toggleCoreInfluence" data-index="{{i}}" title="{{c.condition}}" aria-pressed="{{c.filled}}" aria-label="Core Influence {{addOne i}}{{#if c.condition}}: {{c.condition}}{{/if}}">{{lookup ../coreInfluenceLabels i}}</button>{{/each}}
    </span>
  </div>
  <div class="wound-block">
    <button type="button" data-action="applyInfluenceInjury">Apply Influence Injury</button>
    <button type="button" data-action="recoverInfluenceInjury">Recover Influence</button>
    <button type="button" data-action="contributeToGoal">Contribute to Shared Goal</button>
  </div>
</div>
<p class="muted influence-recovery-note">Recovery: Light — 1 day &middot; Serious — 1 week &middot; Critical — 1 month.</p>

<h3 class="section-head">Reach</h3>
<p class="muted">The scale across which wealth, reputation, and connections remain meaningful — gates what Availability/Tier of Signature Equipment this NPC can carry (see Equipment section below).</p>
<div class="influence-row">
  <div class="wound-block">
    <label>Reach <input name="system.reach" type="number" value="{{system.reach}}" style="width:3em"></label>
    {{#if (gt system.effectiveReach system.reach)}}
      <span class="muted">(effective {{system.effectiveReach}} with active Reach Triggers)</span>
    {{/if}}
  </div>
</div>
{{#if reachTriggers.length}}
  <table class="item-table">
    <thead><tr><th>Reach Trigger</th><th>Reach +</th><th>Temp Influence</th><th>Used</th><th>Active</th><th></th></tr></thead>
    <tbody>
      {{#each reachTriggers as |t|}}
        <tr>
          <td><input name="system.reachTriggers.{{t.i}}.name" type="text" value="{{t.name}}" placeholder="e.g. Letters of Standing"></td>
          <td><input name="system.reachTriggers.{{t.i}}.tempBonus" type="number" value="{{t.tempBonus}}" style="width:3em"></td>
          <td><input name="system.reachTriggers.{{t.i}}.tempInfluenceGrant" type="number" value="{{t.tempInfluenceGrant}}" style="width:3em"></td>
          <td>{{#if t.usedThisAdventure}}Yes{{else}}No{{/if}}</td>
          <td>{{#if t.active}}Active{{else}}—{{/if}}</td>
          <td>
            <button type="button" data-action="activateReachTrigger" data-index="{{t.i}}">Activate</button>
            <button type="button" data-action="deactivateReachTrigger" data-index="{{t.i}}" {{#unless t.active}}disabled{{/unless}}>End Scene</button>
            <button type="button" data-action="deleteReachTrigger" data-index="{{t.i}}" aria-label="Delete {{t.name}}"><i class="fa-solid fa-trash"></i></button>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{/if}}
<button type="button" data-action="addReachTrigger"><i class="fa-solid fa-plus"></i> Add Reach Trigger</button>
<button type="button" data-action="resetAdventureUses" title="Also resets every owned Function Augment's Uses and every Consumable Kit's Equipment Card Uses">Reset All for New Adventure</button>

<div class="combat-header">
  <div class="combat-header-left">
    <label>Movement <input name="system.movement" type="number" value="{{system.movement}}" style="width:4em"> units</label>
    <div class="action-pool">
      <span class="attr-label">Action Dice</span> {{system.playState.actionDice}}
      &nbsp;|&nbsp;
      <span class="attr-label">Reaction Dice</span> {{system.playState.reactionDice}}
    </div>
  </div>
  <div class="combat-header-right">
    <div class="combat-controls">
      <button type="button" data-action="rollInitiative">Roll Initiative</button>
      <button type="button" data-action="endTurn">End Turn</button>
      <button type="button" data-action="burnDice">Burn Dice</button>
    </div>
    <div class="combat-state">
      <p>Round {{combatRound}} — {{turnLabel system.playState.combatTurn}}</p>
    </div>
  </div>
</div>

<input type="text" data-card-filter placeholder="Search Action &amp; Reaction Cards…" class="card-filter-input">

<h3 class="section-head">Basic Actions</h3>
<div class="basic-action-grid">
  {{#each basicActionCards as |item|}}
    <button type="button" class="basic-action-btn" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
  {{else}}
    <span class="muted">No Basic Actions — drag Hide, Strike, etc. from the compendium.</span>
  {{/each}}
</div>

<div class="card-section-head">
  <h3 class="section-head">Action Cards</h3>
  <select data-card-sort="action">
    <option value="name">Sort: Name</option>
    <option value="skill">Sort: Skill</option>
    <option value="cost">Sort: Cost</option>
    <option value="rank">Sort: Rank</option>
  </select>
</div>
<ul class="item-list card-list" data-card-list="action">
  {{#each actionCards as |item|}}
    <li data-card-name="{{item.name}}" data-card-skill="{{item.system.skill}}" data-card-cost="{{item.system.cost}}" data-card-rank="{{item.system.rank}}" data-card-summary="{{item.summary}}">
      <div class="card-row-top">
        <button type="button" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
        <span class="card-meta muted">R{{item.system.rank}}{{#if item.system.skill}} · {{capitalize item.system.skill}}{{/if}}{{#if item.system.cost}} · Cost {{item.system.cost}}{{/if}}{{#if item.system.tags}} · {{item.system.tags}}{{/if}}</span>
        <button type="button" data-action="itemView" data-item-id="{{item.id}}" aria-label="View {{item.name}}"><i class="fa-solid fa-eye"></i></button>
        <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" aria-label="Edit {{item.name}}"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" aria-label="Delete {{item.name}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{#if item.summary}}<p class="card-summary muted">{{item.summary}}</p>{{/if}}
    </li>
  {{else}}
    <li class="muted">No Action Cards — drag one from the compendium.</li>
  {{/each}}
</ul>

<h3 class="section-head">Basic Reactions</h3>
<div class="basic-action-grid">
  {{#each basicReactionCards as |item|}}
    <button type="button" class="basic-action-btn" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
  {{else}}
    <span class="muted">No Basic Reactions — drag Brace, etc. from the compendium.</span>
  {{/each}}
</div>

<div class="card-section-head">
  <h3 class="section-head">Reaction Cards</h3>
  <select data-card-sort="reaction">
    <option value="name">Sort: Name</option>
    <option value="skill">Sort: Skill</option>
    <option value="cost">Sort: Cost</option>
    <option value="rank">Sort: Rank</option>
  </select>
</div>
<ul class="item-list card-list" data-card-list="reaction">
  {{#each reactionCards as |item|}}
    <li data-card-name="{{item.name}}" data-card-skill="{{item.system.skill}}" data-card-cost="{{item.system.cost}}" data-card-rank="{{item.system.rank}}" data-card-summary="{{item.summary}}">
      <div class="card-row-top">
        <button type="button" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
        <span class="card-meta muted">R{{item.system.rank}}{{#if item.system.skill}} · {{capitalize item.system.skill}}{{/if}}{{#if item.system.cost}} · Cost {{item.system.cost}}{{/if}}{{#if item.system.tags}} · {{item.system.tags}}{{/if}}</span>
        <button type="button" data-action="itemView" data-item-id="{{item.id}}" aria-label="View {{item.name}}"><i class="fa-solid fa-eye"></i></button>
        <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" aria-label="Edit {{item.name}}"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" aria-label="Delete {{item.name}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{#if item.summary}}<p class="card-summary muted">{{item.summary}}</p>{{/if}}
    </li>
  {{else}}
    <li class="muted">No Reaction Cards — drag one from the compendium.</li>
  {{/each}}
</ul>

<h3 class="section-head">Conditions</h3>
<ul class="item-list condition-list">
  {{#each conditions as |item|}}
    <li class="condition-entry">
      <div class="condition-head">
        <strong>{{item.name}}</strong>
        <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" aria-label="Edit {{item.name}}"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" aria-label="Delete {{item.name}}"><i class="fa-solid fa-trash"></i></button>
      </div>
    </li>
  {{/each}}
</ul>
<h3 class="section-head">Signature Equipment <span class="muted">({{signatureUsed}} / {{system.signatureEquipmentLimit}}) &middot; Reach {{system.effectiveReach}}</span></h3>
{{#if (gt signatureOverLimit 0)}}
  <p class="muted signature-overlimit-note">Over your Signature Limit by {{signatureOverLimit}} full slot{{#if (gt signatureOverLimit 1)}}s{{/if}} — spend 1 Temporary Influence per extra slot to cover it. <button type="button" data-action="spendInfluenceForSlot">Spend Influence for Extra Slot</button></p>
{{/if}}
<ul class="item-list">
  {{#each signatureEquipment as |item|}}
    <li>{{item.name}} <span class="muted">{{equipmentCategoryLabel item.system.category}} &middot; Reach {{item.reachCost}}</span>
      {{#if item.overReach}}
        <span class="muted reach-warning" title="{{#if item.exceptionSource}}Exceeds Reach even with the {{item.exceptionSource}} exception's allowed margin.{{else}}Reach cost exceeds this NPC's current Reach. Non-blocking.{{/if}}"><i class="fa-solid fa-triangle-exclamation"></i></span>
      {{/if}}
      <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" aria-label="Edit {{item.name}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" aria-label="Delete {{item.name}}"><i class="fa-solid fa-trash"></i></button>
    </li>
  {{/each}}
</ul>

{{#if itemGrants.length}}
  <h3 class="section-head">Item Grants <span class="muted">(Quartermaster's Due, Internal Compartment, ...)</span></h3>
  <ul class="item-list">
    {{#each itemGrants as |grant|}}
      <li>
        <strong>{{grant.sourceName}}</strong>
        {{#if grant.grantedItem}}
          — <a data-action="itemView" data-item-id="{{grant.grantedItem.id}}">{{grant.grantedItem.name}}</a>
          <button type="button" data-action="chooseGrantedItem" data-grant-source="{{grant.sourceName}}">Replace</button>
        {{else}}
          <span class="muted">— not yet chosen</span>
          <button type="button" data-action="chooseGrantedItem" data-grant-source="{{grant.sourceName}}">Choose Item</button>
        {{/if}}
      </li>
    {{/each}}
  </ul>
{{/if}}

<h3 class="section-head">Temporary Items</h3>
<ul class="item-list">
  {{#each temporaryEquipment as |item|}}
    <li>{{item.name}} <span class="muted">{{equipmentCategoryLabel item.system.category}}</span>
      <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" aria-label="Edit {{item.name}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" aria-label="Delete {{item.name}}"><i class="fa-solid fa-trash"></i></button>
    </li>
  {{/each}}
</ul>

<h3 class="section-head">Armory <span class="muted">({{armoryUsed}} / {{system.armoryLimit}})</span></h3>
<ul class="item-list">
  {{#each armoryEquipment as |item|}}
    <li>{{item.name}} <span class="muted">{{equipmentCategoryLabel item.system.category}}</span>
      <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" aria-label="Edit {{item.name}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" aria-label="Delete {{item.name}}"><i class="fa-solid fa-trash"></i></button>
    </li>
  {{/each}}
</ul>

<h3 class="section-head">Components &amp; Augments <span class="muted">(loose Chassis/Fittings ½ slot each; Augments 0)</span></h3>
<ul class="item-list">
  {{#each componentItems as |c|}}
    <li>{{c.name}} <span class="muted">{{capitalize c.type}} · {{capitalize c.slot}}{{#if c.tier}} · Tier {{c.tier}}{{/if}}</span>
      <button type="button" data-action="itemEdit" data-item-id="{{c.id}}" aria-label="Edit {{c.name}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="itemDelete" data-item-id="{{c.id}}" aria-label="Delete {{c.name}}"><i class="fa-solid fa-trash"></i></button>
    </li>
  {{/each}}
</ul>

<h3 class="section-head">GM Notes <span class="muted">(tactics, behavior, reminders)</span></h3>
{{essenceEditor system.gmNotes target="system.gmNotes" button=true}}
</div>
