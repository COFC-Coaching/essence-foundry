{{!-- ============ NON-COMBAT: career, skills, influence, features ============ --}}
<section class="tab noncombat {{tabs.noncombat.cssClass}}" data-group="primary" data-tab="noncombat">
  <h3 class="section-head">{{localize "ESSENCE.Character.CareerKeyAspects"}}</h3>
  <div class="career-row">
    <label><span class="hint-term" data-tooltip-text="{{localize 'ESSENCE.Character.CareerHint'}}">{{localize "ESSENCE.Character.Career"}}</span> <input name="system.career" type="text" value="{{system.career}}" aria-description="{{localize 'ESSENCE.Character.CareerHint'}}"></label>
  </div>
  <div class="key-aspects-row">
    {{#each keyAspects as |aspect|}}
      <div class="key-aspect-row">
        <label>{{localize "ESSENCE.Character.KeyAspect"}} {{aspect.n}}<input name="system.keyAspects.{{aspect.i}}" type="text" value="{{aspect.value}}"></label>
        <button type="button" data-action="rollKeyAspect" data-index="{{aspect.i}}" aria-label="{{localize 'ESSENCE.Character.RollKeyAspectAria' n=aspect.n}}" data-tooltip-text="{{localize 'ESSENCE.Character.RollKeyAspectHint'}}"><i class="fa-solid fa-dice-d10"></i></button>
      </div>
    {{/each}}
  </div>

  <h3 class="section-head">{{localize "ESSENCE.Character.NonCombatSkills"}}</h3>
  <div class="noncombat-skills grid-2">
    {{#each system.nonCombatSkills as |s i|}}
      <div class="nc-skill-row">
        <input name="system.nonCombatSkills.{{i}}.name" type="text" value="{{s.name}}" placeholder="{{localize 'ESSENCE.Common.Skill'}}">
        <input class="w-3" name="system.nonCombatSkills.{{i}}.rating" type="number" value="{{s.rating}}">
        <button type="button" data-action="rollNonCombatSkill" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Character.RollSkillAria' name=s.name}}" data-tooltip-text="{{localize 'ESSENCE.Character.RollSkillAria' name=s.name}}"><i class="fa-solid fa-dice-d10"></i></button>
        <button type="button" data-action="deleteArrayRow" data-array="nonCombatSkills" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Character.DeleteSkillAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
      </div>
    {{/each}}
  </div>
  <button type="button" data-action="addArrayRow" data-array="nonCombatSkills"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Character.AddSkill"}}</button>

  <h3 class="section-head">{{localize "ESSENCE.Character.Connections"}} <span class="muted">({{connections.length}} / {{system.connectionLimit}}) · {{localize "ESSENCE.Character.ConnectionsHint"}}</span></h3>
  {{#if connectionsOverLimit}}<p class="muted bio-standing-note">{{localize "ESSENCE.Character.ConnectionsOverLimit" n=system.connectionLimit}}</p>{{/if}}
  <table class="item-table">
    <thead><tr><th>{{localize "ESSENCE.Common.Name"}}</th><th data-tooltip-text="{{localize 'ESSENCE.Character.ConnectionAreaHint'}}">{{localize "ESSENCE.Character.ConnectionArea"}}</th><th data-tooltip-text="{{localize 'ESSENCE.Character.ConnectionRelationshipHint'}}">{{localize "ESSENCE.Character.ConnectionRelationship"}}</th><th class="connection-tier-col" data-tooltip-text="{{localize 'ESSENCE.Character.ConnectionTierHint'}}">{{localize "ESSENCE.Character.ConnectionTier"}}</th><th></th></tr></thead>
    <tbody>
      {{#each connections as |c|}}
        <tr>
          <td><input name="system.connections.{{c.i}}.name" type="text" value="{{c.name}}"></td>
          <td><input name="system.connections.{{c.i}}.area" type="text" value="{{c.area}}" placeholder="{{localize 'ESSENCE.Character.ConnectionAreaPlaceholder'}}" aria-label="{{localize 'ESSENCE.Character.ConnectionArea'}}" aria-description="{{localize 'ESSENCE.Character.ConnectionAreaHint'}}"></td>
          <td><input name="system.connections.{{c.i}}.relationship" type="text" value="{{c.relationship}}" placeholder="{{localize 'ESSENCE.Character.ConnectionRelationshipPlaceholder'}}" aria-label="{{localize 'ESSENCE.Character.ConnectionRelationship'}}" aria-description="{{localize 'ESSENCE.Character.ConnectionRelationshipHint'}}"></td>
          <td class="connection-tier-col"><select name="system.connections.{{c.i}}.tier" data-dtype="Number" aria-label="{{localize 'ESSENCE.Character.ConnectionTierAria' name=c.name}}" aria-description="{{localize 'ESSENCE.Character.ConnectionTierHint'}}">{{#each @root.connectionTierOptions as |o|}}<option value="{{o.value}}" {{#if (eq o.value c.tier)}}selected{{/if}}>{{o.value}}</option>{{/each}}</select></td>
          <td><button type="button" data-action="deleteArrayRow" data-array="connections" data-index="{{c.i}}" aria-label="{{localize 'ESSENCE.Character.DeleteConnectionAria' n=(addOne c.i)}}"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <button type="button" data-action="addArrayRow" data-array="connections"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Character.AddConnection"}}</button>

  <h3 class="section-head">{{localize "ESSENCE.Sheet.Influence"}} <span class="muted">— {{system.standing}}</span></h3>
  <div class="influence-row">
    <div class="wound-block">
      <span class="attr-label">{{localize "ESSENCE.Sheet.TemporaryInfluence"}}</span>
      <span class="pip-track">
        {{#each temporaryInfluencePips as |filled i|}}
          <button type="button" class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempInfluence" data-index="{{i}}" aria-pressed="{{filled}}" aria-label="{{localize 'ESSENCE.Sheet.TemporaryInfluenceAria' n=(addOne i)}}"></button>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Sheet.InfluenceRecoveryNote'}}">{{localize "ESSENCE.Sheet.CoreInfluence"}}</span>
      <span class="pip-track">
        {{#each system.coreInfluence as |c i|}}
          <button type="button" class="pip toggle labeled sq {{#if c.filled}}filled{{/if}}" data-action="toggleCoreInfluence" data-index="{{i}}" data-tooltip-text="{{c.condition}}" aria-pressed="{{c.filled}}" aria-label="{{localize 'ESSENCE.Sheet.CoreInfluenceAria' n=(addOne i)}}{{#if c.condition}}: {{c.condition}}{{/if}}">{{lookup ../coreInfluenceLabels i}}</button>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <button type="button" data-action="applyInfluenceInjury">{{localize "ESSENCE.Sheet.ApplyInfluenceInjury"}}</button>
      <button type="button" data-action="recoverInfluenceInjury">{{localize "ESSENCE.Sheet.RecoverInfluence"}}</button>
      <button type="button" data-action="contributeToGoal">{{localize "ESSENCE.Sheet.ContributeToSharedGoal"}}</button>
    </div>
  </div>
  <h3 class="section-head">{{localize "ESSENCE.Sheet.Reach"}}</h3>
  <div class="influence-row">
    <div class="wound-block">
      <label data-tooltip-text="{{localize 'ESSENCE.Character.ReachHint'}}">{{localize "ESSENCE.Sheet.Reach"}} <input class="w-3" name="system.reach" type="number" value="{{system.reach}}"></label>
      {{#if (gt system.effectiveReach system.reach)}}
        <span class="muted">{{localize "ESSENCE.Sheet.EffectiveReachNote" n=system.effectiveReach}}</span>
      {{/if}}
      <span class="muted" data-tooltip-text="{{localize 'ESSENCE.Sheet.ReachPressureNote' n=system.reachPressure max=system.effectiveReach}}">{{localize "ESSENCE.Sheet.ReachPressureShort" n=system.reachPressure max=system.effectiveReach}}</span>
    </div>
  </div>

  {{#if reachTriggers.length}}
    <h4 class="section-subhead">{{localize "ESSENCE.Character.AdventureLimitedReachTriggers"}} <span class="muted">{{localize "ESSENCE.Character.ReachTriggerExamples"}}</span></h4>
    <table class="item-table">
      <thead><tr><th>{{localize "ESSENCE.Common.Name"}}</th><th>{{localize "ESSENCE.Sheet.ReachPlus"}}</th><th>{{localize "ESSENCE.Sheet.TempInfluence"}}</th><th>{{localize "ESSENCE.Character.UsedThisAdventure"}}</th><th>{{localize "ESSENCE.Common.Active"}}</th><th></th></tr></thead>
      <tbody>
        {{#each reachTriggers as |t|}}
          <tr>
            <td><input name="system.reachTriggers.{{t.i}}.name" type="text" value="{{t.name}}" placeholder="{{localize 'ESSENCE.Character.ReachTriggerNamePlaceholder'}}"></td>
            <td><input class="w-3" name="system.reachTriggers.{{t.i}}.tempBonus" type="number" value="{{t.tempBonus}}"></td>
            <td><input class="w-3" name="system.reachTriggers.{{t.i}}.tempInfluenceGrant" type="number" value="{{t.tempInfluenceGrant}}"></td>
            <td>{{#if t.usedThisAdventure}}{{localize "ESSENCE.Common.Yes"}}{{else}}{{localize "ESSENCE.Common.No"}}{{/if}}</td>
            <td>{{#if t.active}}{{localize "ESSENCE.Common.Active"}}{{else}}—{{/if}}</td>
            <td>
              <button type="button" data-action="activateReachTrigger" data-index="{{t.i}}">{{localize "ESSENCE.Sheet.Activate"}}</button>
              <button type="button" data-action="deactivateReachTrigger" data-index="{{t.i}}" {{#unless t.active}}disabled{{/unless}}>{{localize "ESSENCE.Sheet.EndEncounter"}}</button>
              <button type="button" data-action="deleteArrayRow" data-array="reachTriggers" data-index="{{t.i}}" aria-label="{{localize 'ESSENCE.Common.DeleteAria' name=t.name}}"><i class="fa-solid fa-trash"></i></button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{/if}}
  <button type="button" data-action="addArrayRow" data-array="reachTriggers" data-tooltip-text="{{localize 'ESSENCE.Character.ReachTriggerBreachNote'}}"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Sheet.AddReachTrigger"}}</button>
  <button type="button" data-action="resetAdventureUses" data-tooltip-text="{{localize 'ESSENCE.Sheet.ResetAdventureUsesTooltip'}}">{{localize "ESSENCE.Sheet.ResetAdventureUses"}}</button>
  <button type="button" data-action="newEncounter" data-tooltip-text="{{localize 'ESSENCE.Sheet.NewEncounterTooltip'}}">{{localize "ESSENCE.Sheet.NewEncounter"}}</button>
  {{!-- General Features & Benefits and Languages moved to the Core tab (0.15.0). --}}
</section>

{{!-- ============ BIOGRAPHY ============ --}}
<section class="tab bio {{tabs.bio.cssClass}}" data-group="primary" data-tab="bio">
  <div class="bio-standing">
    <h3 class="section-head">{{localize "ESSENCE.Character.TeamAndAdvancement"}}</h3>
    <div class="bio-standing-grid">
      <div class="bio-cell bio-cell-wide" data-tooltip-text="{{localize 'ESSENCE.Character.TeamCellHint'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Character.Team"}}</span>
        <span class="bio-cell-value">{{#if team}}<button type="button" class="link-button" data-action="openTeam">{{team.name}}</button>{{else}}<span class="muted">{{localize "ESSENCE.Character.NoTeamShort"}}</span>{{/if}}</span>
      </div>
      <div class="bio-cell" data-tooltip-text="{{localize 'ESSENCE.Character.TeamTierHint'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Team.Tier"}}</span>
        <span class="bio-cell-value">{{teamTier}}</span>
      </div>
      <label class="bio-cell" data-tooltip-text="{{localize 'ESSENCE.Character.LevelHint'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Common.Level"}}</span>
        <input name="system.level" type="number" min="1" value="{{system.level}}">
      </label>
      <label class="bio-cell{{#if apOverspent}} bio-cell-warn{{/if}}" data-tooltip-text="{{localize 'ESSENCE.Character.AdvancementPointsTooltip'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Character.AdvancementPointsSpent"}}</span>
        <input name="system.advancementPointsSpent" type="number" min="0" value="{{system.advancementPointsSpent}}" {{#if apOverspent}}aria-invalid="true" aria-describedby="essence-ap-overspent-{{actor.id}}"{{/if}}>
      </label>
      <div class="bio-cell{{#if apOverspent}} bio-cell-warn{{/if}}" data-tooltip-text="{{localize 'ESSENCE.Character.AdvancementPointsTooltip'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Character.AdvancementPointsAvailable"}}</span>
        <span class="bio-cell-value">{{apBalanceLabel}}</span>
      </div>
      <label class="bio-cell" data-tooltip-text="{{localize 'ESSENCE.Common.PoolBonusHint'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Common.PoolBonus"}}</span>
        <input name="system.poolBonus" type="number" min="0" value="{{system.poolBonus}}">
      </label>
      <div class="bio-cell" data-tooltip-text="{{localize 'ESSENCE.Common.PoolBonusHint'}}">
        <span class="bio-cell-label">{{localize "ESSENCE.Character.BasePools"}}</span>
        <span class="bio-cell-value">{{system.baseCombatDice}} <span class="muted bio-cell-note">{{localize "ESSENCE.Character.BasePoolsFormula" bonus=system.poolBonus}}</span></span>
      </div>
    </div>
    {{#unless team}}<p class="muted bio-standing-note">{{localize "ESSENCE.Character.NoTeamHint"}}</p>{{/unless}}
    {{#if apOverspent}}<p class="bio-standing-note reach-warning" id="essence-ap-overspent-{{actor.id}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "ESSENCE.Character.AdvancementPointsOverspent"}}</p>{{/if}}
  </div>
  <label>{{localize "ESSENCE.Character.Concept"}}{{essenceEditor system.concept target="system.concept" button=true}}</label>
  <label>{{localize "ESSENCE.Character.Appearance"}}{{essenceEditor system.appearance target="system.appearance" button=true}}</label>
  <label>{{localize "ESSENCE.Character.Personality"}}{{essenceEditor system.personality target="system.personality" button=true}}</label>
  <label>{{localize "ESSENCE.Character.Backstory"}}{{essenceEditor system.backstory target="system.backstory" button=true}}</label>
  <label>{{localize "ESSENCE.Character.GeneralNotes"}}<textarea name="system.playState.sessionNotes">{{system.playState.sessionNotes}}</textarea></label>
</section>
</div>
{{!-- Vitals sidebar (frame 0.14.0, contents 0.15.0): the blocks that used to sit on the Core and
     Combat tabs, moved whole. Every data-action keeps its name, so the sheet class is unchanged.
     It is a second scroll region beside the tab body and is visible on every tab. --}}
<aside class="sheet-side sheet-scroll">
  <div class="side-panel side-pools">
    <div class="side-pool">
      <span class="side-label">{{localize "ESSENCE.Common.ActionDice"}}</span>
      <div class="side-pool-row">
        <button type="button" class="resource-step" data-action="adjustPoolDice" data-field="actionDice" data-delta="-1" aria-label="{{localize 'ESSENCE.Sheet.DecreaseAria' label=(localize 'ESSENCE.Common.ActionDice')}}">−</button>
        <span class="side-pool-num">{{system.playState.actionDice}}</span>
        <button type="button" class="resource-step" data-action="adjustPoolDice" data-field="actionDice" data-delta="1" aria-label="{{localize 'ESSENCE.Sheet.IncreaseAria' label=(localize 'ESSENCE.Common.ActionDice')}}">+</button>
      </div>
    </div>
    <div class="side-pool">
      <span class="side-label">{{localize "ESSENCE.Common.ReactionDice"}}</span>
      <div class="side-pool-row">
        <button type="button" class="resource-step" data-action="adjustPoolDice" data-field="reactionDice" data-delta="-1" aria-label="{{localize 'ESSENCE.Sheet.DecreaseAria' label=(localize 'ESSENCE.Common.ReactionDice')}}">−</button>
        <span class="side-pool-num">{{system.playState.reactionDice}}</span>
        <button type="button" class="resource-step" data-action="adjustPoolDice" data-field="reactionDice" data-delta="1" aria-label="{{localize 'ESSENCE.Sheet.IncreaseAria' label=(localize 'ESSENCE.Common.ReactionDice')}}">+</button>
      </div>
    </div>
    <span class="muted side-pool-note">{{localize "ESSENCE.Sheet.BasePoolsNote" base=system.baseCombatDice bonus=system.poolBonus}}</span>
  </div>

  <div class="side-panel">
    <span class="side-label">{{localize "ESSENCE.Sheet.Resources"}}</span>
    {{#each domains as |d|}}
      <div class="side-resource domain-{{d.key}}">
        <span class="side-domain-label">{{d.resourceLabel}}</span>
        <span class="side-resource-controls">
          <button type="button" class="resource-step" data-action="adjustResource" data-field="{{d.resourceField}}" data-delta="-1" aria-label="{{localize 'ESSENCE.Sheet.DecreaseAria' label=d.resourceLabel}}">−</button>
          <input class="current-input" type="number" name="system.playState.{{d.resourceField}}" value="{{d.resourceCurrent}}">
          <button type="button" class="resource-step" data-action="adjustResource" data-field="{{d.resourceField}}" data-delta="1" aria-label="{{localize 'ESSENCE.Sheet.IncreaseAria' label=d.resourceLabel}}">+</button>
          <span class="muted">/ <span class="max-value">{{d.resourceMax}}</span></span>
        </span>
      </div>
    {{/each}}
  </div>

  <div class="side-panel">
    <span class="side-label">{{localize "ESSENCE.Sheet.Defenses"}}</span>
    <div class="side-defenses">
      {{#each domains as |d|}}
        <div class="side-defense domain-{{d.key}}">
          <span class="side-defense-num">{{d.defenseValue}}</span>
          <span class="side-domain-label">{{d.defenseLabel}}</span>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="side-panel side-wounds">
    <span class="side-label">{{localize "ESSENCE.Common.Wounds"}} <span class="side-state">{{system.woundState}}</span></span>
    {{!-- Each tile leads with the number used in play and keeps the build value it comes from
          as a small input underneath, number first like the Defense tiles above (0.18.8). --}}
    <div class="side-tiles">
      <div class="side-tile">
        <span class="side-tile-num">{{system.effectiveResilience}}</span>
        <span class="side-tile-label">{{localize "ESSENCE.Common.Resilience"}}</span>
        <label class="side-tile-note">{{localize "ESSENCE.Sheet.BaseValue"}}
          <input class="side-tile-input" type="number" name="system.resilience" value="{{system.resilience}}" min="0" aria-label="{{localize 'ESSENCE.Sheet.BaseResilienceAria'}}">
        </label>
      </div>
      <div class="side-tile">
        {{!-- The big number is the Temporary Wounds still available (Apply Damage spends them);
              the input is how many gear and features grant. Nothing derives the granted count and
              no Active Effect writes it, so it needs a real input somewhere. --}}
        <span class="side-tile-num-row">
          <button type="button" class="resource-step" data-action="adjustTempWounds" data-delta="-1" aria-label="{{localize 'ESSENCE.Sheet.SpendTempWoundAria'}}" data-tooltip-text="{{localize 'ESSENCE.Sheet.SpendTempWoundAria'}}" {{#unless system.playState.currentTemporaryWounds}}disabled{{/unless}}>−</button>
          <span class="side-tile-num" role="img" aria-label="{{localize 'ESSENCE.Sheet.TempWoundsRemainingAria' n=system.playState.currentTemporaryWounds}}">{{system.playState.currentTemporaryWounds}}</span>
          <button type="button" class="resource-step" data-action="adjustTempWounds" data-delta="1" aria-label="{{localize 'ESSENCE.Sheet.RestoreTempWoundAria'}}" data-tooltip-text="{{localize 'ESSENCE.Sheet.RestoreTempWoundAria'}}" {{#unless tempWoundsCanRestore}}disabled{{/unless}}>+</button>
        </span>
        <span class="side-tile-label">{{localize "ESSENCE.Sheet.TemporaryWoundsShort"}}</span>
        <label class="side-tile-note" data-tooltip-text="{{localize 'ESSENCE.Sheet.TemporaryWoundsAvailableHint'}}">{{localize "ESSENCE.Sheet.OfGranted"}}
          <input class="side-tile-input" type="number" name="system.temporaryWoundsAvailable" value="{{system.temporaryWoundsAvailable}}" min="0" max="5" aria-label="{{localize 'ESSENCE.Sheet.TemporaryWoundsGrantedAria'}}">
        </label>
      </div>
    </div>

    <div class="side-core-wounds">
      <span class="side-sublabel">{{localize "ESSENCE.Common.CoreWounds"}}</span>
      <span class="side-core-track">
        {{#each system.coreWounds as |w i|}}
          {{!-- The tooltip names the box's severity, so the L/S/C letters have a key even on an
                empty box; a marked box adds its Condition. --}}
          <button type="button" class="pip toggle labeled sq {{#if w.filled}}filled{{/if}}" data-action="toggleCoreWound" data-index="{{i}}" data-tooltip-text="{{lookup ../coreWoundSeverities i}}{{#if w.condition}}: {{w.condition}}{{/if}}" aria-pressed="{{w.filled}}" aria-label="{{localize 'ESSENCE.Sheet.CoreWoundAria' n=(addOne i)}}, {{lookup ../coreWoundSeverities i}}{{#if w.condition}}: {{w.condition}}{{/if}}">{{lookup ../coreWoundLabels i}}</button>
        {{/each}}
      </span>
    </div>

    {{!-- Apply Damage is the action used most in a fight, so it takes the full-width slot. --}}
    <div class="side-actions">
      <button type="button" class="side-actions-wide" data-action="applyDamage" data-tooltip-text="{{localize 'ESSENCE.Sheet.ApplyDamageHint'}}" aria-description="{{localize 'ESSENCE.Sheet.ApplyDamageHint'}}">{{localize "ESSENCE.Sheet.ApplyDamage"}}</button>
      <button type="button" data-action="recoverWound" data-tooltip-text="{{localize 'ESSENCE.Sheet.RecoverWoundHint'}}" aria-description="{{localize 'ESSENCE.Sheet.RecoverWoundHint'}}">{{localize "ESSENCE.Sheet.RecoverWound"}}</button>
      <button type="button" data-action="grantRecovery" data-tooltip-text="{{localize 'ESSENCE.Sheet.GrantRecoveryHint'}}" aria-description="{{localize 'ESSENCE.Sheet.GrantRecoveryHint'}}">{{localize "ESSENCE.Sheet.GrantRecovery"}}</button>
    </div>

    {{!-- The checkbox carries the state for screen readers, so the Available/Used word is hidden
          from them; the hint is its description, since a tooltip never shows on keyboard focus. --}}
    <label class="side-toggle" data-tooltip-text="{{localize 'ESSENCE.Sheet.AdaptabilityRerollHint'}}">
      <input type="checkbox" data-action="toggleAdaptabilityReroll" aria-description="{{localize 'ESSENCE.Sheet.AdaptabilityRerollHint'}}" {{#if system.playState.adaptabilityRerollAvailable}}checked{{/if}}>
      <span class="side-toggle-label">{{localize "ESSENCE.Sheet.AdaptabilityRerollShort"}}</span>
      <span class="side-toggle-state" aria-hidden="true">{{#if system.playState.adaptabilityRerollAvailable}}{{localize "ESSENCE.Common.Available"}}{{else}}{{localize "ESSENCE.Common.Used"}}{{/if}}</span>
    </label>

    {{#if equipmentBonusSources.length}}
      <div class="side-bonus">
        <span class="side-sublabel">{{localize "ESSENCE.Sheet.EquipmentBonusSourcesLabel"}}</span>
        {{#each equipmentBonusSources as |b|}}
          <div class="side-bonus-row"><span class="side-bonus-name">{{b.name}}</span><span class="side-bonus-parts">{{b.summary}}</span></div>
        {{/each}}
      </div>
    {{/if}}
    {{> "systems/essence-system/templates/actor/parts/death-track.hbs"}}
  </div>

  <div class="side-panel">
    <span class="side-label">{{localize "ESSENCE.Sheet.Conditions"}} <button type="button" class="side-add" data-action="addCondition" data-tooltip-text="{{localize 'ESSENCE.Sheet.AddCondition'}}"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Sheet.Add"}}</button></span>
    {{#if conditions.length}}
      <ul class="item-list condition-list">
        {{#each conditions as |item|}}
          <li class="condition-entry">
            <div class="condition-head">
              <strong class="condition-name">{{item.name}}</strong>
              <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" data-tooltip-text="{{localize 'ESSENCE.Common.EditAria' name=item.name}}" aria-label="{{localize 'ESSENCE.Common.EditAria' name=item.name}}"><i class="fa-solid fa-pen"></i></button>
              <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" data-tooltip-text="{{localize 'ESSENCE.Common.DeleteAria' name=item.name}}" aria-label="{{localize 'ESSENCE.Common.DeleteAria' name=item.name}}"><i class="fa-solid fa-trash"></i></button>
            </div>
            {{#if item.system.sections.length}}
              {{!-- The rule text is folded: a Condition such as Fatigued runs to a dozen lines, and
                    the sidebar is for seeing what is active at a glance. --}}
              {{!-- data-item-id lets the sheet reopen this after a re-render (see #keepConditionRulesOpen). --}}
              <details class="condition-rules" data-item-id="{{item.id}}" {{#if (lookup @root.openConditionRules item.id)}}open{{/if}}>
                <summary aria-label="{{localize 'ESSENCE.Sheet.ConditionRulesAria' name=item.name}}">{{localize "ESSENCE.Sheet.ConditionRules"}}</summary>
                {{#each item.system.sections as |s|}}
                  <div class="condition-section"><span class="condition-label">{{s.label}}</span> {{{s.html}}}</div>
                {{/each}}
              </details>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <span class="muted">{{localize "ESSENCE.Sheet.NoConditions"}}</span>
    {{/if}}
  </div>

  <div class="side-panel side-readout">
    <span class="side-label">{{localize "ESSENCE.Sheet.Influence"}} <span class="side-state">{{system.standing}}</span></span>
    <dl class="side-readout-list">
      <dt>{{localize "ESSENCE.Sheet.Reach"}}</dt><dd>{{system.effectiveReach}}</dd>
      <dt>{{localize "ESSENCE.Sheet.ReachPressure"}}</dt><dd>{{system.reachPressure}} <span class="muted">/ {{system.effectiveReach}}</span></dd>
      <dt>{{localize "ESSENCE.Sheet.TemporaryInfluence"}}</dt><dd>{{system.playState.currentTemporaryInfluence}} <span class="muted">/ {{system.temporaryInfluence}}</span></dd>
      <dt>{{localize "ESSENCE.Sheet.CoreInfluence"}}</dt><dd>{{system.coreInfluenceFilled}} <span class="muted">/ {{system.coreInfluence.length}}</span></dd>
    </dl>
  </div>
</aside>
</div>
