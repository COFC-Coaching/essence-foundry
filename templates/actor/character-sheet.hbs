<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" title="{{actor.name}}">
  <div class="header-main">
    <h1><input name="name" type="text" value="{{actor.name}}"></h1>
    <div class="header-fields">
      <label>Player <input name="system.playerName" type="text" value="{{system.playerName}}"></label>
      <label>Tier <input name="system.tier" type="number" value="{{system.tier}}" style="width:3em"></label>
      <label>Level <input name="system.level" type="number" value="{{system.level}}" style="width:3em"></label>
    </div>
    <div class="header-fields">
      <label>Species <input name="system.species" type="text" value="{{system.species}}"></label>
      <label>Heritage <input name="system.heritage" type="text" value="{{system.heritage}}"></label>
      <label>Distinction <input name="system.distinction" type="text" value="{{system.distinction}}"></label>
    </div>
  </div>
</header>

<nav class="sheet-tabs">
  <a data-action="changeTab" data-tab="core">Core</a>
  <a data-action="changeTab" data-tab="combat">Combat</a>
  <a data-action="changeTab" data-tab="equipment">Equipment</a>
  <a data-action="changeTab" data-tab="noncombat">Non-Combat</a>
  <a data-action="changeTab" data-tab="bio">Biography</a>
</nav>

{{!-- ============ CORE: attributes, resources, defenses, wounds ============ --}}
<section class="tab core" data-tab="core">
  <h3 class="section-head">Attributes, Resources &amp; Defenses</h3>
  <div class="domains grid-3">
    {{#each domains as |d|}}
      <div class="domain domain-{{d.key}}">
        <h4>{{d.label}}</h4>
        {{#each d.attrs as |a|}}
          <div class="attr-row">
            <span class="attr-label">{{a.label}}</span>
            <input class="attr-input" name="system.{{a.key}}" type="number" value="{{a.value}}">
            <span class="pip-track">
              {{#each a.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}
            </span>
          </div>
        {{/each}}
        <div class="resource-row">
          <span class="attr-label">{{d.resourceLabel}}</span>
          <input class="current-input" type="number" name="system.playState.{{d.resourceField}}" value="{{d.resourceCurrent}}"> / <span class="max-value">{{d.resourceMax}}</span>
        </div>
        <div class="defense-row">
          <span class="attr-label">{{d.defenseLabel}}</span>
          <span class="max-value">{{d.defenseValue}}</span>
        </div>
      </div>
    {{/each}}
  </div>

  <h3 class="section-head">Wounds</h3>
  <div class="wounds-row">
    <div class="wound-block">
      <span class="attr-label">Resilience</span>
      <input class="current-input" type="number" name="system.resilience" value="{{system.resilience}}">
    </div>
    <div class="wound-block">
      <span class="attr-label">Temporary Wounds</span>
      <span class="pip-track">
        {{#each temporaryWoundPips as |filled i|}}
          <span class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempWound" data-index="{{i}}"></span>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <span class="attr-label">Core Wounds</span>
      <span class="pip-track">
        {{#each system.coreWounds as |w i|}}
          <span class="pip toggle {{#if w.filled}}filled{{/if}}" data-action="toggleCoreWound" data-index="{{i}}" title="{{w.condition}}"></span>
        {{/each}}
      </span>
    </div>
  </div>
</section>

{{!-- ============ COMBAT: skills, cards, dice lifecycle ============ --}}
<section class="tab combat" data-tab="combat">
  <div class="combat-header">
    <label>Movement <input name="system.movement" type="number" value="{{system.movement}}" style="width:4em"> units</label>
    <label>Reach <input name="system.reach" type="number" value="{{system.reach}}" style="width:3em"></label>
    <div class="action-pool">
      <span class="attr-label">Action Dice</span> {{system.playState.actionDice}}
      &nbsp;|&nbsp;
      <span class="attr-label">Reaction Dice</span> {{system.playState.reactionDice}}
    </div>
  </div>

  <div class="domains grid-3">
    {{#each domains as |d|}}
      <div class="domain domain-{{d.key}}">
        {{#each d.skills as |s|}}
          <div class="skill-box">
            <div class="skill-head">
              <button type="button" class="skill-roll" data-action="rollSkill" data-skill="{{s.key}}">{{s.label}}</button>
              <span class="pip-track">
                {{#each s.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}
              </span>
            </div>
            {{#each s.expertises as |e|}}<div class="expertise-line">{{e.name}}</div>{{/each}}
          </div>
        {{/each}}
      </div>
    {{/each}}
  </div>

  <div class="combat-controls">
    <button type="button" data-action="startCombat">Start Combat</button>
    <button type="button" data-action="endCombat">End Combat</button>
    <button type="button" data-action="rollInitiative">Roll Initiative</button>
    <button type="button" data-action="startTurn">Start Turn</button>
    <button type="button" data-action="endTurn">End Turn</button>
  </div>
  <div class="combat-state">
    <p>Round: {{system.playState.combatRound}} — Turn: {{system.playState.combatTurn}} — Initiative: {{system.playState.initiativeTotal}} ({{system.playState.initiativeDice}}d10)</p>
  </div>

  <h3 class="section-head">Action Cards</h3>
  <ul class="item-list">
    {{#each actionCards as |item|}}
      <li>
        <button type="button" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
        <a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
        <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a>
      </li>
    {{/each}}
  </ul>
  <h3 class="section-head">Reaction Cards</h3>
  <ul class="item-list">
    {{#each reactionCards as |item|}}
      <li>
        <button type="button" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
        <a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
        <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a>
      </li>
    {{/each}}
  </ul>
  <h3 class="section-head">Conditions</h3>
  <ul class="item-list">
    {{#each conditions as |item|}}
      <li>{{item.name}} <a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a></li>
    {{/each}}
  </ul>
</section>

{{!-- ============ EQUIPMENT: signature / temporary / armory ============ --}}
<section class="tab equipment" data-tab="equipment">
  <h3 class="section-head">Signature Equipment <span class="muted">(Limit {{system.signatureEquipmentLimit}})</span></h3>
  <table class="item-table">
    <thead><tr><th>#</th><th>Item</th><th>Category</th><th>Effect</th><th></th></tr></thead>
    <tbody>
      {{#each signatureEquipment as |item i|}}
        <tr>
          <td>{{i}}</td><td>{{item.name}}</td><td>{{item.system.category}}</td><td>{{item.system.effect}}</td>
          <td><a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h3 class="section-head">Temporary Items</h3>
  <table class="item-table">
    <thead><tr><th>Item</th><th>Type</th><th>Effect</th><th></th></tr></thead>
    <tbody>
      {{#each temporaryEquipment as |item|}}
        <tr>
          <td>{{item.name}}</td><td>{{item.system.type}}</td><td>{{item.system.effect}}</td>
          <td><a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h3 class="section-head">Armory <span class="muted">(Limit {{system.armoryLimit}})</span></h3>
  <table class="item-table">
    <thead><tr><th>Item</th><th>Category</th><th>Notes</th><th></th></tr></thead>
    <tbody>
      {{#each armoryEquipment as |item|}}
        <tr>
          <td>{{item.name}}</td><td>{{item.system.category}}</td><td>{{item.system.special}}</td>
          <td><a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>

{{!-- ============ NON-COMBAT: career, skills, influence, features ============ --}}
<section class="tab noncombat" data-tab="noncombat">
  <h3 class="section-head">Career &amp; Key Aspects</h3>
  <div class="career-row">
    <label>Career <input name="system.career" type="text" value="{{system.career}}"></label>
  </div>
  <div class="key-aspects-row">
    {{#each keyAspects as |aspect|}}
      <label>Key Aspect {{aspect.n}}<input name="system.keyAspects.{{aspect.i}}" type="text" value="{{aspect.value}}"></label>
    {{/each}}
  </div>

  <h3 class="section-head">Non-Combat Skills</h3>
  <div class="noncombat-skills grid-2">
    {{#each system.nonCombatSkills as |s i|}}
      <div class="nc-skill-row">
        <input name="system.nonCombatSkills.{{i}}.name" type="text" value="{{s.name}}" placeholder="Skill">
        <input name="system.nonCombatSkills.{{i}}.rating" type="number" value="{{s.rating}}" style="width:3em">
      </div>
    {{/each}}
  </div>

  <h3 class="section-head">Influence</h3>
  <div class="influence-row">
    <div class="wound-block">
      <span class="attr-label">Temporary Influence</span>
      <span class="pip-track">
        {{#each temporaryInfluencePips as |filled i|}}
          <span class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempInfluence" data-index="{{i}}"></span>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <span class="attr-label">Core Influence</span>
      <span class="pip-track">
        {{#each system.coreInfluence as |c i|}}
          <span class="pip toggle labeled {{#if c.filled}}filled{{/if}}" data-action="toggleCoreInfluence" data-index="{{i}}">{{lookup ../coreInfluenceLabels i}}</span>
        {{/each}}
      </span>
    </div>
  </div>

  <h3 class="section-head">General Features &amp; Benefits</h3>
  <table class="item-table">
    <thead><tr><th>Feature</th><th>Source</th><th>Description</th></tr></thead>
    <tbody>
      {{#each system.passiveFeatures as |f|}}
        <tr><td>{{f.name}}</td><td>{{f.source}}</td><td>{{{f.text}}}</td></tr>
      {{/each}}
    </tbody>
  </table>
</section>

{{!-- ============ BIOGRAPHY ============ --}}
<section class="tab bio" data-tab="bio">
  <label>Concept<textarea name="system.concept">{{system.concept}}</textarea></label>
  <label>Appearance{{editor system.appearance target="system.appearance" button=true}}</label>
  <label>Personality{{editor system.personality target="system.personality" button=true}}</label>
  <label>Backstory{{editor system.backstory target="system.backstory" button=true}}</label>
  <label>General Notes<textarea name="system.playState.sessionNotes">{{system.playState.sessionNotes}}</textarea></label>
</section>
</div>
