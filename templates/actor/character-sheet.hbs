<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" title="{{actor.name}}">
  <div class="header-main">
    <h1><input name="name" type="text" value="{{actor.name}}"></h1>
    <div class="header-fields">
      <label>Player <input name="system.playerName" type="text" value="{{system.playerName}}"></label>
      <label>Tier <input name="system.tier" type="number" value="{{system.tier}}" style="width:3em"></label>
      <label>Level <input name="system.level" type="number" value="{{system.level}}" style="width:3em"></label>
    </div>
    <div class="header-fields">
      <label>Species <input name="system.species" type="text" value="{{system.species}}"></label>
      <label>Heritage <input name="system.heritage" type="text" value="{{system.heritage}}"></label>
      <label>Distinction <input name="system.distinction" type="text" value="{{system.distinction}}"></label>
    </div>
  </div>
</header>

<nav class="sheet-tabs">
  <a data-action="changeTab" data-tab="core">Core</a>
  <a data-action="changeTab" data-tab="combat">Combat</a>
  <a data-action="changeTab" data-tab="equipment">Equipment</a>
  <a data-action="changeTab" data-tab="noncombat">Non-Combat</a>
  <a data-action="changeTab" data-tab="bio">Biography</a>
</nav>

{{!-- ============ CORE: attributes, resources, defenses, wounds ============ --}}
<section class="tab core" data-tab="core">
  <h3 class="section-head">Attributes, Resources &amp; Defenses</h3>
  <div class="domains grid-3">
    {{#each domains as |d|}}
      <div class="domain domain-{{d.key}}">
        <h4>{{d.label}}</h4>
        {{#each d.attrs as |a|}}
          <div class="attr-row">
            <span class="attr-label">{{a.label}}</span>
            <input class="attr-input" name="system.{{a.key}}" type="number" value="{{a.value}}">
            <span class="pip-track">
              {{#each a.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}
            </span>
          </div>
        {{/each}}
        <div class="resource-row">
          <span class="attr-label">{{d.resourceLabel}}</span>
          <input class="current-input" type="number" name="system.playState.{{d.resourceField}}" value="{{d.resourceCurrent}}"> / <span class="max-value">{{d.resourceMax}}</span>
        </div>
        <div class="defense-row">
          <span class="attr-label">{{d.defenseLabel}}</span>
          <span class="max-value">{{d.defenseValue}}</span>
        </div>
      </div>
    {{/each}}
  </div>

  <h3 class="section-head">Wounds <span class="muted">— {{system.woundState}}</span></h3>
  <div class="wounds-row">
    <div class="wound-block">
      <span class="attr-label">Resilience</span>
      <input class="current-input" type="number" name="system.resilience" value="{{system.resilience}}">
    </div>
    <div class="wound-block">
      <span class="attr-label">Temporary Wounds</span>
      <span class="pip-track">
        {{#each temporaryWoundPips as |filled i|}}
          <span class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempWound" data-index="{{i}}"></span>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <span class="attr-label">Core Wounds</span>
      <span class="pip-track">
        {{#each system.coreWounds as |w i|}}
          <span class="pip toggle {{#if w.filled}}filled{{/if}}" data-action="toggleCoreWound" data-index="{{i}}" title="{{w.condition}}"></span>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <button type="button" data-action="applyDamage">Apply Damage</button>
      <button type="button" data-action="recoverWound">Recover Wound</button>
    </div>
  </div>
  {{#if (eq system.woundState "Critically Wounded")}}
    <div class="wounds-row">
      <div class="wound-block">
        <span class="attr-label">Death Track</span>
        <span class="pip-track">
          {{#each deathTrackPips as |filled i|}}
            <span class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleDeathTrack" data-index="{{i}}"></span>
          {{/each}}
        </span>
      </div>
      <div class="wound-block">
        <label style="display:flex;align-items:center;gap:4px;">
          <input type="checkbox" data-action="toggleDeathTrackFrozen" {{#if system.playState.deathTrackFrozen}}checked{{/if}}> Frozen
        </label>
      </div>
    </div>
  {{/if}}

  <h3 class="section-head">Origin <span class="muted">(drag a Species/Heritage/Distinction Item onto the sheet — traits appear under Non-Combat &gt; General Features &amp; Benefits)</span></h3>
  <div class="origin-cards">
    <div class="origin-card">
      <div class="origin-card-head">Species: {{#if speciesItem}}{{speciesItem.name}}{{else}}<em>none</em>{{/if}}</div>
    </div>
    <div class="origin-card">
      <div class="origin-card-head">Heritage: {{#if heritageItem}}{{heritageItem.name}}{{else}}<em>none</em>{{/if}}</div>
    </div>
    <div class="origin-card">
      <div class="origin-card-head">Distinction: {{#if distinctionItem}}{{distinctionItem.name}}{{else}}<em>none</em>{{/if}}</div>
      {{#if distinctionItem}}
        <div class="origin-trait">Key Skill: {{distinctionItem.system.keyCombatSkill}} · Primary Attribute: {{distinctionItem.system.primaryAttr}}</div>
      {{/if}}
    </div>
  </div>
</section>

{{!-- ============ COMBAT: skills, cards, dice lifecycle ============ --}}
<section class="tab combat" data-tab="combat">
  <div class="combat-header">
    <div class="combat-header-left">
      <label>Movement <input name="system.movement" type="number" value="{{system.movement}}" style="width:4em"> units{{#if system.specialties.combo}} <span class="muted">(effective {{system.totalMovement}} with Combo)</span>{{/if}}</label>
      <label>Reach <input name="system.reach" type="number" value="{{system.reach}}" style="width:3em"></label>
      <div class="action-pool">
        <span class="attr-label">Action Dice</span> {{system.playState.actionDice}}
        &nbsp;|&nbsp;
        <span class="attr-label">Reaction Dice</span> {{system.playState.reactionDice}}
      </div>
    </div>
    <div class="combat-header-right">
      <div class="combat-controls">
        <button type="button" data-action="rollInitiative">Roll Initiative</button>
        <button type="button" data-action="endTurn">End Turn</button>
        <button type="button" data-action="burnDice">Burn Dice</button>
      </div>
      <div class="combat-state">
        <p>Round: {{combatRound}} — Turn: {{system.playState.combatTurn}} — Initiative: {{system.playState.initiativeTotal}} ({{system.playState.initiativeDice}}d10)</p>
        <p class="muted">Start/end combat and advance rounds &amp; turns from the Combat Tracker.</p>
      </div>
    </div>
  </div>

  <div class="domains grid-3">
    {{#each domains as |d|}}
      <div class="domain domain-{{d.key}}">
        {{#each d.skills as |s|}}
          <div class="skill-box {{#unless s.gateOpen}}gated{{/unless}}">
            <div class="skill-head">
              <button type="button" class="skill-roll" data-action="rollSkill" data-skill="{{s.key}}">{{s.label}}</button>
              <span class="pip-track">
                {{#each s.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}
              </span>
            </div>
            {{#unless s.gateOpen}}<div class="gate-note"><i class="fa-solid fa-lock"></i> Requires {{s.gateDistinction}} Distinction</div>{{/unless}}
            <div class="skill-expertises">
              {{#each s.expertises as |e|}}
                <div class="expertise-row">
                  <select name="system.expertises.{{e.i}}.name">
                    <option value="">Expertise…</option>
                    {{#each ../expertiseOptions as |opt|}}
                      <option value="{{opt}}" {{#if (eq opt e.name)}}selected{{/if}}>{{opt}}</option>
                    {{/each}}
                  </select>
                  <a data-action="deleteArrayRow" data-array="expertises" data-index="{{e.i}}"><i class="fa-solid fa-trash"></i></a>
                </div>
              {{/each}}
              <button type="button" class="add-expertise" data-action="addExpertise" data-skill="{{s.key}}"><i class="fa-solid fa-plus"></i> Add Expertise</button>
            </div>
          </div>
        {{/each}}
      </div>
    {{/each}}
  </div>

  {{#if (or (gt system.prowess 0) (gt system.ballistics 0) (gt system.gestalt 0) (gt system.cunning 0) (gt system.magecraft 0) (gt system.psionics 0) (gt system.leadership 0) (gt system.ritualism 0) (gt system.calling 0))}}
    <h3 class="section-head">Specialties</h3>
    <div class="specialties">
      {{#if (gt system.prowess 0)}}
        <div class="specialty-row">
          <span class="attr-label" title="Whenever you inflict Damage with a Prowess Action/Reaction, gain 1 Combo (max 5). Each Combo adds 1 Movement. Lose 1 if you dealt no Damage this Turn, or whenever you suffer a non-Temporary Wound.">Combo (Prowess)</span>
          <span class="pip-track">
            {{#each comboPips as |filled i|}}<span class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleCombo" data-index="{{i}}"></span>{{/each}}
          </span>
        </div>
      {{/if}}
      {{#if (gt system.ballistics 0)}}
        <div class="specialty-row">
          <span class="attr-label" title="Burn 1 die when using a Ballistics Action against a target in your line of sight to establish Lock on it. Only one Lock at a time; lost if the target leaves your line of sight through the end of your Turn.">Lock (Ballistics)</span>
          <input type="text" name="system.specialties.lock" value="{{system.specialties.lock}}" placeholder="Locked creature…">
          <button type="button" data-action="clearLock">Clear</button>
        </div>
      {{/if}}
      {{#if (gt system.gestalt 0)}}
        <div class="specialty-row">
          <span class="attr-label" title="A Gestalt card's Rider may offer an Adaptation. You may maintain only one; pay its Stamina upkeep at the end of your Turn or it ends.">Adaptation (Gestalt)</span>
          <input type="text" name="system.specialties.adaptation.name" value="{{system.specialties.adaptation.name}}" placeholder="Adaptation name…">
          <label class="muted">Upkeep <input type="number" name="system.specialties.adaptation.upkeep" value="{{system.specialties.adaptation.upkeep}}" style="width:3em"></label>
          <button type="button" data-action="endAdaptation">End</button>
        </div>
      {{/if}}
      {{#if (gt system.cunning 0)}}
        <div class="specialty-row">
          <span class="attr-label" title="A Cunning card's Rider may establish a Contingency (a Trigger and an effect). Only one per Round; resolve it when the Trigger occurs. Expires at the start of your next Turn if unused.">Contingency (Cunning)</span>
          <input type="text" name="system.specialties.contingency" value="{{system.specialties.contingency}}" placeholder="Trigger → Effect…">
          <button type="button" data-action="clearContingency">Clear</button>
        </div>
      {{/if}}
      {{#if (gt system.magecraft 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" title="Every Magecraft Action creates the fixed Thread of its subtype. Maintain up to 3; consume them for later Magecraft effects. Unused Threads end when the Encounter ends.">Threads (Magecraft)</span>
          <div class="thread-chips">
            {{#each threadFamilies as |family|}}
              {{#each family.threads as |t|}}
                <button type="button" class="thread-chip {{#if t.active}}active{{/if}}" data-action="toggleThread" data-thread="{{t.name}}" title="{{family.label}}">{{t.name}}</button>
              {{/each}}
            {{/each}}
          </div>
        </div>
      {{/if}}
      {{#if (gt system.psionics 0)}}
        <div class="specialty-row">
          <span class="attr-label" title="Gain 1 Strain to gain 1 additional Surge on a Psionics Action/Reaction. 1-2: no penalty. 3-4: each Psionics Action/Reaction burns 1 additional die. 5+: suffer 1 Psychic damage after resolving one. Removed only by effects that specifically remove it, or Recovery.">Strain (Psionics)</span>
          <input type="number" name="system.specialties.strain" value="{{system.specialties.strain}}" style="width:3em" min="0">
        </div>
      {{/if}}
      {{#if (gt system.leadership 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" title="After a Leadership Action, store one rolled result as Authority (max: half Leadership Rank, rounded up). Spend it in place of a die you'd roll/burn, or for a card's Authority effect. Ends when the Encounter ends.">Authority (Leadership, max {{authorityCap}})</span>
          <div class="thread-chips">
            {{#each authorityEntries as |a|}}
              <button type="button" class="thread-chip active" data-action="removeAuthority" data-index="{{a.i}}" title="Click to spend/discard">{{a.value}}</button>
            {{/each}}
          </div>
          <button type="button" data-action="addAuthority">Store Authority</button>
        </div>
      {{/if}}
      {{#if (gt system.ritualism 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" title="A Ritualism card's Rider establishes a Rite (Trigger, Echo, Echo Limit). Maintain up to 3. When the Trigger occurs, resolve the Echo and reduce the Rite's remaining Echoes by 1; remove it after its final Echo.">Rites (Ritualism)</span>
          <div class="array-rows">
            {{#each riteEntries as |r|}}
              <div class="array-row">
                <input type="text" name="system.specialties.rites.{{r.i}}.trigger" value="{{r.trigger}}" placeholder="Trigger">
                <input type="text" name="system.specialties.rites.{{r.i}}.echo" value="{{r.echo}}" placeholder="Echo">
                <input type="number" name="system.specialties.rites.{{r.i}}.echoLimit" value="{{r.echoLimit}}" style="width:3em" min="1" title="Echo Limit">
                <a data-action="deleteRite" data-index="{{r.i}}"><i class="fa-solid fa-trash"></i></a>
              </div>
            {{/each}}
          </div>
          <button type="button" data-action="addRite">Add Rite</button>
        </div>
      {{/if}}
      {{#if (gt system.calling 0)}}
        <div class="specialty-row">
          <span class="attr-label" title="Full Manifestation replaces you on the battlefield with the manifestation's own combat profile and Wound Track (see its printed profile — not automated here). If the manifestation is defeated, you may become Broken, losing access to that manifestation family until the bond recovers.">Manifestation (Calling)</span>
          <label><input type="checkbox" name="system.specialties.manifested" {{#if system.specialties.manifested}}checked{{/if}}> Fully Manifested</label>
          <label><input type="checkbox" name="system.specialties.broken" {{#if system.specialties.broken}}checked{{/if}}> Broken</label>
        </div>
      {{/if}}
    </div>
  {{/if}}

  <h3 class="section-head">Action Cards</h3>
  <ul class="item-list">
    {{#each actionCards as |item|}}
      <li>
        <button type="button" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
        <a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
        <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a>
      </li>
    {{/each}}
  </ul>
  <h3 class="section-head">Reaction Cards</h3>
  <ul class="item-list">
    {{#each reactionCards as |item|}}
      <li>
        <button type="button" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
        <a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
        <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a>
      </li>
    {{/each}}
  </ul>
  <h3 class="section-head">Conditions</h3>
  <ul class="item-list condition-list">
    {{#each conditions as |item|}}
      <li class="condition-entry">
        <div class="condition-head">
          <strong>{{item.name}}</strong>
          <a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
          <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{#each item.system.sections as |s|}}
          <div class="condition-section"><span class="condition-label">{{s.label}}</span> {{{s.html}}}</div>
        {{/each}}
      </li>
    {{/each}}
  </ul>
</section>

{{!-- ============ EQUIPMENT: signature / temporary / armory ============ --}}
<section class="tab equipment" data-tab="equipment">
  <h3 class="section-head">Signature Equipment <span class="muted">(Limit {{system.signatureEquipmentLimit}})</span></h3>
  <table class="item-table">
    <thead><tr><th>#</th><th>Item</th><th>Category</th><th>Effect</th><th></th></tr></thead>
    <tbody>
      {{#each signatureEquipment as |item i|}}
        <tr>
          <td>{{i}}</td><td>{{item.name}}</td><td>{{item.category}}</td><td>{{item.effectText}}</td>
          <td><a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h3 class="section-head">Temporary Items</h3>
  <table class="item-table">
    <thead><tr><th>Item</th><th>Type</th><th>Effect</th><th></th></tr></thead>
    <tbody>
      {{#each temporaryEquipment as |item|}}
        <tr>
          <td>{{item.name}}</td><td>{{item.type}}</td><td>{{item.effectText}}</td>
          <td><a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <h3 class="section-head">Armory <span class="muted">(Limit {{system.armoryLimit}})</span></h3>
  <table class="item-table">
    <thead><tr><th>Item</th><th>Category</th><th>Notes</th><th></th></tr></thead>
    <tbody>
      {{#each armoryEquipment as |item|}}
        <tr>
          <td>{{item.name}}</td><td>{{item.category}}</td><td>{{item.effectText}}</td>
          <td><a data-action="itemEdit" data-item-id="{{item.id}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>

{{!-- ============ NON-COMBAT: career, skills, influence, features ============ --}}
<section class="tab noncombat" data-tab="noncombat">
  <h3 class="section-head">Career &amp; Key Aspects</h3>
  <div class="career-row">
    <label>Career <input name="system.career" type="text" value="{{system.career}}"></label>
  </div>
  <div class="key-aspects-row">
    {{#each keyAspects as |aspect|}}
      <label>Key Aspect {{aspect.n}}<input name="system.keyAspects.{{aspect.i}}" type="text" value="{{aspect.value}}"></label>
    {{/each}}
  </div>

  <h3 class="section-head">Non-Combat Skills</h3>
  <div class="noncombat-skills grid-2">
    {{#each system.nonCombatSkills as |s i|}}
      <div class="nc-skill-row">
        <input name="system.nonCombatSkills.{{i}}.name" type="text" value="{{s.name}}" placeholder="Skill">
        <input name="system.nonCombatSkills.{{i}}.rating" type="number" value="{{s.rating}}" style="width:3em">
        <a data-action="deleteArrayRow" data-array="nonCombatSkills" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{/each}}
  </div>
  <button type="button" data-action="addArrayRow" data-array="nonCombatSkills"><i class="fa-solid fa-plus"></i> Add Skill</button>

  <h3 class="section-head">Influence</h3>
  <div class="influence-row">
    <div class="wound-block">
      <span class="attr-label">Temporary Influence</span>
      <span class="pip-track">
        {{#each temporaryInfluencePips as |filled i|}}
          <span class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleTempInfluence" data-index="{{i}}"></span>
        {{/each}}
      </span>
    </div>
    <div class="wound-block">
      <span class="attr-label">Core Influence</span>
      <span class="pip-track">
        {{#each system.coreInfluence as |c i|}}
          <span class="pip toggle labeled {{#if c.filled}}filled{{/if}}" data-action="toggleCoreInfluence" data-index="{{i}}">{{lookup ../coreInfluenceLabels i}}</span>
        {{/each}}
      </span>
    </div>
  </div>

  <h3 class="section-head">General Features &amp; Benefits</h3>
  <table class="item-table">
    <thead><tr><th>Feature</th><th>Source</th><th>Description</th><th></th></tr></thead>
    <tbody>
      {{#each originFeatures as |f|}}
        <tr class="origin-feature-row" title="From this character's Species/Heritage/Distinction — edit it on that Item, not here.">
          <td>{{f.name}}</td>
          <td>{{f.source}}</td>
          <td>{{{f.text}}}</td>
          <td></td>
        </tr>
      {{/each}}
      {{#each system.passiveFeatures as |f i|}}
        <tr>
          <td><input name="system.passiveFeatures.{{i}}.name" type="text" value="{{f.name}}"></td>
          <td><input name="system.passiveFeatures.{{i}}.source" type="text" value="{{f.source}}"></td>
          <td>{{editor f.text target=(concat "system.passiveFeatures." i ".text") button=true}}</td>
          <td><a data-action="deleteArrayRow" data-array="passiveFeatures" data-index="{{i}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <button type="button" data-action="addArrayRow" data-array="passiveFeatures"><i class="fa-solid fa-plus"></i> Add Feature</button>
</section>

{{!-- ============ BIOGRAPHY ============ --}}
<section class="tab bio" data-tab="bio">
  <label>Concept<textarea name="system.concept">{{system.concept}}</textarea></label>
  <label>Appearance{{editor system.appearance target="system.appearance" button=true}}</label>
  <label>Personality{{editor system.personality target="system.personality" button=true}}</label>
  <label>Backstory{{editor system.backstory target="system.backstory" button=true}}</label>
  <label>General Notes<textarea name="system.playState.sessionNotes">{{system.playState.sessionNotes}}</textarea></label>
</section>
</div>
