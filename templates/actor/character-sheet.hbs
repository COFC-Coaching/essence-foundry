<div class="essence-sheet-root"{{#if sheetArt}} style="--essence-sheet-art: url('{{sheetArt}}')"{{/if}}>
<header class="sheet-header">
  <div class="portrait-wrap">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" data-tooltip-text="{{localize 'ESSENCE.Sheet.PortraitTooltip'}}">
    <button type="button" class="token-image-btn" data-action="editTokenImage" data-tooltip-text="{{localize 'ESSENCE.Sheet.TokenImageTooltip'}}" aria-label="{{localize 'ESSENCE.Sheet.TokenImageTooltip'}}"><i class="fa-solid fa-chess-pawn"></i></button>
  </div>
  <div class="header-main">
    <div class="header-actions">
      <button type="button" class="wizard-launch" data-action="openWizard" data-tooltip-text="{{localize 'ESSENCE.Character.WizardTooltip'}}"><i class="fa-solid fa-hat-wizard"></i> {{localize "ESSENCE.Character.Wizard"}}</button>
      {{#if isEditable}}
        <button type="button" class="edit-lock-btn" data-action="toggleEditLock" aria-pressed="{{editUnlocked}}" data-tooltip-text="{{#if editUnlocked}}{{localize 'ESSENCE.Sheet.UnlockedTooltip'}}{{else}}{{localize 'ESSENCE.Sheet.LockedTooltip'}}{{/if}}">
          <i class="fa-solid {{#if editUnlocked}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{#if editUnlocked}}{{localize "ESSENCE.Common.Unlocked"}}{{else}}{{localize "ESSENCE.Common.Locked"}}{{/if}}
        </button>
      {{/if}}
    </div>
    <h1><input name="name" type="text" value="{{actor.name}}"></h1>
    <div class="header-fields">
      <label>{{localize "ESSENCE.Item.SpeciesLabel"}} <input name="system.species" type="text" value="{{system.species}}"></label>
      <label>{{localize "ESSENCE.Item.HeritageLabel"}} <input name="system.heritage" type="text" value="{{system.heritage}}"></label>
      <label>{{localize "ESSENCE.Item.DistinctionLabel"}} <input name="system.distinction" type="text" value="{{system.distinction}}">{{#if secondDistinction}} <span class="muted" data-tooltip-text="{{localize 'ESSENCE.Character.SecondDistinctionHint'}}">+ {{secondDistinction.name}}</span>{{/if}}</label>
      <label>{{localize "ESSENCE.Common.Movement"}} <input class="w-4" name="system.movement" type="number" value="{{system.movement}}"> {{localize "ESSENCE.Common.Units"}}{{#if (ne system.totalMovement system.movement)}} <span class="muted">{{localize "ESSENCE.Character.EffectiveMovementNote" n=system.totalMovement}}</span>{{/if}}</label>
      <label data-tooltip-text="{{localize 'ESSENCE.Common.SizeHint'}}">{{localize "ESSENCE.Common.Size"}} <input class="w-3" name="system.size" type="number" min="0" max="5" value="{{system.size}}"></label>
    </div>
  </div>
</header>

{{!-- Foundry's own tab manager (ApplicationV2.TABS, 0.14.0): the strip is built from context.tabs
     and the built-in "tab" action switches the active section; nothing here is hand-wired. --}}
<nav class="sheet-tabs tabs" role="tablist" data-group="primary">
  {{#each tabs as |t|}}<a class="{{t.cssClass}}" data-action="tab" data-group="{{t.group}}" data-tab="{{t.id}}" role="tab" tabindex="0">{{localize t.label}}</a>{{/each}}
</nav>
<div class="sheet-scroll">

{{!-- ============ CORE: attributes, resistances, passive features, languages ============
     Resources, Defenses, Wounds and the Death Track moved to the vitals sidebar (0.15.0). --}}
<section class="tab core {{tabs.core.cssClass}}" data-group="primary" data-tab="core">
  <h3 class="section-head">{{localize "ESSENCE.Common.Attributes"}}</h3>
  <div class="domains grid-3">
    {{#each domains as |d|}}
      <div class="domain domain-{{d.key}}">
        <h4>{{d.label}}</h4>
        {{#each d.attrs as |a|}}
          <div class="attr-row">
            <span class="attr-label" {{#if a.benefit}}data-tooltip-text="{{a.benefit}}"{{/if}}>{{a.label}}</span>
            <button type="button" class="attr-roll" data-action="rollAttribute" data-attr="{{a.key}}" aria-label="{{localize 'ESSENCE.Sheet.RollAttributeAria' name=a.label}}" data-tooltip-text="{{localize 'ESSENCE.Sheet.RollAttributeAria' name=a.label}}"><i class="fa-solid fa-dice-d10"></i></button>
            <input class="attr-input" name="system.{{a.key}}" type="number" min="1" value="{{a.value}}">
            <span class="pip-track">
              {{#each a.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}
            </span>
          </div>
        {{/each}}
      </div>
    {{/each}}
    {{!-- Two over one, with Resistances and Vulnerabilities in the fourth cell (Shane, 0.18.13):
          a fixed two-column grid sized to its boxes, so nothing reflows as the sheet opens. --}}
    <div class="domain resist-box">
      {{!-- Senses (0.18.14): free text, like "Darkvision". A Species trait's Senses pick writes here
            too (EssenceActor#syncSpeciesSubChoices). --}}
      <div class="resist-group">
        <div class="resist-head">
          <span class="resist-label">{{localize "ESSENCE.Common.Senses"}}</span>
          <button type="button" class="resist-add" data-action="addSense"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "ESSENCE.Sheet.AddSense"}}</button>
        </div>
        <div class="resist-tags">
          {{#each system.senses as |sense i|}}
            <span class="tag">{{sense}}
              <button type="button" data-action="removeSense" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Sheet.RemoveSenseAria' name=sense}}"><i class="fa-solid fa-xmark"></i></button>
            </span>
          {{else}}<span class="muted">{{localize "ESSENCE.Common.None"}}</span>{{/each}}
        </div>
      </div>
      <div class="resist-group">
        <div class="resist-head">
          <span class="resist-label">{{localize "ESSENCE.Common.Resistances"}}</span>
          <button type="button" class="resist-add" data-action="addResistance"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "ESSENCE.Sheet.AddResistance"}}</button>
        </div>
        <div class="resist-tags">
          {{#each system.resistances as |r i|}}
            <span class="tag">{{r.damageType}}{{#if r.source}} ({{r.source}}){{/if}}
              <button type="button" data-action="removeResistance" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Sheet.RemoveResistance'}}"><i class="fa-solid fa-xmark"></i></button>
            </span>
          {{else}}<span class="muted">{{localize "ESSENCE.Common.None"}}</span>{{/each}}
        </div>
      </div>
      <div class="resist-group">
        <div class="resist-head">
          <span class="resist-label">{{localize "ESSENCE.Common.Vulnerabilities"}}</span>
          <button type="button" class="resist-add" data-action="addVulnerability"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "ESSENCE.Sheet.AddVulnerability"}}</button>
        </div>
        <div class="resist-tags">
          {{#each system.vulnerabilities as |r i|}}
            <span class="tag">{{r.damageType}}{{#if r.source}} ({{r.source}}){{/if}}
              <button type="button" data-action="removeVulnerability" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Sheet.RemoveVulnerability'}}"><i class="fa-solid fa-xmark"></i></button>
            </span>
          {{else}}<span class="muted">{{localize "ESSENCE.Common.None"}}</span>{{/each}}
        </div>
      </div>
    </div>
  </div>

  {{!-- Passive Features and Languages, moved here from the Non-Combat tab (0.15.0). --}}
  <h3 class="section-head">{{localize "ESSENCE.Character.GeneralFeaturesBenefits"}}</h3>
  <table class="item-table">
    <thead><tr><th>{{localize "ESSENCE.Character.Feature"}}</th><th>{{localize "ESSENCE.Common.Source"}}</th><th>{{localize "ESSENCE.Common.Description"}}</th><th></th></tr></thead>
    <tbody>
      {{#each originFeatures as |f|}}
        <tr class="origin-feature-row" data-tooltip-text="{{localize 'ESSENCE.Character.OriginFeatureTooltip'}}">
          <td>{{f.name}}</td>
          <td>{{f.source}}</td>
          <td>{{{f.text}}}</td>
          <td></td>
        </tr>
      {{/each}}
      {{#each system.passiveFeatures as |f i|}}
        <tr>
          <td><input name="system.passiveFeatures.{{i}}.name" type="text" value="{{f.name}}"></td>
          <td><input name="system.passiveFeatures.{{i}}.source" type="text" value="{{f.source}}"></td>
          <td>{{essenceEditor f.text target=(concat "system.passiveFeatures." i ".text") button=true}}</td>
          <td><button type="button" data-action="deleteArrayRow" data-array="passiveFeatures" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Character.DeleteFeatureAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <button type="button" data-action="addArrayRow" data-array="passiveFeatures"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Character.AddFeature"}}</button>

  <div class="career-row">
    <label data-tooltip-text="{{localize 'ESSENCE.Character.LanguagesHint' n=system.languageCount}}">{{localize "ESSENCE.Character.Languages"}} <input name="system.languages" type="text" value="{{system.languages}}" placeholder="{{localize 'ESSENCE.Character.LanguagesPlaceholder'}}"> <span class="muted">{{localize "ESSENCE.Character.LanguagesAllowance" n=system.languageCount acuity=system.acuity}}</span></label>
  </div>
</section>

{{!-- ============ COMBAT: skills, cards, dice lifecycle ============ --}}
<section class="tab combat {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
  {{!-- The Action and Reaction dice pools moved to the vitals sidebar (0.15.0); the header keeps
       the Turn controls and state. --}}
  <div class="combat-header">
    <div class="combat-header-right">
      <div class="combat-controls">
        <button type="button" data-action="rollInitiative">{{localize "ESSENCE.Sheet.RollInitiative"}}</button>
        <button type="button" data-action="endTurn">{{localize "ESSENCE.Sheet.EndTurn"}}</button>
      </div>
      {{#if preparedAction}}
        <div class="combat-state prepared-action" data-tooltip-text="{{localize 'ESSENCE.Sheet.PrepareNote'}}">
          <p><strong>{{localize "ESSENCE.Sheet.PreparedAction"}}:</strong> {{localize "ESSENCE.Sheet.PreparedSummary" name=preparedAction.cardName reserved=preparedAction.reserved trigger=preparedAction.trigger}}
            <button type="button" data-action="firePreparedAction">{{localize "ESSENCE.Sheet.PreparedFire"}}</button>
            <button type="button" data-action="cancelPreparedAction">{{localize "ESSENCE.Sheet.PreparedCancel"}}</button>
          </p>
        </div>
      {{/if}}
      <div class="combat-state">
        <p>{{#if combatRound}}{{localize "ESSENCE.Sheet.RoundLabel" round=combatRound}} — {{/if}}{{turnLabel system.playState.combatTurn}}{{#if system.playState.initiativeCommitted}} — {{localize "ESSENCE.Character.InitiativeLabel" total=system.playState.initiativeTotal dice=system.playState.initiativeDice}}{{/if}}</p>
      </div>
    </div>
  </div>

  <div class="domains grid-3">
    {{#each domains as |d|}}
      <div class="domain domain-{{d.key}}">
        {{#each d.skills as |s|}}
          <div class="skill-box {{#unless s.gateOpen}}gated{{/unless}}">
            <div class="skill-head">
              <span class="skill-name">{{s.label}}</span>
              <button type="button" data-action="rollSkill" data-skill="{{s.key}}" aria-label="{{localize 'ESSENCE.Character.RollSkillAria' name=s.label}}" data-tooltip-text="{{localize 'ESSENCE.Character.RollSkillAria' name=s.label}}"><i class="fa-solid fa-dice-d10"></i></button>
              <span class="pip-track">
                {{#each s.pips as |filled|}}<span class="pip {{#if filled}}filled{{/if}}"></span>{{/each}}
              </span>
            </div>
            {{#unless s.gateOpen}}<div class="gate-note"><i class="fa-solid fa-lock"></i> {{localize "ESSENCE.Sheet.RequiresDistinction" name=s.gateDistinction}}</div>{{/unless}}
            <div class="skill-expertises">
              {{#each s.expertises as |e|}}
                <div class="expertise-row">
                  <select class="expertise-name-select" data-index="{{e.i}}">
                    <option value="">{{localize "ESSENCE.Character.ExpertiseEllipsis"}}</option>
                    {{#each ../expertiseOptions as |opt|}}
                      <option value="{{opt}}" {{#if (eq opt e.name)}}selected{{/if}}>{{opt}}</option>
                    {{/each}}
                  </select>
                  <button type="button" data-action="deleteArrayRow" data-array="expertises" data-index="{{e.i}}" aria-label="{{localize 'ESSENCE.Character.DeleteExpertiseAria' n=(addOne e.i)}}"><i class="fa-solid fa-trash"></i></button>
                </div>
              {{/each}}
              <button type="button" class="add-expertise" data-action="addExpertise" data-skill="{{s.key}}"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Character.AddExpertise"}}</button>
            </div>
          </div>
        {{/each}}
      </div>
    {{/each}}
  </div>

  {{#if (or (gt system.prowess 0) (gt system.ballistics 0) (gt system.gestalt 0) (gt system.cunning 0) (gt system.magecraft 0) (gt system.psionics 0) (gt system.leadership 0) (gt system.ritualism 0) (gt system.calling 0))}}
    <h3 class="section-head">{{localize "ESSENCE.Character.Specialties"}}</h3>
    <div class="specialties">
      {{#if (gt system.prowess 0)}}
        <div class="specialty-row">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.ComboTooltip'}}">{{localize "ESSENCE.Character.ComboLabel"}}</span>
          <span class="pip-track">
            {{#each comboPips as |filled i|}}<button type="button" class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleCombo" data-index="{{i}}" aria-pressed="{{filled}}" aria-label="{{localize 'ESSENCE.Character.ComboAria' n=(addOne i)}}"></button>{{/each}}
          </span>
          <label class="muted" data-tooltip-text="{{localize 'ESSENCE.Character.ComboDealtDamageHint'}}"><input type="checkbox" name="system.specialties.comboDealtDamage" {{#if system.specialties.comboDealtDamage}}checked{{/if}}> {{localize "ESSENCE.Character.ComboDealtDamage"}}</label>
        </div>
      {{/if}}
      {{#if (gt system.ballistics 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.LockTooltip'}}">{{localize "ESSENCE.Character.LockLabel" max=lockCap}}</span>
          <div class="thread-chips">
            {{#each lockEntries as |l|}}
              <button type="button" class="thread-chip active" data-action="removeLock" data-index="{{l.i}}" data-tooltip-text="{{localize 'ESSENCE.Character.LockEndHint'}}">{{l.name}}</button>
            {{/each}}
          </div>
          <button type="button" data-action="addLock">{{localize "ESSENCE.Character.EstablishLock"}}</button>
        </div>
      {{/if}}
      {{#if (gt system.gestalt 0)}}
        <div class="specialty-row">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.AdaptationTooltip'}}">{{localize "ESSENCE.Character.AdaptationLabel"}}</span>
          <input type="text" name="system.specialties.adaptation.name" value="{{system.specialties.adaptation.name}}" placeholder="{{localize 'ESSENCE.Character.AdaptationNamePlaceholder'}}">
          <label class="muted">{{localize "ESSENCE.Character.Upkeep"}} <input class="w-3" type="number" name="system.specialties.adaptation.upkeep" value="{{system.specialties.adaptation.upkeep}}" min="0"></label>
          {{#if system.specialties.adaptation.name}}<span class="muted" data-tooltip-text="{{localize 'ESSENCE.Character.UpkeepDueHint'}}">{{localize "ESSENCE.Character.UpkeepDue" n=adaptationDue}}</span>{{/if}}
          <label class="muted" data-tooltip-text="{{localize 'ESSENCE.Character.DeferUpkeepHint'}}"><input type="checkbox" name="system.specialties.adaptation.deferUpkeep" {{#if system.specialties.adaptation.deferUpkeep}}checked{{/if}}> {{localize "ESSENCE.Character.DeferUpkeep"}}</label>
          <button type="button" data-action="endAdaptation">{{localize "ESSENCE.Common.End"}}</button>
        </div>
      {{/if}}
      {{#if (gt system.cunning 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.ContingencyTooltip'}}">{{localize "ESSENCE.Character.ContingencyLabel" max=contingencyCap}}</span>
          <div class="array-rows">
            {{#each contingencyEntries as |c|}}
              <div class="array-row">
                <input type="text" name="system.specialties.contingencies.{{c.i}}" value="{{c.text}}" placeholder="{{localize 'ESSENCE.Character.ContingencyPlaceholder'}}">
                <button type="button" data-action="triggerContingency" data-index="{{c.i}}" data-tooltip-text="{{localize 'ESSENCE.Character.TriggerContingencyHint'}}">{{localize "ESSENCE.Character.TriggerContingency"}}</button>
                <button type="button" data-action="removeContingency" data-index="{{c.i}}" data-tooltip-text="{{localize 'ESSENCE.Common.Clear'}}" aria-label="{{localize 'ESSENCE.Common.Clear'}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            {{/each}}
          </div>
          <button type="button" data-action="addContingency">{{localize "ESSENCE.Character.EstablishContingency"}}</button>
          {{#if system.specialties.contingencyTriggered}}<span class="muted">{{localize "ESSENCE.Character.ContingencyTriggeredThisRound"}}</span>{{/if}}
        </div>
      {{/if}}
      {{#if (gt system.magecraft 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.ThreadsTooltip'}}">{{localize "ESSENCE.Character.ThreadsLabel" n=system.specialties.threads.length}}</span>
          <div class="thread-chips">
            {{#each threadFamilies as |family|}}
              {{#each family.threads as |t|}}
                <button type="button" class="thread-chip {{#if t.active}}active{{/if}}" data-action="addThread" data-thread="{{t.name}}" data-tooltip-text="{{t.title}}">{{t.name}}{{#if (gt t.count 1)}} ×{{t.count}}{{/if}}</button>
              {{/each}}
            {{/each}}
          </div>
          {{#if activeThreads.length}}
            <ul class="active-thread-effects muted">
              {{#each activeThreads as |t|}}
                <li><button type="button" class="thread-chip active" data-action="consumeThread" data-index="{{t.i}}" data-tooltip-text="{{localize 'ESSENCE.Character.ConsumeThreadHint'}}">{{t.name}} <i class="fa-solid fa-xmark"></i></button> {{t.effect}}</li>
              {{/each}}
            </ul>
          {{/if}}
        </div>
      {{/if}}
      {{#if (gt system.psionics 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.StrainTooltip'}}">{{localize "ESSENCE.Character.StrainLabel"}}</span>
          <input class="w-3" type="number" name="system.specialties.strain" value="{{system.specialties.strain}}" min="0" max="6">
          <button type="button" data-action="ventStrain" data-tooltip-text="{{localize 'ESSENCE.Character.VentStrainHint'}}">{{localize "ESSENCE.Character.VentStrain"}}</button>
          <button type="button" data-action="forceStrain" data-tooltip-text="{{localize 'ESSENCE.Character.ForceStrainHint'}}">{{localize "ESSENCE.Character.ForceStrain"}}</button>
          {{#if system.psionicsBurnSurcharge}}
            <span class="muted strain-burn-surcharge" data-tooltip-text="{{localize 'ESSENCE.Character.StrainBurnSurcharge'}}">{{localize "ESSENCE.Character.StrainBurnSurcharge"}}</span>
          {{/if}}
          {{#if system.specialties.strainVented}}<span class="muted">{{localize "ESSENCE.Character.StrainVentedNote"}}</span>{{/if}}
        </div>
      {{/if}}
      {{#if (gt system.leadership 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.AuthorityTooltip'}}">{{localize "ESSENCE.Character.AuthorityLabel" max=authorityCap}}</span>
          <div class="array-rows">
            {{#each authorityEntries as |a|}}
              <div class="array-row">
                <span class="muted">{{#if a.card}}{{a.card}}{{else}}{{localize "ESSENCE.Character.AuthorityUnnamedCard"}}{{/if}}:</span>
                <div class="thread-chips">
                  {{#each a.results as |r|}}
                    <button type="button" class="thread-chip active" data-action="spendAuthority" data-card="{{a.i}}" data-index="{{r.i}}" data-tooltip-text="{{localize 'ESSENCE.Character.ClickToSpendDiscard'}}">{{r.value}}</button>
                  {{/each}}
                </div>
              </div>
            {{/each}}
          </div>
          <button type="button" data-action="addAuthority">{{localize "ESSENCE.Character.StoreAuthority"}}</button>
          {{#if orator}}<span class="muted">{{localize "ESSENCE.Character.OratorNote"}}</span>{{/if}}
        </div>
      {{/if}}
      {{#if (gt system.ritualism 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.RitesTooltip'}}">{{localize "ESSENCE.Character.RitesLabel" max=riteCap}}</span>
          <div class="array-rows">
            {{#each riteEntries as |r|}}
              <div class="array-row">
                <input type="text" name="system.specialties.rites.{{r.i}}.name" value="{{r.name}}" placeholder="{{localize 'ESSENCE.Character.RiteName'}}" class="w-max-9">
                <input type="text" name="system.specialties.rites.{{r.i}}.trigger" value="{{r.trigger}}" placeholder="{{localize 'ESSENCE.Character.Trigger'}}">
                <input type="text" name="system.specialties.rites.{{r.i}}.echo" value="{{r.echo}}" placeholder="{{localize 'ESSENCE.Character.Echo'}}">
                <input class="w-3" type="number" name="system.specialties.rites.{{r.i}}.echoLimit" value="{{r.echoLimit}}" min="1" data-tooltip-text="{{localize 'ESSENCE.Character.EchoLimit'}}">
                <input type="text" name="system.specialties.rites.{{r.i}}.subject" value="{{r.subject}}" placeholder="{{localize 'ESSENCE.Character.PossessedSubject'}}" class="w-max-9" data-tooltip-text="{{localize 'ESSENCE.Character.PossessedHint'}}">
                <button type="button" data-action="echoRite" data-index="{{r.i}}" data-tooltip-text="{{localize 'ESSENCE.Character.EchoRiteHint'}}">{{localize "ESSENCE.Character.EchoRite"}}</button>
                <button type="button" data-action="deleteRite" data-index="{{r.i}}" data-tooltip-text="{{localize 'ESSENCE.Character.RemoveRiteHint'}}" aria-label="{{localize 'ESSENCE.Character.RemoveRiteHint'}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            {{/each}}
          </div>
          <button type="button" data-action="addRite">{{localize "ESSENCE.Character.AddRite"}}</button>
          {{#if invoker}}<span class="muted">{{localize "ESSENCE.Character.InvokerNote"}}{{#if system.specialties.finalEchoUsed}} {{localize "ESSENCE.Character.FinalEchoUsed"}}{{/if}}</span>{{/if}}
        </div>
      {{/if}}
      {{#if (gt system.calling 0)}}
        <div class="specialty-row specialty-row-wrap">
          <span class="attr-label" data-tooltip-text="{{localize 'ESSENCE.Character.ManifestationTooltip'}}">{{localize "ESSENCE.Character.ManifestationLabel"}}</span>
          <span class="pip-track" data-tooltip-text="{{localize 'ESSENCE.Character.ManifestationTrackHint'}}">
            {{#each manifestationPips as |filled i|}}<button type="button" class="pip toggle {{#if filled}}filled{{/if}}" data-action="toggleManifestationWound" data-index="{{i}}" aria-pressed="{{filled}}" aria-label="{{localize 'ESSENCE.Character.ManifestationWoundAria' n=(addOne i)}}"></button>{{/each}}
          </span>
          {{#if system.specialties.activeManifestation}}
            <span>{{localize "ESSENCE.Character.FullyManifested"}}: <strong>{{system.specialties.activeManifestation}}</strong></span>
          {{else if callerBroken}}
            <span class="muted"><strong>{{localize "ESSENCE.Character.Broken"}}</strong>: {{localize "ESSENCE.Character.BrokenHint"}}</span>
          {{else}}
            <span class="muted">{{localize "ESSENCE.Character.NotManifested"}}</span>
          {{/if}}
        </div>
      {{/if}}
    </div>
  {{/if}}

  <input type="text" data-card-filter aria-label="{{localize 'ESSENCE.Sheet.SearchCardsPlaceholder'}}" placeholder="{{localize 'ESSENCE.Sheet.SearchCardsPlaceholder'}}" class="card-filter-input">

  <h3 class="section-head">{{localize "ESSENCE.Sheet.BasicActions"}}</h3>
  <div class="basic-action-grid">
    {{#each basicActionCards as |item|}}
      <button type="button" class="basic-action-btn" data-action="rollItem" data-item-id="{{item.id}}">{{item.name}}</button>
    {{else}}
      <span class="muted">{{localize "ESSENCE.Sheet.NoBasicActions"}}</span>
