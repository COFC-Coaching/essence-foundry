<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}" style="font-size: {{fitTitleSize item.name max=24 min=14 startAt=12}}px" {{#if viewMode}}disabled{{/if}}></h1>
  <button type="button" class="card-view-toggle equipment-view-toggle" data-action="toggleCardView" title="{{#if viewMode}}{{localize 'ESSENCE.Common.EditThisItem'}}{{else}}{{localize 'ESSENCE.Common.ViewThisItem'}}{{/if}}">
    <i class="fa-solid {{#if viewMode}}fa-pen{{else}}fa-eye{{/if}}"></i> {{#if viewMode}}{{localize "ESSENCE.Common.Edit"}}{{else}}{{localize "ESSENCE.Common.View"}}{{/if}}
  </button>
</header>

{{#if viewMode}}
<div class="card-view equipment-view">
  <div class="card-view-infogrid">
    <div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Category"}}</span><span>{{equipmentCategoryLabel system.category}}</span></div>
    {{#if item.actor}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Slot"}}</span><span>{{capitalize system.slot}}</span></div>{{/if}}
    {{#if system.tier}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Tier"}}</span><span>{{system.tier}}</span></div>{{/if}}
    {{#if system.cost}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Item.Equipment.Reach"}}</span><span>{{system.cost}}</span></div>{{/if}}
    {{#if isWornCategory}}
      {{#if stats.fortitude}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Fortitude"}}</span><span>{{stats.fortitude}}</span></div>{{/if}}
      {{#if stats.resilience}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Resilience"}}</span><span>{{stats.resilience}}</span></div>{{/if}}
      {{#if stats.movement}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Movement"}}</span><span>{{stats.movement}}</span></div>{{/if}}
    {{/if}}
    {{#if isGear}}
      {{#if system.uses}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Uses"}}</span><span>{{system.uses}}</span></div>{{/if}}
    {{/if}}
    {{#if item.actor}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Quantity"}}</span><span>{{system.quantity}}</span></div>{{/if}}
  </div>
  {{#if system.tags}}<div class="card-view-tags muted">{{system.tags}}</div>{{/if}}

  {{#if isConsumableKit}}
    {{#if system.equipmentCards.length}}
      <div class="card-view-line">
        <div class="card-view-label">{{localize "ESSENCE.Item.Equipment.EquipmentCards"}}</div>
        <ul>
          {{#each system.equipmentCards as |c|}}
            <li><strong>{{c.name}}</strong>{{#if c.uses}} ({{localize "ESSENCE.Common.UsesFraction" remaining=c.usesRemaining total=c.uses}}){{/if}} — {{{c.effect}}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}
  {{/if}}

  {{#if stats.combinedEffect.length}}
    <div class="card-view-line">
      <div class="card-view-label">{{localize "ESSENCE.Item.Equipment.CombinedEffect"}}</div>
      <ul>
        {{#each stats.combinedEffect as |ce|}}
          <li><strong>{{ce.source}}</strong> — {{{ce.html}}}</li>
        {{/each}}
      </ul>
    </div>
  {{/if}}
  {{#if system.effect}}
    <div class="card-view-line">
      <div class="card-view-label">{{localize "ESSENCE.Common.Effect"}}</div>
      <div class="card-view-text">{{{system.effect}}}</div>
    </div>
  {{/if}}
  {{#if system.passive}}
    <div class="card-view-line">
      <div class="card-view-label">{{localize "ESSENCE.Common.Passive"}}</div>
      <div class="card-view-text">{{{system.passive}}}</div>
    </div>
  {{/if}}
  {{#if system.special}}
    <div class="card-view-line">
      <div class="card-view-label">{{localize "ESSENCE.Common.Special"}}</div>
      <div class="card-view-text">{{{system.special}}}</div>
    </div>
  {{/if}}

  {{#if system.flavor}}<div class="card-view-flavor">{{{system.flavor}}}</div>{{/if}}
</div>
{{else}}

<div class="equipment-fields grid-3">
  <label>{{localize "ESSENCE.Common.Category"}}
    <select name="system.category">
      {{#each categoryOptions as |opt|}}
        <option value="{{opt.value}}" {{#if (eq ../system.category opt.value)}}selected{{/if}}>{{opt.label}}</option>
      {{/each}}
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Tier"}} <input name="system.tier" type="number" value="{{system.tier}}"></label>
  <label>{{localize "ESSENCE.Item.Equipment.Reach"}} <input name="system.cost" type="text" value="{{system.cost}}"></label>
  {{#if item.actor}}
    <label>{{localize "ESSENCE.Common.Slot"}}
      <select name="system.slot">
        <option value="inventory" {{#if (eq system.slot "inventory")}}selected{{/if}}>{{localize "ESSENCE.Item.Equipment.Inventory"}}</option>
        <option value="temporary" {{#if (eq system.slot "temporary")}}selected{{/if}}>{{localize "ESSENCE.Item.Equipment.Temporary"}}</option>
        <option value="armory" {{#if (eq system.slot "armory")}}selected{{/if}}>{{localize "ESSENCE.Item.Equipment.Armory"}}</option>
      </select>
    </label>
    <label>{{localize "ESSENCE.Common.Quantity"}} <input name="system.quantity" type="number" value="{{system.quantity}}"></label>
  {{/if}}
</div>

{{#if isWornCategory}}
  <p class="muted">{{localize "ESSENCE.Item.Equipment.AlwaysModularHint"}}</p>
{{/if}}

{{#if isGear}}
  <div class="equipment-fields grid-3">
    <label>{{localize "ESSENCE.Common.Uses"}} <input name="system.uses" type="number" value="{{system.uses}}" placeholder="{{localize 'ESSENCE.Common.LeaveBlankUnlimited'}}"></label>
  </div>
{{/if}}

{{#if isConsumableKit}}
<h3 class="section-head">{{localize "ESSENCE.Item.Equipment.EquipmentCards"}} <span class="muted">{{localize "ESSENCE.Item.Equipment.UsesRefreshHint"}}</span></h3>
<ol class="equipment-cards">
  {{#each system.equipmentCards as |c i|}}
    <li class="equipment-card-row">
      <div class="equipment-fields grid-3">
        <label>{{localize "ESSENCE.Common.Name"}} <input data-array="equipmentCards" data-index="{{i}}" data-field="name" type="text" value="{{c.name}}"></label>
        <label>{{localize "ESSENCE.Common.Uses"}} <input data-array="equipmentCards" data-index="{{i}}" data-field="uses" type="number" value="{{c.uses}}" placeholder="{{localize 'ESSENCE.Common.LeaveBlankUnlimited'}}"></label>
        <label>{{localize "ESSENCE.Item.Equipment.UsesRemaining"}} <input data-array="equipmentCards" data-index="{{i}}" data-field="usesRemaining" type="number" value="{{c.usesRemaining}}"></label>
      </div>
      <label>{{localize "ESSENCE.Common.Effect"}} <textarea data-array="equipmentCards" data-index="{{i}}" data-field="effect">{{c.effect}}</textarea></label>
      <button type="button" data-action="deleteEquipmentCard" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Common.DeleteAria' name=c.name}}"><i class="fa-solid fa-trash"></i></button>
    </li>
  {{/each}}
</ol>
<button type="button" data-action="addEquipmentCard"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Equipment.AddEquipmentCard"}}</button>
{{/if}}

{{#if isWornCategory}}
  <h3 class="section-head">{{localize "ESSENCE.Item.Equipment.ModularAssembly"}}</h3>
    <div class="equipment-fields grid-2">
      <label>{{chassisLabel}}
        <select class="chassis-select">
          <option value="">— {{localize "ESSENCE.Common.None"}} —</option>
          {{#each chassisOptions as |c|}}
            <option value="{{c.id}}" {{#if (eq c.id ../system.chassisItemId)}}selected{{/if}}>{{c.name}} (T{{c.tier}}){{#if c.fromCatalog}} — {{localize "ESSENCE.Item.Equipment.FromCatalog"}}{{/if}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{fittingLabel}}
        <select class="fitting-select">
          <option value="">— {{localize "ESSENCE.Common.None"}} —</option>
          {{#each fittingOptions as |f|}}
            <option value="{{f.id}}" {{#if (eq f.id ../system.fittingItemId)}}selected{{/if}}>{{f.name}} (T{{f.tier}}){{#if f.fromCatalog}} — {{localize "ESSENCE.Item.Equipment.FromCatalog"}}{{/if}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    {{#unless chassisOptions.length}}
      <p class="muted">{{localize "ESSENCE.Item.Equipment.NoComponentOptions" label=chassisLabel}}</p>
    {{/unless}}
    {{#unless fittingOptions.length}}
      <p class="muted">{{localize "ESSENCE.Item.Equipment.NoComponentOptions" label=fittingLabel}}</p>
    {{/unless}}
    {{#if item.actor}}
      <p class="muted">{{localize "ESSENCE.Item.Equipment.AssignFreeHint" chassisLabel=chassisLabel fittingLabel=fittingLabel}}</p>
      <p class="muted">{{localize "ESSENCE.Item.Equipment.CatalogCopyHint"}}</p>
      {{#with (fittingReconfigureCost stats.fitting) as |rc|}}
      <button type="button" data-action="reconfigureFittingCost"><i class="fa-solid fa-dice"></i> {{localize "ESSENCE.Common.Pay"}} {{fittingLabel}} {{localize "ESSENCE.Item.Component.Reconfigure"}} {{localize "ESSENCE.Item.Equipment.CostSuffix"}} ({{rc.cost}} {{#if (eq rc.cost 1)}}{{localize "ESSENCE.Item.Equipment.ActionDie"}}{{else}}{{localize "ESSENCE.Item.Equipment.ActionDice"}}{{/if}}){{#if rc.outOfCombatOnly}} <span class="muted">{{localize "ESSENCE.Item.Component.ReconfigureStructural"}}</span>{{/if}}</button>
      {{/with}}
    {{else}}
      <p class="muted">{{localize "ESSENCE.Item.Equipment.TemplateAssignHint" chassisLabel=chassisLabel fittingLabel=fittingLabel}}</p>
    {{/if}}

    {{#if stats.chassis}}
      <h4>{{localize "ESSENCE.Item.Equipment.DerivedFrom" chassisLabel=chassisLabel fittingLabel=fittingLabel}}</h4>
      <p>{{localize "ESSENCE.Common.Fortitude"}} {{stats.fortitude}} · {{localize "ESSENCE.Common.Resilience"}} {{stats.resilience}} · {{localize "ESSENCE.Common.Movement"}} {{stats.movement}}</p>

      {{#if stats.combinedEffect.length}}
        <h4>{{localize "ESSENCE.Item.Equipment.CombinedEffect"}}</h4>
        <ul>
          {{#each stats.combinedEffect as |ce|}}
            <li><strong>{{ce.source}}</strong> — {{{ce.html}}}</li>
          {{/each}}
        </ul>
      {{/if}}

      <h4>{{localize "ESSENCE.Item.Component.AugmentMounts"}}</h4>
      <ol class="mounts">
        {{#each stats.mountDisplay as |m|}}
          <li>
            <span class="mount-index">{{localize "ESSENCE.Item.Component.Mount" n=(addOne m.index)}}{{#if m.isLinked}} ({{localize "ESSENCE.Item.Component.LinkedWithMount" n=(addOne m.linkedWith)}}){{/if}}</span>
            <label>{{localize "ESSENCE.Item.Equipment.Augment"}}
              <select class="mount-augment-select" data-mount-index="{{m.index}}">
                <option value="">— {{localize "ESSENCE.Common.Empty"}} —</option>
                {{#each ../augmentOptions as |a|}}
                  <option value="{{a.id}}" {{#if (eq a.id m.augment.id)}}selected{{/if}}>{{a.name}} ({{a.kind}}){{#if a.fromCatalog}} — {{localize "ESSENCE.Item.Equipment.FromCatalog"}}{{/if}}</option>
                {{/each}}
              </select>
            </label>
            {{#if m.isLinked}}
              <button type="button" data-action="toggleMountLink" data-mount-index="{{m.index}}">
                {{localize "ESSENCE.Item.Equipment.Link"}} {{#if m.linkOn}}{{localize "ESSENCE.Common.On"}}{{else}}{{localize "ESSENCE.Common.Off"}}{{/if}}
              </button>
            {{/if}}
            {{#if ../item.actor}}
              <button type="button" data-action="swapAugmentCost"><i class="fa-solid fa-dice"></i> {{localize "ESSENCE.Item.Equipment.PayAugmentSwapCost"}}</button>
            {{/if}}
          </li>
        {{/each}}
      </ol>

      {{#if stats.grantedCards.length}}
        <h4>{{localize "ESSENCE.Item.Equipment.GrantedEquipmentCards"}}</h4>
        <ul>
          {{#each stats.grantedCards as |g|}}
            <li><strong>{{g.source}}</strong>{{#if g.uses}} ({{localize "ESSENCE.Common.UsesFraction" remaining=g.usesRemaining total=g.uses}}){{/if}} — {{{g.effect}}}</li>
          {{/each}}
        </ul>
      {{/if}}
    {{/if}}
  {{/if}}
<h3 class="section-head">{{localize "ESSENCE.Common.Effect"}}</h3>
<div>{{essenceEditor system.effect target="system.effect" button=true}}</div>
<h3 class="section-head">{{localize "ESSENCE.Common.Passive"}}</h3>
<div>{{essenceEditor system.passive target="system.passive" button=true}}</div>
<h3 class="section-head">{{localize "ESSENCE.Common.Special"}}</h3>
<div>{{essenceEditor system.special target="system.special" button=true}}</div>
<h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
<div>{{essenceEditor system.flavor target="system.flavor" button=true}}</div>
<label>{{localize "ESSENCE.Common.Tags"}} <input name="system.tags" type="text" value="{{system.tags}}"></label>

<details class="advanced-section">
  <summary>{{localize "ESSENCE.Item.Equipment.AdvancedReachException"}}</summary>
  <p class="muted">{{localize "ESSENCE.Item.Equipment.ReachExceptionHint"}}</p>
  <div class="equipment-fields grid-3">
    <label>{{localize "ESSENCE.Item.Equipment.ExceptionSource"}} <input name="system.reachExceptionSource" type="text" value="{{system.reachExceptionSource}}" placeholder="e.g. Quartermaster's Due"></label>
    <label>{{localize "ESSENCE.Item.Equipment.AllowedMargin"}} <input name="system.reachExceptionMargin" type="number" value="{{system.reachExceptionMargin}}" min="0"></label>
  </div>
</details>
{{/if}}
</div>
