<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}"></h1>
</header>

<div class="card-fields grid-3">
  <label>Key Combat Skill <input name="system.keyCombatSkill" type="text" value="{{system.keyCombatSkill}}"></label>
  <label>Primary Attribute <input name="system.primaryAttr" type="text" value="{{system.primaryAttr}}"></label>
  <label>Unlocks Skill <input name="system.unlocks" type="text" value="{{system.unlocks}}" placeholder="e.g. magecraft (blank if none)"></label>
</div>

<h3>Description</h3>
<div>{{essenceEditor system.description target="system.description" button=true}}</div>

<h3>Benefit</h3>
<div>{{essenceEditor system.benefit target="system.benefit" button=true}}</div>

<h3>Origin Benefit</h3>
<input name="system.origin.name" type="text" value="{{system.origin.name}}" placeholder="Origin benefit name">
<div>{{essenceEditor system.origin.text target="system.origin.text" button=true}}</div>
</div>
