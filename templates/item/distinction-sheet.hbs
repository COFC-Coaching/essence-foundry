<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}"></h1>
</header>

<div class="card-fields grid-3">
  <label>{{localize "ESSENCE.Item.Distinction.KeyCombatSkill"}} <input name="system.keyCombatSkill" type="text" value="{{system.keyCombatSkill}}"></label>
  <label>{{localize "ESSENCE.Item.Distinction.PrimaryAttribute"}} <input name="system.primaryAttr" type="text" value="{{system.primaryAttr}}"></label>
  <label>{{localize "ESSENCE.Item.Distinction.UnlocksSkill"}} <input name="system.unlocks" type="text" value="{{system.unlocks}}" placeholder="{{localize 'ESSENCE.Item.Distinction.UnlocksSkillPlaceholder'}}"></label>
</div>

<h3 class="section-head">{{localize "ESSENCE.Common.Description"}}</h3>
<div>{{essenceEditor system.description target="system.description" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Distinction.Benefit"}}</h3>
<div>{{essenceEditor system.benefit target="system.benefit" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Distinction.OriginBenefit"}}</h3>
<input name="system.origin.name" type="text" value="{{system.origin.name}}" placeholder="{{localize 'ESSENCE.Item.Distinction.OriginBenefitNamePlaceholder'}}">
<div>{{essenceEditor system.origin.text target="system.origin.text" button=true}}</div>
</div>
