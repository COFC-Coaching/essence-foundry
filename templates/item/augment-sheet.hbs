<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}" {{#if viewMode}}disabled{{/if}}></h1>
  <button type="button" class="card-view-toggle augment-view-toggle" data-action="toggleCardView" title="{{#if viewMode}}{{localize 'ESSENCE.Common.EditThisItem'}}{{else}}{{localize 'ESSENCE.Common.ViewThisItem'}}{{/if}}">
    <i class="fa-solid {{#if viewMode}}fa-pen{{else}}fa-eye{{/if}}"></i> {{#if viewMode}}{{localize "ESSENCE.Common.Edit"}}{{else}}{{localize "ESSENCE.Common.View"}}{{/if}}
  </button>
</header>

{{#if viewMode}}
<div class="card-view augment-view">
  <div class="card-view-infogrid">
    <div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Kind"}}</span><span>{{system.kind}}</span></div>
    <div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Compatibility"}}</span><span>{{system.compatibility}}</span></div>
    {{#if (eq system.kind "function")}}
      <div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Uses"}}</span><span>{{system.usesRemaining}}/{{system.uses}}</span></div>
    {{/if}}
  </div>

  {{#if system.effect}}
    <div class="card-view-line">
      <div class="card-view-label">{{localize "ESSENCE.Common.Effect"}}</div>
      <div class="card-view-text">{{{system.effect}}}</div>
    </div>
  {{/if}}

  {{#if system.flavor}}<div class="card-view-flavor">{{{system.flavor}}}</div>{{/if}}
</div>
{{else}}

<div class="equipment-fields grid-3">
  <label>{{localize "ESSENCE.Common.Kind"}}
    <select name="system.kind">
      <option value="function" {{#if (eq system.kind "function")}}selected{{/if}}>{{localize "ESSENCE.Item.Augment.KindFunction"}}</option>
      <option value="support" {{#if (eq system.kind "support")}}selected{{/if}}>{{localize "ESSENCE.Item.Augment.KindSupport"}}</option>
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Compatibility"}} <input name="system.compatibility" type="text" value="{{system.compatibility}}" placeholder="{{localize 'ESSENCE.Item.Augment.CompatibilityPlaceholder'}}"></label>
  {{#if (eq system.kind "function")}}
    <label>{{localize "ESSENCE.Common.Uses"}} <input name="system.uses" type="number" min="0" value="{{system.uses}}"></label>
    <label>{{localize "ESSENCE.Item.Augment.UsesRemaining"}} <input name="system.usesRemaining" type="number" min="0" value="{{system.usesRemaining}}"></label>
  {{/if}}
</div>

<p class="muted">
  {{#if (eq system.kind "function")}}
    {{localize "ESSENCE.Item.Augment.FunctionHint"}}
  {{else}}
    {{localize "ESSENCE.Item.Augment.SupportHint"}}
  {{/if}}
</p>

<h3 class="section-head">{{localize "ESSENCE.Common.Effect"}}</h3>
<div>{{essenceEditor system.effect target="system.effect" button=true}}</div>
<h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
<div>{{essenceEditor system.flavor target="system.flavor" button=true}}</div>
{{/if}}
</div>
