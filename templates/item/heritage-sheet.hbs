<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}"></h1>
</header>

<h3 class="section-head">Description</h3>
<div>{{essenceEditor system.description target="system.description" button=true}}</div>

<h3 class="section-head">Legacy</h3>
<input name="system.legacy.name" type="text" value="{{system.legacy.name}}" placeholder="Legacy name">
<div>{{essenceEditor system.legacy.text target="system.legacy.text" button=true}}</div>

<h3 class="section-head">Familiarity</h3>
<input name="system.familiarity.name" type="text" value="{{system.familiarity.name}}" placeholder="Familiarity name">
<div>{{essenceEditor system.familiarity.text target="system.familiarity.text" button=true}}</div>
</div>
