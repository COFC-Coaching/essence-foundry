<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}"></h1>
</header>

<h3 class="section-head">{{localize "ESSENCE.Common.Description"}}</h3>
<div>{{essenceEditor system.description target="system.description" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Heritage.Legacy"}}</h3>
<input name="system.legacy.name" type="text" value="{{system.legacy.name}}" placeholder="{{localize 'ESSENCE.Item.Heritage.LegacyNamePlaceholder'}}">
<div>{{essenceEditor system.legacy.text target="system.legacy.text" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Heritage.Familiarity"}}</h3>
<input name="system.familiarity.name" type="text" value="{{system.familiarity.name}}" placeholder="{{localize 'ESSENCE.Item.Heritage.FamiliarityNamePlaceholder'}}">
<div>{{essenceEditor system.familiarity.text target="system.familiarity.text" button=true}}</div>
</div>
