<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}" style="font-size: {{fitTitleSize item.name max=24 min=14 startAt=12}}px"></h1>
</header>

<h3 class="section-head">{{localize "ESSENCE.Common.Description"}}</h3>
<div>{{essenceEditor system.description target="system.description" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Species.Nature"}}</h3>
<input name="system.nature.name" type="text" value="{{system.nature.name}}" placeholder="{{localize 'ESSENCE.Item.Species.NatureNamePlaceholder'}}">
<div>{{essenceEditor system.nature.text target="system.nature.text" button=true}}</div>
<fieldset class="subchoice-editor">
  <legend>{{localize "ESSENCE.Item.Species.SubChoiceLegend"}}</legend>
  <label>{{localize "ESSENCE.Common.Label"}} <input name="system.nature.subChoice.label" type="text" value="{{system.nature.subChoice.label}}" placeholder="{{localize 'ESSENCE.Item.Species.NatureSubChoiceLabelPlaceholder'}}"></label>
  <label>{{localize "ESSENCE.Common.Type"}}
    <select name="system.nature.subChoice.type">
      <option value="none" {{#if (eq system.nature.subChoice.type "none")}}selected{{/if}}>{{localize "ESSENCE.Common.None"}}</option>
      <option value="fixed" {{#if (eq system.nature.subChoice.type "fixed")}}selected{{/if}}>{{localize "ESSENCE.Common.FixedList"}}</option>
      <option value="free" {{#if (eq system.nature.subChoice.type "free")}}selected{{/if}}>{{localize "ESSENCE.Common.FreeText"}}</option>
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Count"}} <input name="system.nature.subChoice.count" type="number" value="{{system.nature.subChoice.count}}" style="width:3em" min="1"></label>
  <label>{{localize "ESSENCE.Item.Species.FixedOptionsLabel"}}
    <input class="subchoice-options-field" data-path="nature" type="text" value="{{natureOptionsText}}" placeholder="{{localize 'ESSENCE.Item.Species.NatureOptionsPlaceholder'}}">
  </label>
</fieldset>

<h3 class="section-head">{{system.traitLabel}}s <span class="muted">{{localize "ESSENCE.Item.Species.ChooseCountSuffix" n=system.traitCount}}</span></h3>
<label>{{localize "ESSENCE.Item.Species.TraitLabel"}} <input name="system.traitLabel" type="text" value="{{system.traitLabel}}"></label>
<label>{{localize "ESSENCE.Item.Species.ChooseCount"}} <input name="system.traitCount" type="number" value="{{system.traitCount}}" style="width:3em"></label>
<ol class="traits">
  {{#each system.traits as |a i|}}
    <li>
      <label class="chosen-toggle"><input type="checkbox" class="trait-field" data-index="{{i}}" data-field="chosen" {{#if a.chosen}}checked{{/if}}> {{localize "ESSENCE.Common.Chosen"}}</label>
      <input class="trait-field" data-index="{{i}}" data-field="name" type="text" value="{{a.name}}" placeholder="{{localize 'ESSENCE.Item.Species.TraitNamePlaceholder'}}">
      <div>{{essenceEditor a.text target=(concat "system.traits." i ".text") button=true}}</div>
      <fieldset class="subchoice-editor">
        <legend>{{localize "ESSENCE.Item.Species.SubChoiceLegend"}}</legend>
        <label>{{localize "ESSENCE.Common.Label"}} <input class="trait-field" data-index="{{i}}" data-field="subChoice.label" type="text" value="{{a.subChoice.label}}" placeholder="{{localize 'ESSENCE.Item.Species.TraitSubChoiceLabelPlaceholder'}}"></label>
        <label>{{localize "ESSENCE.Common.Type"}}
          <select class="trait-field" data-index="{{i}}" data-field="subChoice.type">
            <option value="none" {{#if (eq a.subChoice.type "none")}}selected{{/if}}>{{localize "ESSENCE.Common.None"}}</option>
            <option value="fixed" {{#if (eq a.subChoice.type "fixed")}}selected{{/if}}>{{localize "ESSENCE.Common.FixedList"}}</option>
            <option value="free" {{#if (eq a.subChoice.type "free")}}selected{{/if}}>{{localize "ESSENCE.Common.FreeText"}}</option>
          </select>
        </label>
        <label>{{localize "ESSENCE.Common.Count"}} <input class="trait-field" data-index="{{i}}" data-field="subChoice.count" type="number" value="{{a.subChoice.count}}" style="width:3em" min="1"></label>
        <label>{{localize "ESSENCE.Item.Species.FixedOptionsLabel"}}
          <input class="subchoice-options-field" data-path="traits.{{i}}" type="text" value="{{lookup ../traitOptionsText i}}" placeholder="{{localize 'ESSENCE.Item.Species.TraitOptionsPlaceholder'}}">
        </label>
      </fieldset>
      <button type="button" data-action="deleteArrayRow" data-array="traits" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Species.DeleteTraitAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
    </li>
  {{/each}}
</ol>
<button type="button" data-action="addArrayRow" data-array="traits"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Species.AddTrait"}}</button>
</div>
