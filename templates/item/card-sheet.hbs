<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}" style="font-size: {{fitTitleSize item.name max=24 min=14 startAt=12}}px" {{#if viewMode}}disabled{{/if}}></h1>
  <button type="button" class="card-view-toggle" data-action="toggleCardView" data-tooltip-text="{{#if viewMode}}{{localize 'ESSENCE.Common.EditThisItem'}}{{else}}{{localize 'ESSENCE.Common.ViewThisItem'}}{{/if}}">
    <i class="fa-solid {{#if viewMode}}fa-pen{{else}}fa-eye{{/if}}"></i> {{#if viewMode}}{{localize "ESSENCE.Common.Edit"}}{{else}}{{localize "ESSENCE.Common.View"}}{{/if}}
  </button>
</header>

{{#if viewMode}}
{{!-- Read view (plan step 6, concept "Card anatomy and colors"): type band, name, Style and Rank
     chips, Requires, the Commit / Cost / Roll / Against stat tiles, body lines, numbered Surges,
     the Rider, then tags. Colors come from the card-type and domain tokens. --}}
<div class="card-view kind-{{cardView.kind}}">
  <div class="cv-band">
    <span>{{cardView.kindLabel}}{{#if system.subtype}} · {{system.subtype}}{{/if}}</span>
    <span>{{#if system.skill}}{{capitalize system.skill}} R{{system.rank}}{{else}}{{localize "ESSENCE.Item.Card.Universal"}}{{/if}}</span>
  </div>
  <div class="cv-body">
    <div class="cv-chips">
      {{#if system.skill}}<span class="chip dom-{{system.domain}}">{{capitalize system.skill}}</span><span class="chip">{{localize "ESSENCE.Common.Rank"}} {{system.rank}}</span>{{else}}<span class="chip dom-{{system.domain}}">{{capitalize system.domain}}</span><span class="chip">{{localize "ESSENCE.Item.Card.UnrankedNoStyle"}}</span>{{/if}}
    </div>
    <div class="cv-sec"><b>{{localize "ESSENCE.Item.Card.Requires"}}</b><span>{{#if system.expertises}}{{#if (eq system.expertisesMode "any2")}}{{localize "ESSENCE.Item.Card.AnyTwoOf"}}{{else}}{{localize "ESSENCE.Item.Card.AnyOf"}}{{/if}} {{system.expertises}}{{else}}<span class="muted">{{localize "ESSENCE.Item.Card.NoExpertise"}}</span>{{/if}}</span></div>
    <div class="cv-stats">
      <div class="cv-stat"><span class="cv-lbl">{{localize "ESSENCE.Item.Card.Commit"}}</span><span class="cv-v cv-accent">{{cardView.commit}}</span>{{#if cardView.commitNote}}<span class="muted">{{cardView.commitNote}}</span>{{/if}}</div>
      <div class="cv-stat"><span class="cv-lbl">{{localize "ESSENCE.Common.Cost"}}</span><span class="cv-v cv-accent">{{#if system.cost}}{{system.cost}} {{cardView.resource}}{{else}}—{{/if}}</span><span class="muted">{{#if system.cost}}{{cardView.resourceNote}}{{else}}{{localize "ESSENCE.Item.Card.NoResource"}}{{/if}}</span></div>
      {{#if system.attr}}<div class="cv-stat"><span class="cv-lbl">{{localize "ESSENCE.Item.Card.Roll"}}</span><span class="cv-v">{{capitalize system.attr}}</span></div>{{/if}}
      <div class="cv-stat"><span class="cv-lbl">{{localize "ESSENCE.Item.Card.Against"}}</span><span class="cv-v">{{#if system.unopposed}}{{localize "ESSENCE.Chat.Unopposed"}}{{else if system.defense}}{{capitalize system.defense}}{{else}}—{{/if}}</span></div>
    </div>
    {{#each system.body as |line|}}
      {{#if line.html}}<div class="cv-sec"><b>{{line.label}}</b><span>{{{line.html}}}</span></div>{{/if}}
    {{/each}}
    {{#if system.surges.length}}
      <div class="cv-surges">
        <span class="cv-lbl">{{localize "ESSENCE.Common.Surges"}} <span class="muted cv-lbl-note">{{localize "ESSENCE.Item.Card.SurgeNote"}}</span></span>
        {{#each system.surges as |s|}}
          {{#if s.html}}<div class="cv-surge"><span class="n">{{s.n}}</span><span>{{{s.html}}}</span></div>{{/if}}
        {{/each}}
      </div>
    {{/if}}
    {{#if system.rider.html}}
      <div class="cv-rider">
        {{#if system.rider.title}}<span class="cv-rider-title">{{system.rider.title}} <span class="muted">{{localize "ESSENCE.Item.Card.StyleRider"}}</span></span>{{/if}}
        <span>{{{system.rider.html}}}</span>
        {{#if system.rider.meta}}<span class="muted">{{system.rider.meta}}</span>{{/if}}
      </div>
    {{else}}
      <div class="cv-rider cv-rider-none"><span class="muted">{{#if cardView.isReaction}}{{localize "ESSENCE.Item.Card.NoRiderReaction"}}{{else}}{{localize "ESSENCE.Item.Card.NoRider"}}{{/if}}</span></div>
    {{/if}}
    {{#if system.flavor}}<div class="cv-flavor">{{{system.flavor}}}</div>{{/if}}
    {{#if system.tags}}<div class="cv-tags muted">{{system.tags}}</div>{{/if}}
  </div>
</div>
{{else}}
<div class="card-fields grid-3">
  <label>{{localize "ESSENCE.Common.Rank"}} <input name="system.rank" type="number" value="{{system.rank}}"></label>
  <label>{{localize "ESSENCE.Common.Subtype"}}
    <select name="system.subtype">
      <option value="" {{#unless system.subtype}}selected{{/unless}}>—</option>
      {{#each subtypeOptions as |st|}}
        <option value="{{st}}" {{#if (eq st ../system.subtype)}}selected{{/if}}>{{st}}</option>
      {{/each}}
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Attribute"}} <input name="system.attr" type="text" value="{{system.attr}}"></label>
  <label>{{localize "ESSENCE.Common.Style"}}
    <select class="skill-select">
      <option value="" {{#unless system.skill}}selected{{/unless}}>{{localize "ESSENCE.Item.Card.BasicUniversal"}}</option>
      {{#each skillOptions as |s|}}
        <option value="{{s.key}}" {{#if (eq s.key ../system.skill)}}selected{{/if}}>{{s.label}}</option>
      {{/each}}
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Defense"}} <input name="system.defense" type="text" value="{{system.defense}}"></label>
  <label style="display:flex;align-items:center;gap:6px;">
    <input name="system.unopposed" type="checkbox" {{#if system.unopposed}}checked{{/if}}> {{localize "ESSENCE.Item.Card.Unopposed"}}
  </label>
  <label>{{localize "ESSENCE.Item.Card.MinDice"}} <input name="system.min" type="text" value="{{system.min}}"></label>
  <label>{{localize "ESSENCE.Common.Cost"}} <input name="system.cost" type="text" value="{{system.cost}}"></label>
  <label>{{localize "ESSENCE.Common.Tags"}} <input name="system.tags" type="text" value="{{system.tags}}"></label>
</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Card.Body"}}</h3>
<ol class="body-lines">
  {{#each system.body as |line i|}}
    <li>
      <input name="system.body.{{i}}.label" type="text" value="{{line.label}}" placeholder="{{localize 'ESSENCE.Common.Label'}}">
      <button type="button" data-action="deleteArrayRow" data-array="body" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Card.DeleteBodyLineAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
      <div>{{essenceEditor line.html target=(concat "system.body." i ".html") button=true}}</div>
    </li>
  {{/each}}
</ol>
<button type="button" data-action="addArrayRow" data-array="body"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Card.AddBodyLine"}}</button>

<h3 class="section-head">{{localize "ESSENCE.Common.Surges"}}</h3>
<ol class="surges">
  {{#each system.surges as |s i|}}
    <li>
      <input name="system.surges.{{i}}.n" type="text" value="{{s.n}}" style="width:3em">
      <button type="button" data-action="deleteArrayRow" data-array="surges" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Card.DeleteSurgeAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
      <div>{{essenceEditor s.html target=(concat "system.surges." i ".html") button=true}}</div>
    </li>
  {{/each}}
</ol>
<button type="button" data-action="addArrayRow" data-array="surges"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Card.AddSurge"}}</button>

<h3 class="section-head">{{localize "ESSENCE.Item.Card.Rider"}}</h3>
<input name="system.rider.title" type="text" value="{{system.rider.title}}" placeholder="{{localize 'ESSENCE.Item.Card.RiderTitlePlaceholder'}}">
<div>{{essenceEditor system.rider.html target="system.rider.html" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
<div>{{essenceEditor system.flavor target="system.flavor" button=true}}</div>
{{/if}}
</div>
