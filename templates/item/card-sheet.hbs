<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}"></h1>
</header>

<div class="card-fields grid-3">
  <label>Rank <input name="system.rank" type="number" value="{{system.rank}}"></label>
  <label>Subtype <input name="system.subtype" type="text" value="{{system.subtype}}"></label>
  <label>Attribute <input name="system.attr" type="text" value="{{system.attr}}"></label>
  <label>Skill <input name="system.skill" type="text" value="{{system.skill}}"></label>
  <label>Defense <input name="system.defense" type="text" value="{{system.defense}}"></label>
  <label>Min Dice <input name="system.min" type="text" value="{{system.min}}"></label>
  <label>Cost <input name="system.cost" type="text" value="{{system.cost}}"></label>
  <label>Tags <input name="system.tags" type="text" value="{{system.tags}}"></label>
</div>

<h3 class="section-head">Body</h3>
<ol class="body-lines">
  {{#each system.body as |line i|}}
    <li>
      <input name="system.body.{{i}}.label" type="text" value="{{line.label}}" placeholder="Label">
      <div>{{essenceEditor line.html target=(concat "system.body." i ".html") button=true}}</div>
    </li>
  {{/each}}
</ol>

<h3 class="section-head">Surges</h3>
<ol class="surges">
  {{#each system.surges as |s i|}}
    <li>
      <input name="system.surges.{{i}}.n" type="text" value="{{s.n}}" style="width:3em">
      <div>{{essenceEditor s.html target=(concat "system.surges." i ".html") button=true}}</div>
    </li>
  {{/each}}
</ol>

<h3 class="section-head">Rider</h3>
<input name="system.rider.title" type="text" value="{{system.rider.title}}" placeholder="Rider title">
<div>{{essenceEditor system.rider.html target="system.rider.html" button=true}}</div>

<h3 class="section-head">Flavor</h3>
<div>{{essenceEditor system.flavor target="system.flavor" button=true}}</div>
</div>
