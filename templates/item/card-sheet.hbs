<div class="essence-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage">
  <h1><input name="name" type="text" value="{{item.name}}" style="font-size: {{fitTitleSize item.name max=24 min=14 startAt=12}}px" {{#if viewMode}}disabled{{/if}}></h1>
  <button type="button" class="card-view-toggle" data-action="toggleCardView" title="{{#if viewMode}}{{localize 'ESSENCE.Common.EditThisItem'}}{{else}}{{localize 'ESSENCE.Common.ViewThisItem'}}{{/if}}">
    <i class="fa-solid {{#if viewMode}}fa-pen{{else}}fa-eye{{/if}}"></i> {{#if viewMode}}{{localize "ESSENCE.Common.Edit"}}{{else}}{{localize "ESSENCE.Common.View"}}{{/if}}
  </button>
</header>

{{#if viewMode}}
<div class="card-view">
  {{#if system.skill}}
    <div class="card-view-style-row">{{capitalize system.skill}}{{#if system.subtype}} <span class="card-view-subtype">| {{system.subtype}}</span>{{/if}}</div>
  {{/if}}
  {{#if system.expertises}}<div class="card-view-expertises">{{system.expertises}}</div>{{/if}}

  <div class="card-view-infogrid">
    <div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Rank"}}</span><span>{{system.rank}}</span></div>
    {{#if system.min}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Item.Card.Commitment"}}</span><span>{{localize "ESSENCE.Common.Dice"}} {{system.min}}+{{#if system.cost}} · {{localize "ESSENCE.Common.Cost"}} {{system.cost}} {{domainResource system.domain}}{{/if}}</span></div>{{/if}}
    {{#if system.attr}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Attribute"}}</span><span>{{system.attr}}</span></div>{{/if}}
    {{#if system.defense}}<div><span class="card-view-statlabel">{{localize "ESSENCE.Common.Defense"}}</span><span>{{system.defense}}</span></div>{{/if}}
  </div>
  {{#if system.tags}}<div class="card-view-tags muted">{{system.tags}}</div>{{/if}}

  {{#each system.body as |line|}}
    {{#if line.html}}
      <div class="card-view-line">
        <div class="card-view-label">{{line.label}}</div>
        <div class="card-view-text">{{{line.html}}}</div>
      </div>
    {{/if}}
  {{/each}}

  {{#if system.surges.length}}
    <div class="card-view-label">{{localize "ESSENCE.Common.Surges"}}</div>
    <div class="card-view-surges">
      {{#each system.surges as |s|}}
        {{#if s.html}}
          <div class="surge-option"><span class="cost">{{s.n}}</span><span class="surge-text">{{{s.html}}}</span></div>
        {{/if}}
      {{/each}}
    </div>
  {{/if}}

  {{#if system.rider.html}}
    <div class="card-view-rider">
      {{#if system.rider.title}}<div class="card-view-rider-title">{{system.rider.title}}</div>{{/if}}
      <div>{{{system.rider.html}}}</div>
      {{#if system.rider.meta}}<div class="muted">{{system.rider.meta}}</div>{{/if}}
    </div>
  {{/if}}

  {{#if system.flavor}}<div class="card-view-flavor">{{{system.flavor}}}</div>{{/if}}
</div>
{{else}}

<div class="card-fields grid-3">
  <label>{{localize "ESSENCE.Common.Rank"}} <input name="system.rank" type="number" value="{{system.rank}}"></label>
  <label>{{localize "ESSENCE.Common.Subtype"}}
    <select name="system.subtype">
      <option value="" {{#unless system.subtype}}selected{{/unless}}>—</option>
      {{#each subtypeOptions as |st|}}
        <option value="{{st}}" {{#if (eq st ../system.subtype)}}selected{{/if}}>{{st}}</option>
      {{/each}}
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Attribute"}} <input name="system.attr" type="text" value="{{system.attr}}"></label>
  <label>{{localize "ESSENCE.Common.Skill"}}
    <select class="skill-select">
      <option value="" {{#unless system.skill}}selected{{/unless}}>{{localize "ESSENCE.Item.Card.BasicUniversal"}}</option>
      {{#each skillOptions as |s|}}
        <option value="{{s.key}}" {{#if (eq s.key ../system.skill)}}selected{{/if}}>{{s.label}}</option>
      {{/each}}
    </select>
  </label>
  <label>{{localize "ESSENCE.Common.Defense"}} <input name="system.defense" type="text" value="{{system.defense}}"></label>
  <label>{{localize "ESSENCE.Item.Card.MinDice"}} <input name="system.min" type="text" value="{{system.min}}"></label>
  <label>{{localize "ESSENCE.Common.Cost"}} <input name="system.cost" type="text" value="{{system.cost}}"></label>
  <label>{{localize "ESSENCE.Common.Tags"}} <input name="system.tags" type="text" value="{{system.tags}}"></label>
</div>

<h3 class="section-head">{{localize "ESSENCE.Item.Card.Body"}}</h3>
<ol class="body-lines">
  {{#each system.body as |line i|}}
    <li>
      <input name="system.body.{{i}}.label" type="text" value="{{line.label}}" placeholder="{{localize 'ESSENCE.Common.Label'}}">
      <button type="button" data-action="deleteArrayRow" data-array="body" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Card.DeleteBodyLineAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
      <div>{{essenceEditor line.html target=(concat "system.body." i ".html") button=true}}</div>
    </li>
  {{/each}}
</ol>
<button type="button" data-action="addArrayRow" data-array="body"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Card.AddBodyLine"}}</button>

<h3 class="section-head">{{localize "ESSENCE.Common.Surges"}}</h3>
<ol class="surges">
  {{#each system.surges as |s i|}}
    <li>
      <input name="system.surges.{{i}}.n" type="text" value="{{s.n}}" style="width:3em">
      <button type="button" data-action="deleteArrayRow" data-array="surges" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Card.DeleteSurgeAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
      <div>{{essenceEditor s.html target=(concat "system.surges." i ".html") button=true}}</div>
    </li>
  {{/each}}
</ol>
<button type="button" data-action="addArrayRow" data-array="surges"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Card.AddSurge"}}</button>

<h3 class="section-head">{{localize "ESSENCE.Item.Card.Rider"}}</h3>
<input name="system.rider.title" type="text" value="{{system.rider.title}}" placeholder="{{localize 'ESSENCE.Item.Card.RiderTitlePlaceholder'}}">
<div>{{essenceEditor system.rider.html target="system.rider.html" button=true}}</div>

<h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
<div>{{essenceEditor system.flavor target="system.flavor" button=true}}</div>
{{/if}}
</div>
