<div class="essence-wizard-root">
  <nav class="wizard-steps">
    {{#each steps as |s|}}
      <button type="button" class="wizard-step-tab {{#if (eq s.i ../step)}}active{{/if}}" data-action="wizardGoTo" data-step="{{s.i}}">{{addOne s.i}}. {{s.name}}</button>
    {{/each}}
  </nav>

  <div class="wizard-body">

  {{!-- ============ STEP 1: CONCEPT ============ --}}
  {{#if (eq step 0)}}
    <h2>{{localize "ESSENCE.Wizard.Monster.Concept"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.ConceptHint"}}</p>
    <div class="wizard-row">
      <label>{{localize "ESSENCE.Item.Monster.Role"}}
        <select name="system.role">
          <option value="" {{#if (eq system.role "")}}selected{{/if}}></option>
          <option value="Minion" {{#if (eq system.role "Minion")}}selected{{/if}}>{{localize "ESSENCE.Item.Monster.RoleMinion"}}</option>
          <option value="Standard" {{#if (eq system.role "Standard")}}selected{{/if}}>{{localize "ESSENCE.Item.Monster.RoleStandard"}}</option>
          <option value="Elite" {{#if (eq system.role "Elite")}}selected{{/if}}>{{localize "ESSENCE.Item.Monster.RoleElite"}}</option>
          <option value="Nemesis" {{#if (eq system.role "Nemesis")}}selected{{/if}}>{{localize "ESSENCE.Item.Monster.RoleNemesis"}}</option>
        </select>
      </label>
      <label>{{localize "ESSENCE.Common.Tier"}} <input type="number" name="system.tier" value="{{system.tier}}" style="width:4em"></label>
      <label>{{localize "ESSENCE.Common.Level"}} <input type="number" name="system.level" value="{{system.level}}" style="width:4em"></label>
    </div>

    <h3 class="section-head">{{localize "ESSENCE.Wizard.Monster.DomainEmphasis"}}</h3>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.DomainEmphasisHint"}}</p>
    <div class="wizard-row">
      <button type="button" class="{{#if (eq emphasis "balanced")}}chosen{{/if}}" data-action="setEmphasis" data-domain="balanced">{{localize "ESSENCE.Wizard.Monster.Balanced"}}</button>
      <button type="button" class="{{#if (eq emphasis "physical")}}chosen{{/if}}" data-action="setEmphasis" data-domain="physical">{{localize "ESSENCE.Common.Physical"}}</button>
      <button type="button" class="{{#if (eq emphasis "mental")}}chosen{{/if}}" data-action="setEmphasis" data-domain="mental">{{localize "ESSENCE.Common.Mental"}}</button>
      <button type="button" class="{{#if (eq emphasis "spiritual")}}chosen{{/if}}" data-action="setEmphasis" data-domain="spiritual">{{localize "ESSENCE.Common.Spiritual"}}</button>
    </div>

    <h3 class="section-head">{{localize "ESSENCE.Wizard.Monster.Budget"}} — {{#if system.role}}{{system.role}}{{else}}{{localize "ESSENCE.Item.Monster.RoleStandardDefault"}}{{/if}}</h3>
    <div class="wizard-row">
      <span>{{localize "ESSENCE.Wizard.Monster.AttributePts" pts=budget.attributePool max=budget.attributeMax}}</span>
      <span>{{localize "ESSENCE.Wizard.Monster.SkillPts" pts=budget.skillPool max=budget.skillMax}}</span>
      <span>{{localize "ESSENCE.Wizard.Monster.CardBudget" action=budget.actionCards reaction=budget.reactionCards}}</span>
      <span>{{localize "ESSENCE.Wizard.Monster.EquipmentBudget" n=budget.equipmentCount}}</span>
    </div>

    <button type="button" class="wizard-generate" data-action="autoGenerate"><i class="fa-solid fa-dice-d20"></i> {{localize "ESSENCE.Wizard.Monster.AutoGenerate"}}</button>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.AutoGenerateHint"}}</p>

    <h3 class="section-head">{{localize "ESSENCE.Wizard.Monster.GmNotes"}}</h3>
    {{essenceEditor system.gmNotes target="system.gmNotes" button=true}}
  {{/if}}

  {{!-- ============ STEP 2: ORIGIN ============ --}}
  {{#if (eq step 1)}}
    <h2>{{localize "ESSENCE.Wizard.Monster.Origin"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.OriginHint"}}</p>

    <h3 class="section-head">{{localize "ESSENCE.Item.SpeciesLabel"}} {{#if speciesItem}}— <strong>{{speciesItem.name}}</strong> <button type="button" class="link-button" data-action="clearOrigin" data-type="species">({{localize "ESSENCE.Common.Clear"}})</button>{{/if}}</h3>
    <ul class="wizard-pick-list">
      {{#each speciesOptions as |opt|}}
        <li><button type="button" class="{{#if (eq opt.name ../speciesItem.name)}}chosen{{/if}}" data-action="selectOrigin" data-pack="essence-system.species" data-id="{{opt.id}}">{{opt.name}}</button></li>
      {{/each}}
    </ul>

    <h3 class="section-head">{{localize "ESSENCE.Item.DistinctionLabel"}} {{#if distinctionItem}}— <strong>{{distinctionItem.name}}</strong> <button type="button" class="link-button" data-action="clearOrigin" data-type="distinction">({{localize "ESSENCE.Common.Clear"}})</button>{{/if}}</h3>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.GatedSkillsHint"}}</p>
    <ul class="wizard-pick-list">
      {{#each distinctionOptions as |opt|}}
        <li><button type="button" class="{{#if (eq opt.name ../distinctionItem.name)}}chosen{{/if}}" data-action="selectOrigin" data-pack="essence-system.distinctions" data-id="{{opt.id}}">{{opt.name}} <span class="muted">({{opt.system.keyCombatSkill}})</span></button></li>
      {{/each}}
    </ul>
  {{/if}}

  {{!-- ============ STEP 3: ATTRIBUTES ============ --}}
  {{#if (eq step 2)}}
    <h2>{{localize "ESSENCE.Common.Attributes"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.AttributesHint" pool=attributePool max=budget.attributeMax}} {{localize "ESSENCE.Wizard.PointsRemaining"}}: <strong>{{attributeRemaining}}</strong></p>
    <button type="button" data-action="rerollAttributes"><i class="fa-solid fa-dice"></i> {{localize "ESSENCE.Wizard.Monster.RerollAttributes"}}</button>
    <table class="item-table">
      <thead><tr><th>{{localize "ESSENCE.Common.Attribute"}}</th><th></th><th>{{localize "ESSENCE.Common.Value"}}</th><th></th></tr></thead>
      <tbody>
        {{#each attributes as |a|}}
          <tr>
            <td class="capitalize">{{a.key}}</td>
            <td><button type="button" data-action="adjustAttribute" data-attr="{{a.key}}" data-delta="-1">-</button></td>
            <td class="wizard-value">{{a.value}}</td>
            <td><button type="button" data-action="adjustAttribute" data-attr="{{a.key}}" data-delta="1">+</button></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    <h3 class="section-head">{{localize "ESSENCE.Wizard.Monster.ResourcesDefensesDerived"}}</h3>
    <div class="wizard-row">
      <span>{{localize "ESSENCE.Common.Stamina"}} {{system.resources.stamina.max}}</span>
      <span>{{localize "ESSENCE.Common.Focus"}} {{system.resources.focus.max}}</span>
      <span>{{localize "ESSENCE.Common.Mana"}} {{system.resources.mana.max}}</span>
      <span>{{localize "ESSENCE.Common.Fortitude"}} {{system.defenses.fortitude}}</span>
      <span>{{localize "ESSENCE.Common.Composure"}} {{system.defenses.composure}}</span>
      <span>{{localize "ESSENCE.Common.Harmony"}} {{system.defenses.harmony}}</span>
    </div>
  {{/if}}

  {{!-- ============ STEP 4: COMBAT SKILLS ============ --}}
  {{#if (eq step 3)}}
    <h2>{{localize "ESSENCE.Common.CombatSkills"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.SkillsHint" pool=skillPool max=budget.skillMax}} {{localize "ESSENCE.Wizard.PointsRemaining"}}: <strong>{{skillRemaining}}</strong></p>
    <button type="button" data-action="rerollSkills"><i class="fa-solid fa-dice"></i> {{localize "ESSENCE.Wizard.Monster.RerollSkills"}}</button>
    <table class="item-table">
      <thead><tr><th>{{localize "ESSENCE.Common.Skill"}}</th><th></th><th>{{localize "ESSENCE.Common.Rank"}}</th><th></th></tr></thead>
      <tbody>
        {{#each skills as |s|}}
          <tr class="{{#unless s.gateOpen}}gated{{/unless}}">
            <td class="capitalize">{{s.key}} {{#unless s.gateOpen}}<span class="gate-note">({{localize "ESSENCE.Wizard.Monster.RequiresDistinction" name=s.gateDistinction}})</span>{{/unless}}</td>
            <td><button type="button" data-action="adjustSkill" data-skill="{{s.key}}" data-delta="-1">-</button></td>
            <td class="wizard-value">{{s.value}}</td>
            <td><button type="button" data-action="adjustSkill" data-skill="{{s.key}}" data-delta="1" {{#unless s.gateOpen}}disabled{{/unless}}>+</button></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{/if}}

  {{!-- ============ STEP 5: WOUNDS ============ --}}
  {{#if (eq step 4)}}
    <h2>{{localize "ESSENCE.Common.Wounds"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.WoundsHint"}}</p>
    <div class="wizard-row">
      <label>{{localize "ESSENCE.Common.Resilience"}} <input type="number" name="system.resilience" value="{{system.resilience}}" style="width:4em"></label>
      <label>{{localize "ESSENCE.Common.TemporaryWoundsAvailable"}} <input type="number" name="system.temporaryWoundsAvailable" value="{{system.temporaryWoundsAvailable}}" style="width:4em" min="0" max="5"></label>
    </div>
    <h3 class="section-head">{{localize "ESSENCE.Wizard.Monster.CoreWoundsStartEmpty"}}</h3>
    <span class="pip-track">
      {{#each system.coreWounds as |w|}}<span class="pip {{#if w.filled}}filled{{/if}}"></span>{{/each}}
    </span>
  {{/if}}

  {{!-- ============ STEP 6: COMBAT CARDS ============ --}}
  {{#if (eq step 5)}}
    <h2>{{localize "ESSENCE.Common.CombatCards"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.RoleBudgetCards" action=actionCardBudget reaction=reactionCardBudget}}</p>
    <button type="button" data-action="rerollCards"><i class="fa-solid fa-dice"></i> {{localize "ESSENCE.Wizard.Monster.RerollCards"}}</button>
    <div class="wizard-two-col">
      <div>
        <h4>{{localize "ESSENCE.Item.ActionCard"}} ({{ownedActionCards.length}} / {{actionCardBudget}})</h4>
        <ul class="item-list">
          {{#each ownedActionCards as |item|}}
            <li><a data-action="previewItem" data-uuid="{{item.uuid}}">{{item.name}}</a> <span class="muted">R{{item.system.rank}}{{#if item.system.skill}} · {{item.system.skill}}{{/if}}</span> <button type="button" data-action="toggleCard" data-item-id="{{item.id}}" aria-label="{{localize 'ESSENCE.Common.RemoveAria' name=item.name}}"><i class="fa-solid fa-trash"></i></button></li>
          {{else}}
            <li class="muted">{{localize "ESSENCE.Common.NoneYet"}}</li>
          {{/each}}
        </ul>
        <h4>{{localize "ESSENCE.Item.ReactionCard"}} ({{ownedReactionCards.length}} / {{reactionCardBudget}})</h4>
        <ul class="item-list">
          {{#each ownedReactionCards as |item|}}
            <li><a data-action="previewItem" data-uuid="{{item.uuid}}">{{item.name}}</a> <span class="muted">R{{item.system.rank}}{{#if item.system.skill}} · {{item.system.skill}}{{/if}}</span> <button type="button" data-action="toggleCard" data-item-id="{{item.id}}" aria-label="{{localize 'ESSENCE.Common.RemoveAria' name=item.name}}"><i class="fa-solid fa-trash"></i></button></li>
          {{else}}
            <li class="muted">{{localize "ESSENCE.Common.NoneYet"}}</li>
          {{/each}}
        </ul>
      </div>
      <div>
        <h4>{{localize "ESSENCE.Wizard.Monster.QualifyingCards"}}</h4>
        <input type="text" data-wizard-search="cards" placeholder="{{localize 'ESSENCE.Common.SearchPlaceholder'}}" value="{{cardSearch}}">
        <ul class="item-list wizard-scroll-list">
          {{#each browsableCards as |item|}}
            <li><a data-action="previewItem" data-uuid="{{item.uuid}}">{{item.name}}</a> <span class="muted">R{{item.system.rank}} · {{item.system.skill}}{{#if (eq item.type "reaction-card")}} · {{localize "ESSENCE.Common.Reaction"}}{{/if}}</span> <button type="button" data-action="toggleCard" data-pack="{{item.pack}}" data-id="{{item.id}}" aria-label="{{localize 'ESSENCE.Common.AddAria' name=item.name}}"><i class="fa-solid fa-plus"></i></button></li>
          {{else}}
            <li class="muted">{{localize "ESSENCE.Wizard.Monster.NoCardsMatch"}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  {{/if}}

  {{!-- ============ STEP 7: EQUIPMENT ============ --}}
  {{#if (eq step 6)}}
    <h2>{{localize "ESSENCE.Item.EquipmentLabel"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.RoleBudgetItems" n=equipmentBudget}}</p>
    <button type="button" data-action="rerollEquipment"><i class="fa-solid fa-dice"></i> {{localize "ESSENCE.Wizard.Monster.RerollEquipment"}}</button>
    <h3 class="section-head">{{localize "ESSENCE.Wizard.Loadout"}} — {{equipmentItems.length}} / {{equipmentBudget}}</h3>
    <ul class="item-list">
      {{#each equipmentItems as |item|}}
        <li><a data-action="previewItem" data-uuid="{{item.uuid}}">{{item.name}}</a> <button type="button" data-action="toggleEquipment" data-item-id="{{item.id}}" aria-label="{{localize 'ESSENCE.Common.RemoveAria' name=item.name}}"><i class="fa-solid fa-trash"></i></button></li>
      {{else}}
        <li class="muted">{{localize "ESSENCE.Common.NoneYet"}}</li>
      {{/each}}
    </ul>
    <h3 class="section-head">{{localize "ESSENCE.Wizard.EquipmentLibrary"}}</h3>
    <input type="text" data-wizard-search="equipment" placeholder="{{localize 'ESSENCE.Common.SearchPlaceholder'}}" value="{{equipmentSearch}}">
    <ul class="item-list wizard-scroll-list">
      {{#each browsableEquipment as |item|}}
        <li><a data-action="previewItem" data-uuid="{{item.uuid}}">{{item.name}}</a> <span class="muted">{{equipmentCategoryLabel item.system.category}}</span> <button type="button" data-action="toggleEquipment" data-pack="essence-system.equipment" data-id="{{item.id}}" aria-label="{{localize 'ESSENCE.Common.AddAria' name=item.name}}"><i class="fa-solid fa-plus"></i></button></li>
      {{/each}}
    </ul>
  {{/if}}

  {{!-- ============ STEP 8: FINALIZE ============ --}}
  {{#if (eq step 7)}}
    <h2>{{localize "ESSENCE.Wizard.Finalize"}}</h2>
    <p class="muted">{{actor.name}} — {{#if system.role}}{{system.role}}{{else}}{{localize "ESSENCE.Item.Monster.RoleStandard"}}{{/if}}, {{localize "ESSENCE.Common.Tier"}} {{system.tier}}, {{localize "ESSENCE.Common.Level"}} {{system.level}}.</p>
    <div class="wizard-row">
      <span>{{localize "ESSENCE.Common.Stamina"}} {{resources.stamina.max}}</span>
      <span>{{localize "ESSENCE.Common.Focus"}} {{resources.focus.max}}</span>
      <span>{{localize "ESSENCE.Common.Mana"}} {{resources.mana.max}}</span>
      <span>{{localize "ESSENCE.Common.Fortitude"}} {{defenses.fortitude}}</span>
      <span>{{localize "ESSENCE.Common.Composure"}} {{defenses.composure}}</span>
      <span>{{localize "ESSENCE.Common.Harmony"}} {{defenses.harmony}}</span>
      <span>{{localize "ESSENCE.Common.BaseActionPool"}} {{baseCombatDice}}</span>
    </div>
    <div class="wizard-row">
      <span>{{localize "ESSENCE.Common.Resilience"}} {{system.resilience}}</span>
      <span>{{localize "ESSENCE.Common.TemporaryWounds"}} {{system.temporaryWoundsAvailable}}</span>
      <span>{{localize "ESSENCE.Common.CombatCards"}} {{cardCount}}</span>
      <span>{{localize "ESSENCE.Item.EquipmentLabel"}} {{equipmentCount}}</span>
    </div>
    <p class="muted">{{localize "ESSENCE.Wizard.Monster.FinalizeHint"}}</p>
  {{/if}}

  </div>

  <footer class="wizard-footer">
    <button type="button" data-action="wizardBack" {{#if isFirst}}disabled{{/if}}>← {{localize "ESSENCE.Common.Back"}}</button>
    <span class="muted">{{localize "ESSENCE.Wizard.StepOf" step=(addOne step) total=8 name=stepName}}</span>
    {{#if isLast}}
      <button type="button" data-action="wizardAccept">{{localize "ESSENCE.Common.Accept"}}</button>
    {{else}}
      <button type="button" data-action="wizardNext">{{localize "ESSENCE.Common.Next"}} →</button>
    {{/if}}
  </footer>
</div>
