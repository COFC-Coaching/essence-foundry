<div class="essence-wizard-root">
  <div class="wizard-body">

  {{#unless canCreate}}
    <p class="muted">You don't have permission to create content. Ask your GM to grant Foundry's "Create Items" permission (Configure Settings &gt; Configure Permissions).</p>
  {{/unless}}

  {{#unless templateConfig}}
    <h2>Bulk Import</h2>
    <p class="muted">Download a CSV template, fill it out (Excel, Google Sheets, or any spreadsheet app that exports CSV), then upload it here. Matching by name: a row whose name already exists in the compendium updates that item in place; a new name creates a new one.</p>
    <div class="content-type-grid">
      {{#each templates as |t|}}
        <button type="button" class="content-type-card content-type-{{t.key}}" data-action="chooseTemplate" data-key="{{t.key}}" {{#unless ../canCreate}}disabled{{/unless}}>
          <img src="{{t.img}}" alt="">
          <span>{{t.label}}</span>
        </button>
      {{/each}}
    </div>
  {{/unless}}

  {{#if templateConfig}}
    <h2>{{templateConfig.label}}</h2>

    <div class="wizard-row">
      <button type="button" data-action="downloadTemplate" data-key="{{templateKey}}"><i class="fa-solid fa-download"></i> Download Template CSV</button>
      <button type="button" data-action="reset">← Choose a different type</button>
    </div>

    <p class="muted">Columns: {{#each templateConfig.columns}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>

    <label class="csv-upload">Upload filled-in CSV
      <input type="file" accept=".csv,text/csv" data-role="file-input" {{#unless canCreate}}disabled{{/unless}}>
    </label>

    {{#if parsed}}
      <h3 class="section-head">Preview — {{fileName}}</h3>
      {{#if parsed.missingColumns.length}}
        <p class="muted" style="color:#c62828">Missing expected column(s): {{#each parsed.missingColumns}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} — those fields will import blank.</p>
      {{/if}}
      <p>{{parsed.records.length}} row(s) found.</p>
      <ul class="item-list wizard-scroll-list">
        {{#each parsed.records as |r i|}}
          <li>Row {{addOne i}}: <strong>{{r.name}}</strong></li>
        {{/each}}
      </ul>
      <button type="button" data-action="runImport" {{#unless canCreate}}disabled{{/unless}}>Import {{parsed.records.length}} Row(s)</button>
    {{/if}}

    {{#if results}}
      <h3 class="section-head">Results</h3>
      <p>Created {{results.created}}, updated {{results.updated}}{{#if results.errors.length}}, {{results.errors.length}} skipped{{/if}}.</p>
      {{#if results.errors.length}}
        <ul class="wizard-checklist">
          {{#each results.errors as |e|}}
            <li class="fail">Row {{e.row}}: {{e.message}}</li>
          {{/each}}
        </ul>
      {{/if}}
    {{/if}}
  {{/if}}

  </div>
</div>
