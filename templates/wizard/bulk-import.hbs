<div class="essence-wizard-root">
  <div class="wizard-body">

  {{#unless canCreate}}
    <p class="muted">{{localize "ESSENCE.Wizard.BulkImport.NoPermission"}}</p>
  {{/unless}}

  {{#unless templateConfig}}
    <h2>{{localize "ESSENCE.Wizard.BulkImport.Title"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.BulkImport.Intro"}}</p>
    <div class="content-type-grid">
      {{#each templates as |t|}}
        <button type="button" class="content-type-card content-type-{{t.key}}" data-action="chooseTemplate" data-key="{{t.key}}" {{#unless ../canCreate}}disabled{{/unless}}>
          <img src="{{t.img}}" alt="">
          <span>{{t.label}}</span>
        </button>
      {{/each}}
    </div>
  {{/unless}}

  {{#if templateConfig}}
    <h2>{{templateConfig.label}}</h2>

    <div class="wizard-row">
      <button type="button" data-action="downloadTemplate" data-key="{{templateKey}}"><i class="fa-solid fa-download"></i> {{localize "ESSENCE.Wizard.BulkImport.DownloadTemplate"}}</button>
      <button type="button" data-action="reset">← {{localize "ESSENCE.Wizard.BulkImport.ChooseDifferentType"}}</button>
    </div>

    <p class="muted">{{localize "ESSENCE.Wizard.BulkImport.Columns"}}: {{#each templateConfig.columns}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>

    <label class="csv-upload">{{localize "ESSENCE.Wizard.BulkImport.UploadCsv"}}
      <input type="file" accept=".csv,text/csv" data-role="file-input" {{#unless canCreate}}disabled{{/unless}}>
    </label>

    {{#if parsed}}
      <h3 class="section-head">{{localize "ESSENCE.Wizard.BulkImport.Preview"}} — {{fileName}}</h3>
      {{#if parsed.missingColumns.length}}
        <p class="muted" style="color:#c62828">{{localize "ESSENCE.Wizard.BulkImport.MissingColumns"}}: {{#each parsed.missingColumns}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} {{localize "ESSENCE.Wizard.BulkImport.MissingColumnsSuffix"}}</p>
      {{/if}}
      <p>{{localize "ESSENCE.Wizard.BulkImport.RowsFound" n=parsed.records.length}}</p>
      <ul class="item-list wizard-scroll-list">
        {{#each parsed.records as |r i|}}
          <li>{{localize "ESSENCE.Wizard.BulkImport.Row" n=(addOne i)}}: <strong>{{r.name}}</strong></li>
        {{/each}}
      </ul>
      <button type="button" data-action="runImport" {{#unless canCreate}}disabled{{/unless}}>{{localize "ESSENCE.Wizard.BulkImport.ImportRows" n=parsed.records.length}}</button>
    {{/if}}

    {{#if results}}
      <h3 class="section-head">{{localize "ESSENCE.Wizard.BulkImport.Results"}}</h3>
      <p>{{localize "ESSENCE.Wizard.BulkImport.CreatedUpdated" created=results.created updated=results.updated}}{{#if results.errors.length}}, {{localize "ESSENCE.Wizard.BulkImport.Skipped" n=results.errors.length}}{{/if}}.</p>
      {{#if results.errors.length}}
        <ul class="wizard-checklist">
          {{#each results.errors as |e|}}
            <li class="fail">{{localize "ESSENCE.Wizard.BulkImport.Row" n=e.row}}: {{e.message}}</li>
          {{/each}}
        </ul>
      {{/if}}
    {{/if}}
  {{/if}}

  </div>
</div>
