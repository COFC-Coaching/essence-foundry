<div class="essence-wizard-root">
  {{#if typeConfig}}
    <nav class="wizard-steps">
      {{#each typeConfig.steps as |name i|}}
        <span class="wizard-step-tab {{#if (eq i ../step)}}active{{/if}}">{{addOne i}}. {{name}}</span>
      {{/each}}
    </nav>
  {{/if}}

  <div class="wizard-body">

  {{#unless canCreate}}
    <p class="muted">{{localize "ESSENCE.Wizard.Content.NoPermission"}}</p>
  {{/unless}}

  {{#unless doc}}
    <h2>{{localize "ESSENCE.Wizard.Content.Title"}}</h2>
    <p class="muted">{{localize "ESSENCE.Wizard.Content.Intro"}}</p>
    <div class="content-type-grid">
      {{#each typeOptions as |opt|}}
        <button type="button" class="content-type-card content-type-{{opt.key}} {{#if (eq opt.key ../type)}}chosen{{/if}}" data-action="chooseType" data-type="{{opt.key}}" {{#unless ../canCreate}}disabled{{/unless}}>
          <img src="{{opt.img}}" alt="">
          <span>{{opt.label}}</span>
        </button>
      {{/each}}
    </div>
    {{#if type}}
      <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" placeholder="{{localize 'ESSENCE.Wizard.Content.NamePlaceholder'}}" {{#unless canCreate}}disabled{{/unless}}></label>
      <button type="button" data-action="createDraft" {{#unless canCreate}}disabled{{/unless}}>{{localize "ESSENCE.Wizard.Content.CreateAndContinue"}} →</button>
    {{/if}}
  {{/unless}}

  {{#if doc}}
    <h2>{{stepName}}</h2>

    {{!-- ============ CARD steps (action-card / reaction-card) ============ --}}
    {{#if (eq step 1)}}
      {{#if (or (eq type "action-card") (eq type "reaction-card"))}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" value="{{doc.name}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Item.Card.Domain"}}
            <select data-field="system.domain">
              <option value="physical" {{#if (eq system.domain "physical")}}selected{{/if}}>physical</option>
              <option value="mental" {{#if (eq system.domain "mental")}}selected{{/if}}>mental</option>
              <option value="spiritual" {{#if (eq system.domain "spiritual")}}selected{{/if}}>spiritual</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Rank"}} <input type="number" data-field="system.rank" value="{{system.rank}}" style="width:4em" min="0" max="5"></label>
          <label>{{localize "ESSENCE.Item.Card.CombatStyle"}} <input type="text" data-field="system.style" value="{{system.style}}" placeholder="{{localize 'ESSENCE.Item.Card.CombatStylePlaceholder'}}"></label>
          <label>{{localize "ESSENCE.Common.Subtype"}} <input type="text" data-field="system.subtype" value="{{system.subtype}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Attribute"}} <input type="text" data-field="system.attr" value="{{system.attr}}"></label>
          <label>{{localize "ESSENCE.Common.Skill"}} <input type="text" data-field="system.skill" value="{{system.skill}}"></label>
          <label>{{localize "ESSENCE.Common.Defense"}} <input type="text" data-field="system.defense" value="{{system.defense}}" placeholder="Fortitude/Composure/Harmony"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Item.Card.MinDice"}} <input type="text" data-field="system.min" value="{{system.min}}" style="width:5em"></label>
          <label>{{localize "ESSENCE.Common.Cost"}} <input type="text" data-field="system.cost" value="{{system.cost}}" style="width:5em"></label>
          <label>{{localize "ESSENCE.Common.Tags"}} <input type="text" data-field="system.tags" value="{{system.tags}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Wizard.Content.ExpertisesCommaSeparated"}} <input type="text" data-field="system.expertises" value="{{system.expertises}}"></label>
          <label>{{localize "ESSENCE.Wizard.Content.ExpertiseMode"}}
            <select data-field="system.expertisesMode">
              <option value="any" {{#if (eq system.expertisesMode "any")}}selected{{/if}}>{{localize "ESSENCE.Wizard.Content.ExpertiseModeAny1"}}</option>
              <option value="any2" {{#if (eq system.expertisesMode "any2")}}selected{{/if}}>{{localize "ESSENCE.Wizard.Content.ExpertiseModeAny2"}}</option>
            </select>
          </label>
        </div>
      {{/if}}
    {{/if}}

    {{#if (eq step 2)}}
      {{#if (or (eq type "action-card") (eq type "reaction-card"))}}
        <p class="muted">{{localize "ESSENCE.Wizard.Content.BodyHint"}}</p>
        {{#each system.body as |line i|}}
          <div class="array-row wizard-array-block">
            <input type="text" data-array="body" data-index="{{i}}" data-field="label" value="{{line.label}}" placeholder="{{localize 'ESSENCE.Wizard.Content.LabelPlaceholderExample'}}">
            <button type="button" data-action="deleteArrayRow" data-array="body" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Card.DeleteBodyLineAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
            <textarea data-array="body" data-index="{{i}}" data-field="html" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{line.html}}</textarea>
          </div>
        {{/each}}
        <button type="button" data-action="addArrayRow" data-array="body"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Card.AddBodyLine"}}</button>
      {{/if}}
    {{/if}}

    {{#if (eq step 3)}}
      {{#if (or (eq type "action-card") (eq type "reaction-card"))}}
        <h3 class="section-head">{{localize "ESSENCE.Common.Surges"}}</h3>
        {{#each system.surges as |s i|}}
          <div class="array-row wizard-array-block">
            <input type="text" data-array="surges" data-index="{{i}}" data-field="n" value="{{s.n}}" style="width:3em" title="{{localize 'ESSENCE.Wizard.Content.SurgeCostTooltip'}}">
            <button type="button" data-action="deleteArrayRow" data-array="surges" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Card.DeleteSurgeAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
            <textarea data-array="surges" data-index="{{i}}" data-field="html" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{s.html}}</textarea>
          </div>
        {{/each}}
        <button type="button" data-action="addArrayRow" data-array="surges"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Card.AddSurge"}}</button>

        <h3 class="section-head">{{localize "ESSENCE.Item.Card.Rider"}}</h3>
        <input type="text" data-field="system.rider.title" value="{{system.rider.title}}" placeholder="{{localize 'ESSENCE.Item.Card.RiderTitlePlaceholder'}}">
        <textarea data-field="system.rider.html" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.rider.html}}</textarea>

        <h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
        <textarea data-field="system.flavor" rows="2" placeholder="{{localize 'ESSENCE.Wizard.Content.FlavorTextHtmlAllowed'}}">{{system.flavor}}</textarea>
      {{/if}}
    {{/if}}

    {{!-- ============ EQUIPMENT steps ============ --}}
    {{#if (eq step 1)}}
      {{#if (eq type "equipment")}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" value="{{doc.name}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Category"}}
            <select data-field="system.category">
              {{#each categoryOptions as |opt|}}
                <option value="{{opt.value}}" {{#if (eq ../system.category opt.value)}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Tier"}} <input type="number" data-field="system.tier" value="{{system.tier}}" style="width:4em" min="1" max="5"></label>
          <label>{{localize "ESSENCE.Item.Equipment.Reach"}} <input type="text" data-field="system.cost" value="{{system.cost}}" style="width:5em"></label>
        </div>
        {{#if isWornCategory}}
          <div class="wizard-row">
            <label>{{localize "ESSENCE.Common.Type"}} <input type="text" data-field="system.type" value="{{system.type}}"></label>
            <label>{{localize "ESSENCE.Common.Range"}} <input type="text" data-field="system.range" value="{{system.range}}"></label>
            <label><input type="checkbox" data-field="system.isModular" {{#if system.isModular}}checked{{/if}}> {{localize "ESSENCE.Item.Equipment.Modular"}}</label>
          </div>
          <div class="wizard-row">
            <label>{{localize "ESSENCE.Common.Fortitude"}} <input type="text" data-field="system.fortitude" value="{{system.fortitude}}" style="width:5em"></label>
            <label>{{localize "ESSENCE.Common.Resilience"}} <input type="text" data-field="system.resilience" value="{{system.resilience}}" style="width:5em"></label>
            <label>{{localize "ESSENCE.Common.Movement"}} <input type="text" data-field="system.movement" value="{{system.movement}}" style="width:5em"></label>
            <label>{{localize "ESSENCE.Item.Equipment.ReachBonus"}} <input type="number" data-field="system.reachBonus" value="{{system.reachBonus}}" style="width:4em"></label>
          </div>
        {{/if}}
        {{#if isGear}}
          <div class="wizard-row">
            <label>{{localize "ESSENCE.Common.Uses"}} <input type="number" data-field="system.uses" value="{{system.uses}}" style="width:4em" placeholder="{{localize 'ESSENCE.Common.Unlimited'}}"></label>
          </div>
        {{/if}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Tags"}} <input type="text" data-field="system.tags" value="{{system.tags}}"></label>
        </div>
        {{#if isConsumableKit}}
          <p class="muted">{{localize "ESSENCE.Wizard.Content.EquipmentCardsHint"}}</p>
          {{#each system.equipmentCards as |c i|}}
            <div class="array-row wizard-array-block">
              <input type="text" data-array="equipmentCards" data-index="{{i}}" data-field="name" value="{{c.name}}" placeholder="{{localize 'ESSENCE.Wizard.Content.CardNamePlaceholder'}}">
              <input type="number" data-array="equipmentCards" data-index="{{i}}" data-field="uses" value="{{c.uses}}" style="width:4em" placeholder="{{localize 'ESSENCE.Common.Uses'}}">
              <button type="button" data-action="deleteArrayRow" data-array="equipmentCards" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Wizard.Content.DeleteCardAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
              <textarea data-array="equipmentCards" data-index="{{i}}" data-field="effect" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{c.effect}}</textarea>
            </div>
          {{/each}}
          <button type="button" data-action="addArrayRow" data-array="equipmentCards"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Equipment.AddEquipmentCard"}}</button>
        {{/if}}
      {{/if}}
    {{/if}}

    {{#if (eq step 2)}}
      {{#if (eq type "equipment")}}
        <h3 class="section-head">{{localize "ESSENCE.Common.Effect"}}</h3>
        <textarea data-field="system.effect" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.effect}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Passive"}}</h3>
        <textarea data-field="system.passive" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.passive}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Special"}}</h3>
        <textarea data-field="system.special" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.special}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
        <textarea data-field="system.flavor" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.flavor}}</textarea>
      {{/if}}
    {{/if}}

    {{!-- ============ CONDITION steps ============ --}}
    {{#if (eq step 1)}}
      {{#if (eq type "condition")}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" value="{{doc.name}}"></label>
        </div>
        <p class="muted">{{localize "ESSENCE.Wizard.Content.ConditionSectionsHint"}}</p>
        {{#each system.sections as |sec i|}}
          <div class="array-row wizard-array-block">
            <input type="text" data-array="sections" data-index="{{i}}" data-field="label" value="{{sec.label}}" placeholder="{{localize 'ESSENCE.Item.Condition.SectionLabelExamplePlaceholder'}}">
            <button type="button" data-action="deleteArrayRow" data-array="sections" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Condition.DeleteSectionAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
            <textarea data-array="sections" data-index="{{i}}" data-field="html" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{sec.html}}</textarea>
          </div>
        {{/each}}
        <button type="button" data-action="addArrayRow" data-array="sections"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Condition.AddSection"}}</button>
      {{/if}}
    {{/if}}

    {{!-- ============ CHASSIS steps ============ --}}
    {{#if (eq step 1)}}
      {{#if (eq type "chassis")}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" value="{{doc.name}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Category"}}
            <select data-field="system.category">
              <option value="weapon" {{#if (eq system.category "weapon")}}selected{{/if}}>weapon (Striker)</option>
              <option value="ranged" {{#if (eq system.category "ranged")}}selected{{/if}}>ranged (Launcher)</option>
              <option value="armor" {{#if (eq system.category "armor")}}selected{{/if}}>armor (Shell)</option>
              <option value="shield" {{#if (eq system.category "shield")}}selected{{/if}}>shield (Shield)</option>
              <option value="implement" {{#if (eq system.category "implement")}}selected{{/if}}>implement (Focus)</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Slot"}}
            <select data-field="system.slot">
              <option value="signature" {{#if (eq system.slot "signature")}}selected{{/if}}>signature</option>
              <option value="temporary" {{#if (eq system.slot "temporary")}}selected{{/if}}>temporary</option>
              <option value="armory" {{#if (eq system.slot "armory")}}selected{{/if}}>armory</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Tier"}} <input type="number" data-field="system.tier" value="{{system.tier}}" style="width:4em" min="1" max="5"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Fortitude"}} <input type="text" data-field="system.fortitude" value="{{system.fortitude}}" style="width:5em" placeholder="e.g. +2"></label>
          <label>{{localize "ESSENCE.Common.Resilience"}} <input type="text" data-field="system.resilience" value="{{system.resilience}}" style="width:5em" placeholder="e.g. +1"></label>
          <label>{{localize "ESSENCE.Common.Movement"}} <input type="text" data-field="system.movement" value="{{system.movement}}" style="width:5em" placeholder="e.g. -1"></label>
          <label>{{localize "ESSENCE.Item.Component.CompatibleFittingCategory"}} <input type="text" data-field="system.compatibleFittingCategory" value="{{system.compatibleFittingCategory}}" placeholder="e.g. Handling, Payload, Rigging, Interface"></label>
        </div>
      {{/if}}
    {{/if}}

    {{#if (eq step 2)}}
      {{#if (eq type "chassis")}}
        <p class="muted">{{localize "ESSENCE.Wizard.Content.ChassisMountsHint"}}</p>
        {{#each system.mounts as |m i|}}
          <div class="array-row wizard-array-block">
            <span class="mount-index">{{localize "ESSENCE.Item.Component.Mount" n=(addOne i)}}</span>
            <input type="number" data-array="mounts" data-index="{{i}}" data-field="linkedWith" value="{{m.linkedWith}}" style="width:6em" min="0" placeholder="{{localize 'ESSENCE.Wizard.Content.LinkedMountPlaceholder'}}">
            <button type="button" data-action="deleteArrayRow" data-array="mounts" data-index="{{i}}" aria-label="{{localize 'ESSENCE.Item.Component.DeleteMountAria' n=(addOne i)}}"><i class="fa-solid fa-trash"></i></button>
          </div>
        {{/each}}
        <button type="button" data-action="addArrayRow" data-array="mounts"><i class="fa-solid fa-plus"></i> {{localize "ESSENCE.Item.Component.AddMount"}}</button>
      {{/if}}
    {{/if}}

    {{#if (eq step 3)}}
      {{#if (eq type "chassis")}}
        <h3 class="section-head">{{localize "ESSENCE.Common.Effect"}}</h3>
        <textarea data-field="system.effect" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.effect}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Passive"}}</h3>
        <textarea data-field="system.passive" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.passive}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Special"}}</h3>
        <textarea data-field="system.special" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.special}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
        <textarea data-field="system.flavor" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.flavor}}</textarea>
      {{/if}}
    {{/if}}

    {{!-- ============ FITTING steps ============ --}}
    {{#if (eq step 1)}}
      {{#if (eq type "fitting")}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" value="{{doc.name}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Category"}}
            <select data-field="system.category">
              <option value="weapon" {{#if (eq system.category "weapon")}}selected{{/if}}>weapon (Handling)</option>
              <option value="ranged" {{#if (eq system.category "ranged")}}selected{{/if}}>ranged (Payload)</option>
              <option value="armor" {{#if (eq system.category "armor")}}selected{{/if}}>armor (Rigging)</option>
              <option value="shield" {{#if (eq system.category "shield")}}selected{{/if}}>shield (Handling)</option>
              <option value="implement" {{#if (eq system.category "implement")}}selected{{/if}}>implement (Interface)</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Slot"}}
            <select data-field="system.slot">
              <option value="signature" {{#if (eq system.slot "signature")}}selected{{/if}}>signature</option>
              <option value="temporary" {{#if (eq system.slot "temporary")}}selected{{/if}}>temporary</option>
              <option value="armory" {{#if (eq system.slot "armory")}}selected{{/if}}>armory</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Tier"}} <input type="number" data-field="system.tier" value="{{system.tier}}" style="width:4em" min="1" max="5"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Fortitude"}} <input type="text" data-field="system.fortitude" value="{{system.fortitude}}" style="width:5em" placeholder="e.g. +2"></label>
          <label>{{localize "ESSENCE.Common.Resilience"}} <input type="text" data-field="system.resilience" value="{{system.resilience}}" style="width:5em" placeholder="e.g. +1"></label>
          <label>{{localize "ESSENCE.Common.Movement"}} <input type="text" data-field="system.movement" value="{{system.movement}}" style="width:5em" placeholder="e.g. -1"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Item.Component.Handedness"}}
            <select data-field="system.handedness">
              <option value="" {{#if (eq system.handedness "")}}selected{{/if}}>—</option>
              <option value="one-handed" {{#if (eq system.handedness "one-handed")}}selected{{/if}}>one-handed</option>
              <option value="two-handed" {{#if (eq system.handedness "two-handed")}}selected{{/if}}>two-handed</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Item.Component.RangeModifier"}} <input type="text" data-field="system.rangeModifier" value="{{system.rangeModifier}}"></label>
          <label>{{localize "ESSENCE.Item.Component.ReconfigureCategory"}}
            <select data-field="system.reconfigureCategory">
              <option value="simple" {{#if (eq system.reconfigureCategory "simple")}}selected{{/if}}>{{localize "ESSENCE.Item.Component.ReconfigureSimple"}}</option>
              <option value="structural" {{#if (eq system.reconfigureCategory "structural")}}selected{{/if}}>{{localize "ESSENCE.Item.Component.ReconfigureStructural"}}</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Item.Component.ReconfigureCostOverride"}} <input type="number" data-field="system.reconfigureCostOverride" value="{{system.reconfigureCostOverride}}" style="width:5em" min="0" placeholder="{{localize 'ESSENCE.Item.Component.ReconfigureCostOverridePlaceholder'}}"></label>
        </div>
      {{/if}}
    {{/if}}

    {{#if (eq step 2)}}
      {{#if (eq type "fitting")}}
        <h3 class="section-head">{{localize "ESSENCE.Common.Effect"}}</h3>
        <textarea data-field="system.effect" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.effect}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Passive"}}</h3>
        <textarea data-field="system.passive" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.passive}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Special"}}</h3>
        <textarea data-field="system.special" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.special}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
        <textarea data-field="system.flavor" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.flavor}}</textarea>
      {{/if}}
    {{/if}}

    {{!-- ============ AUGMENT steps ============ --}}
    {{#if (eq step 1)}}
      {{#if (eq type "augment")}}
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Name"}} <input type="text" data-field="name" value="{{doc.name}}"></label>
        </div>
        <div class="wizard-row">
          <label>{{localize "ESSENCE.Common.Kind"}}
            <select data-field="system.kind">
              <option value="function" {{#if (eq system.kind "function")}}selected{{/if}}>{{localize "ESSENCE.Item.Augment.KindFunction"}}</option>
              <option value="support" {{#if (eq system.kind "support")}}selected{{/if}}>{{localize "ESSENCE.Item.Augment.KindSupport"}}</option>
            </select>
          </label>
          <label>{{localize "ESSENCE.Common.Compatibility"}} <input type="text" data-field="system.compatibility" value="{{system.compatibility}}" placeholder="e.g. Any, Weapon, Requires Tier 3+ Chassis"></label>
        </div>
        {{#if (eq system.kind "function")}}
          <div class="wizard-row">
            <label>{{localize "ESSENCE.Common.Uses"}} <input type="number" data-field="system.uses" value="{{system.uses}}" style="width:4em" min="0"></label>
            <label>{{localize "ESSENCE.Item.Augment.UsesRemaining"}} <input type="number" data-field="system.usesRemaining" value="{{system.usesRemaining}}" style="width:4em" min="0"></label>
          </div>
        {{/if}}
      {{/if}}
    {{/if}}

    {{#if (eq step 2)}}
      {{#if (eq type "augment")}}
        <h3 class="section-head">{{localize "ESSENCE.Common.Effect"}}</h3>
        <textarea data-field="system.effect" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.effect}}</textarea>
        <h3 class="section-head">{{localize "ESSENCE.Common.Flavor"}}</h3>
        <textarea data-field="system.flavor" rows="2" placeholder="{{localize 'ESSENCE.Common.HtmlAllowed'}}">{{system.flavor}}</textarea>
      {{/if}}
    {{/if}}

    {{!-- ============ DONE ============ --}}
    {{#if isLast}}
      <p>{{localize "ESSENCE.Wizard.Content.CreatedInCompendium" name=doc.name label=typeConfig.label}}</p>
      <div class="wizard-row">
        <button type="button" data-action="openInCompendium">{{localize "ESSENCE.Wizard.Content.OpenFullSheet"}}</button>
        <button type="button" data-action="createAnother">{{localize "ESSENCE.Wizard.Content.CreateAnother"}}</button>
      </div>
    {{/if}}
  {{/if}}

  </div>

  {{#if doc}}
    <footer class="wizard-footer">
      <button type="button" data-action="wizardBack" {{#if (eq step 1)}}disabled{{/if}}>← {{localize "ESSENCE.Common.Back"}}</button>
      <span class="muted">{{localize "ESSENCE.Wizard.StepOf" step=(addOne step) total=typeConfig.steps.length name=stepName}}</span>
      <button type="button" data-action="wizardNext" {{#if isLast}}disabled{{/if}}>{{localize "ESSENCE.Common.Next"}} →</button>
    </footer>
  {{/if}}
</div>
