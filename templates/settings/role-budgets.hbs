<p class="hint">{{localize "ESSENCE.Settings.RoleBudgets.Hint"}}</p>
<table class="role-budgets-table">
  <thead>
    <tr>
      <th>{{localize "ESSENCE.Settings.RoleBudgets.Field"}}</th>
      {{#each roleNames as |role|}}<th>{{role}}</th>{{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each fields as |f|}}
      <tr>
        <td>{{localize f.labelKey}}</td>
        {{#each f.cells as |c|}}
          <td><input type="number" name="{{c.role}}.{{f.field}}" value="{{c.value}}"></td>
        {{/each}}
      </tr>
    {{/each}}
  </tbody>
</table>
<footer class="sheet-footer">
  <button type="button" data-action="resetDefaults"><i class="fa-solid fa-arrow-rotate-left"></i> {{localize "ESSENCE.Settings.RoleBudgets.ResetDefaults"}}</button>
  <button type="submit"><i class="fa-solid fa-save"></i> {{localize "ESSENCE.Common.Save"}}</button>
</footer>
